          preload_image.onload = function () {
            var label = '';
            if (channel.is_premium) label += '<div class="premium_label"></div>';
            if (channel.status === 1 || channel.is_live) {
              label += '<div class="live_label"></div>';
            } else {
              label += '<div class="online_label"></div>';
            }
            var verifiedHtml = channel.is_verified ? '<span class="verified_icon ' + (channel.is_premium ? 'blue' : '') + '" title="' + (channel.is_premium ? (window.t ? window.t('Премиум канал') : 'Премиум канал') : (window.t ? window.t('Подтвержденный канал') : 'Подтвержденный канал')) + '"></span>' : '';
            var chTitle = truncateStr(channel.title, 20);
            var progHtml = '';
            if (typeof (channel.program) != 'undefined') {
              progHtml = (window.t ? window.t('Передача') : 'Передача') + ': <span class="white">' + truncateStr(channel.program.title, 60) + '</span>';
            }
            var labelChannel = (window.t ? window.t('Телеканал') : 'Телеканал');
            var html = '<a href="' + channel.url + '" class="thumb hidden" style="background: #000 url(' + channel.thumbnail + ') no-repeat center center;display:none;position:absolute;top:0;left:0;">\
      <span class="border_thumb">'+ label + ' \
      <div class="views white">'+ channel.spectators + '</div>\
      <div class="program grey">'+ labelChannel + ': <span class="blue translatable-live" data-original-text="'+ String(chTitle).replace(/"/g,'&quot;') + '">'+ chTitle + '</span>' + verifiedHtml + '<br /> \
      '+ progHtml + '</div> \
      </span>\
      </a>';
            $('#channelscarousel .channel-' + channel.id + ' .thumb').addClass('last_thumb');
            $('#channelscarousel .channel-' + channel.id).append(html);
            if (typeof window.translateElementLive === 'function') {
              $('#channelscarousel .channel-' + channel.id + ' .translatable-live').each(function(){ window.translateElementLive(this); });
            }
            if (typeof window.autoTranslatePage === 'function') {
              setTimeout(function(){ window.autoTranslatePage(); }, 50);
            }
            $('#channelscarousel .channel-' + channel.id + ' .hidden').fadeIn(1500, function () {
              var ch = $(this).parent();
              $(this).css({ position: 'relative' }).removeClass('hidden');
              $('.last_thumb', ch).remove();
            });
            // 
            setTimeout(function () { if ((channels.length - 1) == key) { updateThumbnailt(0); } else { key++; updateImg(channels, key); } }, 500);
          }// вслучае если скриншот не подгружается
          preload_image.onError = function () { if ((channels.length - 1) == key) { updateThumbnailt(0); } else { key++; updateImg(channels, key); } }
        }
      } $(document).ready(function () {
        $('#promobg').click(function () {
          $(this).hide();
          $('#promoplayer').hide();
          $('#promobg').hide();
          $('#promoplayer').html('');
        });
      });

      //-->
    </script>

