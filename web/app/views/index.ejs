<%- include('partials/header') %>
<%
  const isModern = typeof isModernTheme !== 'undefined' && isModernTheme;
  const promoLangs = ['ru', 'en', 'uk', 'be', 'kk'];
  const promoLang = (typeof currentLang !== 'undefined' && promoLangs.includes(currentLang)) ? currentLang : 'ru';
  const promoCopyMap = {
    ru: {
      title: 'Создай своё телевидение!', sub: 'Прямые трансляции, видео по запросу, автопилот эфира и ', subEm: 'многое другое',
      channels: 'Телеканалы', records: 'Записи', panel: 'Панель управления', openChannel: 'Открыть телеканал!',
      channelsStats: 'Всего', live: 'В эфире', viewers: 'Зрителей', recordsTotal: 'Всего',
      channelsList: 'Список всех телеканалов', recordsList: 'Список всех записей'
    },
    en: {
      title: 'Create your own television!', sub: 'Live broadcasts, video on demand, air autopilot and ', subEm: 'much more',
      channels: 'TV Channels', records: 'Recordings', panel: 'Control Panel', openChannel: 'Open channel!',
      channelsStats: 'Total', live: 'On air', viewers: 'Viewers', recordsTotal: 'Total',
      channelsList: 'List of all TV channels', recordsList: 'List of all recordings'
    },
    uk: {
      title: 'Створи своє телебачення!', sub: 'Прямі трансляції, відео на запит, автопілот ефіру та ', subEm: 'багато іншого',
      channels: 'Телеканали', records: 'Записи', panel: 'Панель керування', openChannel: 'Відкрити телеканал!',
      channelsStats: 'Всього', live: 'В ефірі', viewers: 'Глядачів', recordsTotal: 'Всього',
      channelsList: 'Список усіх телеканалів', recordsList: 'Список усіх записів'
    },
    be: {
      title: 'Ствары сваё тэлебачанне!', sub: 'Прамыя трансляцыі, відэа па запыце, аўтапілот эфіру і ', subEm: 'шмат іншага',
      channels: 'Тэлеканалы', records: 'Запісы', panel: 'Панэль кіравання', openChannel: 'Адкрыць тэлеканал!',
      channelsStats: 'Усяго', live: 'У эфіры', viewers: 'Гледачоў', recordsTotal: 'Усяго',
      channelsList: 'Спіс усіх тэлеканалаў', recordsList: 'Спіс усіх запісаў'
    },
    kk: {
      title: 'Өз теледидарыңды жаса!', sub: 'Тікелей эфир, сұраныс бойынша бейне, эфир автопилоті және ', subEm: 'басқалары',
      channels: 'Телеарналар', records: 'Жазбалар', panel: 'Басқару тақтасы', openChannel: 'Телеарна ашу!',
      channelsStats: 'Барлығы', live: 'Эфирде', viewers: 'Көрермен', recordsTotal: 'Барлығы',
      channelsList: 'Барлық телеарналар', recordsList: 'Барлық жазбалар'
    }
  };
  const promoT = promoCopyMap[promoLang] || promoCopyMap.ru;
%>
<% if (!isModern) { %>
<style>
  /* Modern full-bleed promo: unified aurora, content stays in 1000px */
  #promopage.promo-shell,
  #promopage_auth.promo-shell {
    position: relative;
    width: 100% !important;
    min-width: 1000px;
    overflow: hidden;
    background: #000f25 !important;
    text-align: center;
    height: auto !important;
  }
  #promopage.promo-shell { padding-bottom: 28px; }
  #promopage_auth.promo-shell { padding-bottom: 28px; }

  .promo-shell__aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 42% 28%, rgba(0, 170, 255, 0.22), transparent 58%),
      radial-gradient(ellipse 50% 40% at 70% 20%, rgba(111, 222, 238, 0.10), transparent 55%),
      radial-gradient(ellipse 60% 50% at 50% 100%, rgba(0, 60, 140, 0.25), transparent 60%),
      linear-gradient(165deg, #001433 0%, #000f25 38%, #000a18 100%);
  }
  .promo-shell__glow {
    position: absolute;
    inset: -30%;
    background:
      radial-gradient(circle at 35% 30%, rgba(111, 222, 238, 0.18), transparent 42%),
      radial-gradient(circle at 65% 25%, rgba(0, 180, 255, 0.16), transparent 40%),
      radial-gradient(circle at 50% 80%, rgba(0, 120, 200, 0.12), transparent 45%);
    animation: promoGlowDrift 16s ease-in-out infinite alternate;
    filter: blur(8px);
  }
  .promo-shell__rays {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(125deg, transparent 28%, rgba(120, 190, 255, 0.16) 46%, transparent 58%),
      linear-gradient(112deg, transparent 34%, rgba(111, 222, 238, 0.12) 50%, transparent 62%),
      linear-gradient(138deg, transparent 40%, rgba(50, 140, 230, 0.10) 56%, transparent 70%);
    animation: promoRaysSweep 14s ease-in-out infinite alternate;
    mix-blend-mode: screen;
  }
  .promo-shell__shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg,
      transparent 25%,
      rgba(111, 222, 238, 0.07) 42%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(111, 222, 238, 0.07) 58%,
      transparent 75%);
    background-size: 220% 100%;
    animation: promoShimmer 9s ease-in-out infinite;
    mix-blend-mode: screen;
  }
  .promo-shell__noise {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }
  @keyframes promoGlowDrift {
    from { transform: translate3d(-3%, -2%, 0) scale(1); }
    to   { transform: translate3d(3%, 3%, 0) scale(1.06); }
  }
  @keyframes promoRaysSweep {
    from { transform: translateX(-2%) rotate(0.2deg); opacity: 0.85; }
    to   { transform: translateX(2%) rotate(-0.4deg); opacity: 1; }
  }
  @keyframes promoShimmer {
    0% { background-position: 120% 0; }
    100% { background-position: -120% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .promo-shell__glow, .promo-shell__rays, .promo-shell__shimmer { animation: none; }
  }

  .promo-shell__inner {
    position: relative;
    z-index: 1;
    width: 1000px;
    margin: 0 auto;
    height: auto;
    text-align: left;
    box-sizing: border-box;
  }
  .promo-hero-copy {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 0 auto;
    padding: 36px 12px 0;
    max-width: 920px;
    text-align: left;
    box-sizing: border-box;
  }
  #promopage.promo-shell .promo-hero-copy { padding-top: 36px; }
  #promopage_auth.promo-shell .promo-hero-copy { padding-top: 36px; }
  .promo-hero-copy__icon {
    flex: 0 0 92px;
    width: 92px;
    height: 92px;
    filter: drop-shadow(0 0 8px rgba(111, 222, 238, 0.35));
  }
  .promo-hero-copy__icon svg { width: 92px; height: 92px; display: block; }
  .promo-hero-copy__text {
    flex: 0 1 auto;
    text-align: left;
    min-width: 0;
  }
  .promo-hero-copy__text h1 {
    margin: 0 0 10px;
    padding: 0;
    color: #fff;
    font: 700 42px/1.12 "Trebuchet MS", Arial, sans-serif;
    letter-spacing: 0.2px;
    text-shadow: 0 1px 2px rgba(0,0,0,0.45);
  }
  .promo-hero-copy__text p {
    margin: 0;
    color: rgba(230, 245, 255, 0.92);
    font: italic 18px/1.45 Arial, sans-serif;
  }
  .promo-hero-copy__text p u {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* Guest: title + carousel inside fixed height */
  #promopage.promo-shell .promo-shell__inner {
    display: flex;
    flex-direction: column;
  }
  #promopage.promo-shell .channels_logged {
    margin: 22px auto 0 !important;
    flex: 0 0 auto;
  }

  /* Auth: title + buttons stacked tightly — never under popular-channels overlap */
  #promopage_auth.promo-shell .promo-shell__inner {
    display: flex;
    flex-direction: column;
    padding-top: 0;
    box-sizing: border-box;
  }
  #promopage_auth.promo-shell .promo-auth-cols {
    width: 1000px;
    margin: 18px auto 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    text-align: center;
    color: #fff;
    flex: 0 0 auto;
    position: relative;
    z-index: 11;
  }


</style>
<% } %>

<% if (!user) { %>
    <div id="promopage" class="promo-shell promo-shell--guest">
    <% if (isModern) { %>
    <%- include('partials/promo_background') %>
    <% } else { %>
    <div class="promo-shell__aurora" aria-hidden="true">
      <div class="promo-shell__glow"></div>
      <div class="promo-shell__rays"></div>
      <div class="promo-shell__shimmer"></div>
      <div class="promo-shell__noise"></div>
    </div>
    <% } %>
      <div class="promo-shell__inner">
<div class="promo-hero-copy">
      <div class="promo-hero-copy__icon" aria-hidden="true">
        <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="promoTvGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#6fdeee"/>
              <stop offset="100%" stop-color="#008ab3"/>
            </linearGradient>
            <filter id="promoTvGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="0.8" result="blur"/>
              <feComposite in="SourceGraphic" in2="blur" operator="over"/>
            </filter>
          </defs>
          <line class="promo-antenna-l" x1="22" y1="8" x2="12" y2="0" stroke="#6fdeee" stroke-width="2" stroke-linecap="round"/>
          <line class="promo-antenna-r" x1="22" y1="8" x2="32" y2="0" stroke="#6fdeee" stroke-width="2" stroke-linecap="round"/>
          <rect x="4" y="8" width="36" height="26" rx="4" fill="none" stroke="url(#promoTvGrad)" stroke-width="3" filter="url(#promoTvGlow)"/>
          <rect x="8" y="12" width="28" height="18" rx="2" fill="url(#promoTvGrad)"/>
          <g class="promo-tv-signal">
          <path d="M14 26 A8 8 0 0 1 22 18 A8 8 0 0 1 30 26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="0.9"/>
          <path d="M18 26 A4 4 0 0 1 22 22 A4 4 0 0 1 26 26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="0.9"/>
          <circle cx="22" cy="26" r="1.5" fill="#fff"/>
          </g>
        </svg>
      </div>
        <div class="promo-hero-copy__text">
          <h1><%= promoT.title %></h1>
          <p><%= promoT.sub %><u><%= promoT.subEm %></u></p>
        </div>
      </div>
        <% if (isModern) { %>
        <section class="promo-channels-panel">
          <h2 class="promo-channels-title"><%= t('Популярные телеканалы') %></h2>
          <% if (popularChannels.length === 0) { %>
            <p class="promo-channels-empty">В данный момент нет телеканалов, ведущих прямую трансляцию</p>
          <% } else { %>
          <div class="promo-channels-viewport<%= popularChannels.length <= 15 ? ' is-single-page' : '' %>">
            <button type="button" class="promo-channels-nav promo-channels-nav--prev" aria-label="<%= t('Назад') %>">&lsaquo;</button>
            <div class="promo-channels-track" id="channelscarousel">
              <% for (let pageStart = 0; pageStart < popularChannels.length; pageStart += 15) { %>
              <div class="promo-channels-page">
                <% for (let pi = 0; pi < 15; pi++) {
                  let ch = popularChannels[pageStart + pi];
                  if (!ch) continue;
                  let snapUrl = `/tvsnapshots/${encodeURIComponent(ch.shortname)}.jpg?t=${Date.now()}`;
                  let logoUrl = safeUrlPath(ch.logo_url) || `/images/default_channel_logo.png`;
                  let bgRule = ch.is_live ? `url('${snapUrl}') center center / cover no-repeat, url('${logoUrl}') center center / contain no-repeat #000` : `url('${logoUrl}') center center / contain no-repeat #000`;
                %>
                <a href="/<%= ch.shortname %>" class="promo-channel-card channel channel-<%= ch.id %>">
                  <div class="promo-channel-card__media thumb" style="background: <%- bgRule %>;">
                    <% if (ch.is_18_plus) { %>
                    <div class="promo-channel-card__blur18"></div>
                    <% } %>
                    <div class="promo-channel-card__badges">
                      <% if (ch.is_premium) { %><span class="promo-badge promo-badge--premium"><%= t('ПРЕМИУМ') %></span><% } %>
                      <% if (ch.is_live) { %>
                        <span class="promo-badge promo-badge--live"><%= t('В ЭФИРЕ') %></span>
                      <% } else { %>
                        <span class="promo-badge promo-badge--auto"><%= t('Автопилот') %></span>
                      <% } %>
                      <span class="promo-channel-card__views"><%= ch.viewers || 0 %></span>
                    </div>
                  </div>
                  <div class="promo-channel-card__meta">
                    <div class="promo-channel-card__name">
                      <span class="translatable"><%= ch.name %></span>
                      <% if (ch.is_verified) { %><span class="verified_icon <%= ch.is_premium ? 'blue' : '' %>" title="<%= ch.is_premium ? 'Премиум канал' : 'Подтвержденный канал' %>"></span><% } %>
                    </div>
                    <div class="promo-channel-card__prog translatable"><%= ch.is_live ? (ch.live_title || ('Передача от ' + formatDate(ch.live_started_at || new Date(), userTimezone, 'DD.MM.YYYY HH:mm'))) : t('Автопилот') %></div>
                  </div>
                </a>
                <% } %>
              </div>
              <% } %>
            </div>
            <button type="button" class="promo-channels-nav promo-channels-nav--next" aria-label="<%= t('Вперед') %>">&rsaquo;</button>
          </div>
          <% } %>
        </section>
        <% } else { %>
        <div class="channels_logged" style="background: url(/images/css_img_102_carousel-logged.bg.<%= promoLang %>.png) no-repeat top left; width: 984px; height: 383px; position: relative; margin: 20px auto 0; padding-top: 35px;">
          <% if (popularChannels.length === 0) { %>
            <div style="padding: 100px 20px; color: #aaa; font-size: 16px; text-align: center; width: 100%;">В данный момент нет телеканалов, ведущих прямую трансляцию</div>
          <% } else { %>
            <ul id="channelscarousel" class="channels_preload jcarousel-skin-channelslogged">
            <% for (let i = 0; i < popularChannels.length; i += 3) { %>
              <li>
                <% for (let j = 0; j < 3; j++) { 
                     let ch = popularChannels[i + j];
                     if (ch) { %>
                  <div class="channel channel-<%= ch.id %>"> 
                    <% 
                      let snapUrl = `/tvsnapshots/${encodeURIComponent(ch.shortname)}.jpg?t=${Date.now()}`;
                      let logoUrl = safeUrlPath(ch.logo_url) || `/images/default_channel_logo.png`;
                      let bgRule = ch.is_live ? `url('${snapUrl}') center center / cover no-repeat, url('${logoUrl}') center center / contain no-repeat #000` : `url('${logoUrl}') center center / contain no-repeat #000`;
                    %>
                    <a href="/<%= ch.shortname %>" class="thumb" style="background: <%- bgRule %>; position: relative; overflow: hidden;">
                      <% if (ch.is_18_plus) { %>
                      <div style="position: absolute; top: -5px; left: -5px; right: -5px; bottom: -5px; backdrop-filter: blur(15px); background: rgba(0,0,0,0.3); z-index: 1;"></div>
                      <% } %>
                      <span class="border_thumb" style="position: relative; z-index: 2;">
                        <% if (ch.is_premium) { %><div class="premium_label"></div><% } %>
                        <% if (ch.is_live) { %>
                          <div class="live_label"></div>
                        <% } else { %>
                          <div class="online_label"></div>
                        <% } %>
                        <div class="views white"><%= ch.viewers || 0 %></div>
                        <div class="program grey">Телеканал: <span class="blue"><%= ch.name %></span><% if (ch.is_verified) { %><span class="verified_icon <%= ch.is_premium ? 'blue' : '' %>" title="<%= ch.is_premium ? 'Премиум канал' : 'Подтвержденный канал' %>"></span><% } %><br>
                          Передача: <span class="white"><%= ch.is_live ? (ch.live_title || ('Передача от ' + formatDate(ch.live_started_at || new Date(), userTimezone, 'DD.MM.YYYY HH:mm'))) : 'Автопилот' %></span>
                        </div>
                      </span>
                    </a> 
                  </div> 
                <% } } %>
              </li>
            <% } %>
            </ul>
          <% } %>
        </div>
        <% } %>
            </div>
    </div>
    <script type="text/javascript">
