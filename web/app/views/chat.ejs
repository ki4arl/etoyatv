<% const isModern = typeof isModernTheme !== 'undefined' && isModernTheme; %>
<% const officialTarget = typeof isOfficialTarget !== 'undefined' && isOfficialTarget; %>
<% const notifTarget = typeof isNotificationsTarget !== 'undefined' && isNotificationsTarget; %>
<% const adminTarget = typeof isAdministrationTarget !== 'undefined' && isAdministrationTarget; %>
<% const notifName = typeof NOTIFICATIONS_USERNAME !== 'undefined' ? NOTIFICATIONS_USERNAME : 'Уведомления ЭтоЯTV'; %>
<% const adminName = typeof ADMINISTRATION_USERNAME !== 'undefined' ? ADMINISTRATION_USERNAME : 'Администрация ЭтоЯTV'; %>
<%- include('partials/header') %>
<div id="content">
  <div class="left_blocks" style="width: 100%; margin-top: 20px;">
    <div class="block_item">
      <div class="blackbox" style="width: auto;">
        <div class="blackbox_tl"></div><div class="blackbox_tc"></div><div class="blackbox_tr"></div>
        <div class="blackbox_cw">
          <div class="blackbox_c">
            <div class="blackbox_ci">
              <div class="block-head-bg"></div>
              <div class="block-head">
                <div class="block-head-right"<% if (!isModern) { %> style="overflow: hidden;"<% } %>>
                  <% if (!isModern && !officialTarget) { %>
                  <form action="/users/block/<%= encodeURIComponent(targetUser.username) %>" method="POST" style="float: right; margin: 8px 12px 0 16px;">
                    <button type="submit" style="background:none; border:none; color:#c0c0b2; cursor:pointer; font:inherit; font-size: 11px; font-weight: normal; padding:0; text-decoration:underline; line-height: 1.2;" onmouseover="this.style.color='#fff';" onmouseout="this.style.color='#c0c0b2';"><%= areTheyBlocked ? 'Разблокировать' : 'Заблокировать' %></button>
                  </form>
                  <% } %>
                  <div class="block-title">
                    Переписка с <a href="/account,userinfo/?username=<%= encodeURIComponent(targetUser.username) %>" class="darkblue"><%= targetUser.username %></a><% if (officialTarget) { %><span class="verified_icon blue" title="Официальный аккаунт"></span><% } %>
                  </div>
                  <% if (isModern && !officialTarget) { %>
                  <form class="pm-chat-block" action="/users/block/<%= encodeURIComponent(targetUser.username) %>" method="POST">
                    <button type="submit" class="pm-btn-ghost" title="<%= areTheyBlocked ? 'Разблокировать' : 'Заблокировать' %>">
                      <span class="icon-mask pm-icon-block" aria-hidden="true"></span>
                      <%= areTheyBlocked ? 'Разблокировать' : 'Заблокировать' %>
                    </button>
                  </form>
                  <% } %>
                </div>
              </div>
              <div class="block-content<%= isModern ? ' pm-chat' : '' %>"<% if (!isModern) { %> style="background: #2b2b2b;"<% } %>>
                <div class="pm-chat-log" id="chatContainer"<% if (!isModern) { %> style="height: 400px; overflow-y: auto; display: flex; flex-direction: column;"<% } %>>
                  <% if (messages.length === 0) { %>
                    <div class="pm-empty"<% if (!isModern) { %> style="color: #c0c0b2; text-align: center; margin-top: 20px; font-size: 12px;"<% } %>>Нет сообщений. Напишите первым!</div>
                  <% } else { %>
                    <% messages.forEach(function(msg, index) { 
                      const bgColor = index % 2 === 0 ? '#2b2b2b' : '#222222';
                      const isOwn = msg.sender_id === currentUserId;
                      const senderOfficial = msg.sender_name === notifName || msg.sender_name === adminName;
                    %>
                      <div class="pm-msg<%= isOwn ? ' pm-msg--own' : ' pm-msg--other' %>"<% if (!isModern) { %> style="background: <%= bgColor %>; border-bottom: 1px solid #111; padding: 10px; display: flex; align-items: flex-start;"<% } %>>
                        <div class="pm-msg-avatar"<% if (!isModern) { %> style="margin-right: 15px; flex-shrink: 0;"<% } %>>
                          <a href="/account,userinfo/?username=<%= encodeURIComponent(msg.sender_name) %>"><img class="pm-avatar" src="<%= CDN_BASE_URL %><%= msg.sender_avatar || '/images/default_user_avatar.png' %>"<% if (!isModern) { %> style="width: 50px; height: 50px; border: 1px solid #000;"<% } %> alt=""></a>
                        </div>
                        <div class="pm-msg-bubble"<% if (!isModern) { %> style="flex-grow: 1; min-width: 0; padding-right: 15px;"<% } %>>
                          <div class="pm-msg-meta"<% if (!isModern) { %> style="margin-bottom: 5px;"<% } %>>
                            <a href="/account,userinfo/?username=<%= encodeURIComponent(msg.sender_name) %>" class="darkblue pm-msg-nick"<% if (!isModern) { %> style="font-weight: bold;"<% } %>><%= msg.sender_name %></a><% if (senderOfficial) { %><span class="verified_icon blue" title="Официальный аккаунт"></span><% if (msg.is_admin_official) { %><span class="pm-official-tag"<% if (!isModern) { %> style="margin-left: 8px; color: #6fdeee; font-size: 11px; font-weight: normal;"<% } %>>· отправлено от Администрации</span><% } %><% } else if (msg.is_admin_official && msg.sender_name === targetUser.username) { %><span class="pm-official-tag"<% if (!isModern) { %> style="margin-left: 8px; color: #9ca3af; font-size: 11px; font-weight: normal;"<% } %>>· ответ Администрации</span><% } %>
                            <span class="pm-msg-date"<% if (!isModern) { %> style="color: #777; font-size: 11px; margin-left: 10px;"<% } %>><%= formatDate(msg.created_at, userTimezone, 'DD.MM.YYYY HH:mm') %></span>
                          </div>
                          <div class="pm-msg-text"<% if (!isModern) { %> style="color: #c0c0b2; font-size: 12px; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word;"<% } %>><%- linkifyText(msg.content) %></div>
                        </div>
                        <div class="pm-msg-actions"<% if (!isModern) { %> style="flex-shrink: 0; display: flex; align-items: center; gap: 5px;"<% } %>>
                          <% if (msg.sender_name !== locals.user.username && !senderOfficial) { %>
                              <button type="button" class="<%= isModern ? 'pm-icon-btn pm-icon-btn--warn' : '' %>" onclick="openReportModal('pm', <%= msg.id %>)"<% if (!isModern) { %> style="background:none; border:none; color:#ffb86c; cursor:pointer; font-weight:bold; font-size: 11px;"<% } %> title="Пожаловаться на сообщение">
                                <% if (isModern) { %><span class="icon-mask block-head-icon-alarm" aria-hidden="true"></span><% } else { %>[!]<% } %>
                              </button>
                          <% } %>
                          <% if (!officialTarget && !senderOfficial) { %>
                          <form class="pm-msg-delete" action="/messages/delete/<%= msg.id %>" method="POST"<% if (!isModern) { %> style="margin:0;"<% } %> onsubmit="event.preventDefault(); const form = this; yatvConfirm('Удалить это сообщение?', () => { form.submit(); });">
                            <button type="submit" class="<%= isModern ? 'pm-icon-btn pm-icon-btn--danger' : '' %>"<% if (!isModern) { %> style="background:none; border:none; color:#ff6666; cursor:pointer; font-weight:bold; font-size: 11px;"<% } %> title="Удалить">
                              <% if (isModern) { %><span class="icon-mask pm-icon-trash" aria-hidden="true"></span><% } else { %>[x]<% } %>
                            </button>
                          </form>
                          <% } %>
                        </div>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
                <div class="pm-chat-compose"<% if (!isModern) { %> style="padding: 15px; border-top: 1px solid #111; background: #232323;"<% } %>>
                  <% const showAdminSend = typeof canSendAsAdmin !== 'undefined' && canSendAsAdmin && !officialTarget; %>
                  <% if (notifTarget) { %>
                    <div class="pm-notice"<% if (!isModern) { %> style="color: #c0c0b2; text-align: center; padding: 10px; font-size: 12px; font-style: italic;"<% } %>>Это системный аккаунт. Ответы не принимаются.</div>
                  <% } else if (amIBlocked && !showAdminSend) { %>
                    <div class="pm-notice pm-notice--danger"<% if (!isModern) { %> style="color: #ff6666; text-align: center; padding: 10px; font-size: 12px;"<% } %>>Этот пользователь ограничил круг лиц, которые могут присылать ему сообщения.</div>
                  <% } else if (areTheyBlocked && !showAdminSend) { %>
                    <div class="pm-notice"<% if (!isModern) { %> style="color: #c0c0b2; text-align: center; padding: 10px; font-size: 12px;"<% } %>>Вы заблокировали этого пользователя. Чтобы отправить сообщение, сначала разблокируйте его.</div>
                    <form class="pm-chat-unblock" action="/users/block/<%= encodeURIComponent(targetUser.username) %>" method="POST"<% if (!isModern) { %> style="text-align: center;"<% } %>>
                      <button type="submit"<% if (!isModern) { %> style="background: #555; color: #fff; border: 1px solid #333; padding: 5px 15px; cursor: pointer; font-family: Tahoma, Arial, sans-serif; font-size: 12px;"<% } %>>Разблокировать</button>
                    </form>
                  <% } else if (amIBlocked && showAdminSend) { %>
                    <div class="pm-notice pm-notice--danger"<% if (!isModern) { %> style="color: #ff6666; text-align: center; padding: 10px; font-size: 12px; margin-bottom: 10px;"<% } %>>Личные сообщения от вашего аккаунта заблокированы. Можно отправить только от Администрации.</div>
                    <form class="pm-chat-form" action="/messages/<%= encodeURIComponent(targetUser.username) %>" method="POST"<% if (!isModern) { %> style="margin: 0;"<% } %>>
                      <div<% if (!isModern) { %> style="margin-bottom: 10px;"<% } %>>
                        <textarea name="content"<% if (!isModern) { %> style="width: 100%; height: 80px; background: #1a1a1a; border: 1px solid #111; color: #fff; padding: 5px; font-family: Tahoma, Arial, sans-serif; font-size: 12px; resize: vertical;"<% } else { %> placeholder="Официальное сообщение…"<% } %> required maxlength="400"></textarea>
                      </div>
                      <div class="pm-chat-submit"<% if (!isModern) { %> style="text-align: right;"<% } %>>
                        <button type="submit" name="as_administration" value="1" class="pm-btn-admin"<% if (!isModern) { %> style="background: #1a3a4a; color: #6fdeee; border: 1px solid #2a5a6a; padding: 5px 15px; cursor: pointer; font-family: Tahoma, Arial, sans-serif; font-size: 12px;"<% } %>>Отправить от лица Администрации ЭтоЯTV</button>
                      </div>
                    </form>
                  <% } else { %>
                    <form class="pm-chat-form" action="/messages/<%= encodeURIComponent(targetUser.username) %>" method="POST"<% if (!isModern) { %> style="margin: 0;"<% } %>>
                      <div<% if (!isModern) { %> style="margin-bottom: 10px;"<% } %>>
                        <textarea name="content"<% if (!isModern) { %> style="width: 100%; height: 80px; background: #1a1a1a; border: 1px solid #111; color: #fff; padding: 5px; font-family: Tahoma, Arial, sans-serif; font-size: 12px; resize: vertical;"<% } else { %> placeholder="Написать сообщение…"<% } %> required maxlength="400"></textarea>
                      </div>
                      <div class="pm-chat-submit"<% if (!isModern) { %> style="text-align: right; display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; align-items: center;"<% } %>>
                        <% if (!areTheyBlocked || adminTarget) { %>
                        <button type="submit"<% if (!isModern) { %> style="background: #333; color: #fff; border: 1px solid #111; padding: 5px 15px; cursor: pointer; font-family: Tahoma, Arial, sans-serif; font-size: 12px;"<% } %>>Отправить сообщение</button>
                        <% } %>
                        <% if (showAdminSend) { %>
                        <button type="submit" name="as_administration" value="1" class="pm-btn-admin" title="Сообщение уйдёт от имени «Администрация ЭтоЯTV»"<% if (!isModern) { %> style="background: #1a3a4a; color: #6fdeee; border: 1px solid #2a5a6a; padding: 5px 15px; cursor: pointer; font-family: Tahoma, Arial, sans-serif; font-size: 12px;"<% } %>>Отправить от лица Администрации ЭтоЯTV</button>
                        <% } %>
                      </div>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="blackbox_bl"></div><div class="blackbox_bc"></div><div class="blackbox_br"></div>
      </div>
    </div>
  </div>
  <div class="clear_both"></div>
</div>
<script>
  const chatContainer = document.getElementById('chatContainer');
  if(chatContainer) chatContainer.scrollTop = chatContainer.scrollHeight;
  
  const pmTextarea = document.querySelector('textarea[name="content"]');
  if (pmTextarea) {
    pmTextarea.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        this.closest('form').submit();
      }
    });
  }
</script>
<%- include('partials/footer') %>
