<%
  const isPlayerModern = !!(typeof playerModern !== 'undefined' && playerModern);
  const autoplayOn = !!(typeof autoplay !== 'undefined' && (autoplay === true || autoplay === 1 || autoplay === '1'));
  const hlsSrc = record.hls_url
    ? ((String(record.hls_url).startsWith('http') ? record.hls_url : (CDN_BASE_URL || '') + record.hls_url)
        + (record.size_bytes ? ('?t=' + record.size_bytes) : ''))
    : '';
%>
<!DOCTYPE html>
<html lang="ru"<% if (isPlayerModern) { %> class="theme_modern" data-scheme="dark"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= record.title %> | ЭтоЯTV</title>
  <% if (isPlayerModern) { %>
  <link href="<%= CDN_BASE_URL %>/css/theme_tokens.css?v=<%= ASSET_VERSION %>-lt2" rel="stylesheet" type="text/css">
  <link href="<%= CDN_BASE_URL %>/css/player_modern.css?v=<%= ASSET_VERSION %>-p24" rel="stylesheet" type="text/css">
  <% } else { %>
  <link href="<%= CDN_BASE_URL %>/css/css_0.css?v=<%= ASSET_VERSION %>" rel="stylesheet" type="text/css">
  <% } %>
  <style>
    html, body {
      margin: 0; padding: 0; width: 100%; height: 100%;
      overflow: hidden; background: #000;
      font-family: <% if (isPlayerModern) { %>var(--font), Tahoma, sans-serif<% } else { %>Tahoma, Arial, sans-serif<% } %>;
    }
    #record.custom-player-wrapper,
    .theme_modern #record.pl-vod {
      position: relative !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      aspect-ratio: auto !important;
      background: #000 !important;
      overflow: hidden !important;
    }
    #record-video {
      position: absolute; inset: 0; z-index: 0;
      width: 100% !important; height: 100% !important;
      background: #000; object-fit: contain; cursor: pointer;
    }
    #record .player-ui,
    #record .pl-bar {
      z-index: 20;
      opacity: 1;
      pointer-events: auto;
      transition: opacity .25s ease;
    }
    #record.is-ui-hidden .player-ui,
    #record.is-ui-hidden .pl-bar { opacity: 0; pointer-events: none; }
    #record .pl-bar .pl-btn,
    #record .pl-bar a,
    #record .pl-bar .pl-volume,
    #record .pl-bar .pl-progress,
    #record .pl-bar input { pointer-events: auto; }

    /* Classic volume popup */
    .rw-vol-wrap { position: relative; display: flex; align-items: center; height: 100%; }
    .rw-vol-popup {
      display: none; position: absolute; bottom: 100%; left: 50%;
      transform: translateX(-50%); margin-bottom: 6px;
      width: 30px; height: 90px;
      background: rgba(50,50,50,.95); border: 1px solid rgba(255,255,255,.1);
      border-radius: 4px; box-shadow: 0 -2px 5px rgba(0,0,0,.5);
    }
    .rw-vol-wrap:hover .rw-vol-popup { display: block; }
    .rw-vol-popup input[type=range] {
      position: absolute; top: 50%; left: 50%;
      width: 70px; height: 4px; margin: 0; padding: 0; cursor: pointer;
      transform: translate(-50%, -50%) rotate(-90deg);
    }

    /* Modern volume: always readable fill vs thumb */
    .theme_modern #record .pl-volume__range {
      width: 88px;
      opacity: 1;
      appearance: none;
      -webkit-appearance: none;
      background: transparent;
    }
    .theme_modern #record .pl-volume__range::-webkit-slider-runnable-track {
      height: 4px;
      border-radius: 999px;
      background: linear-gradient(to right,
        var(--accent) 0%,
        var(--accent) var(--vol-pct, 100%),
        rgba(255,255,255,.28) var(--vol-pct, 100%),
        rgba(255,255,255,.28) 100%);
    }
    .theme_modern #record .pl-volume__range::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 12px; height: 12px; margin-top: -4px;
      border-radius: 50%; background: #fff;
      box-shadow: 0 0 0 2px rgba(0,0,0,.35);
      cursor: pointer;
    }
    .theme_modern #record .pl-volume__range::-moz-range-track {
      height: 4px; border-radius: 999px; background: rgba(255,255,255,.28);
    }
    .theme_modern #record .pl-volume__range::-moz-range-progress {
      height: 4px; border-radius: 999px; background: var(--accent);
    }
    .theme_modern #record .pl-volume__range::-moz-range-thumb {
      width: 12px; height: 12px; border: 0; border-radius: 50%;
      background: #fff; cursor: pointer;
    }
    .theme_modern #record #progress-thumb { display: block !important; }
  </style>
</head>
<body<% if (isPlayerModern) { %> class="theme_modern"<% } %>>
  <div id="record" class="custom-player-wrapper<%= isPlayerModern ? ' pl-vod' : '' %>" tabindex="0">
    <% if (!hlsSrc) { %>
      <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;padding:16px;text-align:center;z-index:5;">
        Видео ещё обрабатывается. Обновите страницу позже.
      </div>
    <% } else { %>
      <video id="record-video" playsinline webkit-playsinline disablePictureInPicture></video>

      <% if (isPlayerModern) { %>
        <%- include('partials/player_spinner') %>
        <div class="player-ui pl-bar pl-bar--top">
          <a class="pl-channel" href="/<%= record.shortname %>" target="_blank" rel="noopener">
            <img class="pl-channel__logo" src="<%= CDN_BASE_URL %><%= record.channel_logo_url || '/images/default_channel_logo_50.png' %>" alt="" style="object-fit: <%= record.channel_logo_fit === 'contain' ? 'contain' : 'cover' %>;">
            <span class="pl-channel__name"><%= record.channel_name %></span>
          </a>
          <span class="pl-now" style="display:inline-flex;"><%= record.title %></span>
        </div>
        <div class="player-ui player-menu-bg pl-bar pl-bar--bottom">
          <button type="button" id="btn-play" class="pl-btn pl-btn--play" title="Play/Pause">
            <svg id="icon-play" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <svg id="icon-pause" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
          </button>
          <div class="pl-volume">
            <button type="button" id="btn-vol" class="pl-btn" title="Звук">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
            </button>
            <input type="range" id="vol-slider" class="pl-volume__range" min="0" max="1" step="0.05" value="1" aria-label="Громкость">
          </div>
          <div class="pl-progress">
            <div id="progress-container">
              <div id="progress-bar"></div>
              <div id="progress-thumb"></div>
            </div>
          </div>
          <div id="time-display" class="pl-time">00:00 / 00:00</div>
          <button type="button" id="btn-fs" class="pl-btn" title="На весь экран">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
          <a class="pl-brand" href="/" target="_blank" rel="noopener">ЭтоЯTV</a>
        </div>
      <% } else { %>
        <div class="player-ui" style="box-sizing:border-box;position:absolute;top:12px;left:12px;right:12px;z-index:20;display:flex;align-items:center;gap:10px;pointer-events:none;">
          <div style="display:flex;align-items:center;gap:8px;min-width:0;background:rgba(55,55,55,.9);border:1px solid rgba(255,255,255,.08);border-radius:4px;padding:4px 8px;box-shadow:0 2px 4px rgba(0,0,0,.5);">
            <img src="<%= CDN_BASE_URL %><%= record.channel_logo_url || '/images/default_channel_logo_50.png' %>" alt="" width="22" height="22" style="border-radius:3px;object-fit:cover;flex-shrink:0;">
            <span style="color:#fff;font-size:12px;font-weight:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= record.title %></span>
          </div>
        </div>

        <div class="player-ui" style="box-sizing:border-box;position:absolute;bottom:10px;left:10px;width:44px;height:28px;background:rgba(55,55,55,.9);border-radius:4px;z-index:20;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.08);box-shadow:0 2px 4px rgba(0,0,0,.5);">
          <button id="btn-play" type="button" style="background:transparent;border:none;color:#fff;cursor:pointer;outline:none;width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:0;">
            <svg id="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="#eee" style="display:block;margin-left:2px;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <svg id="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="#eee" style="display:none;"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
          </button>
        </div>

        <div class="player-ui" style="box-sizing:border-box;position:absolute;bottom:10px;left:64px;right:165px;height:28px;background:rgba(55,55,55,.9);padding:0 12px;border-radius:4px;z-index:20;display:flex;align-items:center;gap:12px;border:1px solid rgba(255,255,255,.08);box-shadow:0 2px 4px rgba(0,0,0,.5);">
          <div id="progress-container" style="flex:1;height:4px;background:rgba(255,255,255,.15);cursor:pointer;border-radius:2px;position:relative;">
            <div id="progress-bar" style="width:0%;height:100%;background:#6fdeee;border-radius:2px;position:absolute;top:0;left:0;pointer-events:none;"></div>
            <div id="progress-thumb" style="width:10px;height:10px;background:#fff;border-radius:50%;position:absolute;top:50%;left:0%;transform:translate(-50%,-50%);box-shadow:0 0 3px rgba(0,0,0,.5);pointer-events:none;"></div>
          </div>
          <div id="time-display" style="color:#bbb;font-size:11px;white-space:nowrap;font-variant-numeric:tabular-nums;">00:00 / 00:00</div>
        </div>

        <div class="player-ui" style="box-sizing:border-box;position:absolute;bottom:10px;right:10px;height:28px;background:rgba(55,55,55,.9);padding:0 10px;border-radius:4px;z-index:20;display:flex;align-items:center;gap:10px;border:1px solid rgba(255,255,255,.08);box-shadow:0 2px 4px rgba(0,0,0,.5);">
          <div class="rw-vol-wrap">
            <button id="btn-vol" type="button" style="background:transparent;border:none;color:#fff;cursor:pointer;outline:none;padding:0;display:flex;align-items:center;height:100%;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#eee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
            </button>
            <div class="rw-vol-popup">
              <input type="range" id="vol-slider" min="0" max="1" step="0.05" value="1" aria-label="Громкость">
            </div>
          </div>
          <button id="btn-fs" type="button" style="background:transparent;border:none;color:#fff;cursor:pointer;outline:none;padding:0;display:flex;align-items:center;height:100%;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#eee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
          </button>
          <a href="/" target="_blank" rel="noopener" style="font-weight:900;color:#fff;font-size:13px;text-decoration:none;letter-spacing:-0.5px;font-family:Arial,sans-serif;">ЭтоЯTV</a>
        </div>
      <% } %>
    <% } %>
  </div>

  <% if (hlsSrc) { %>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <script>
    (function () {
      var video = document.getElementById('record-video');
      var shell = document.getElementById('record');
      if (!video || !shell) return;

      var src = <%- JSON.stringify(hlsSrc) %>;
      var wantAutoplay = <%= autoplayOn ? 'true' : 'false' %>;
      var hls = null;

      var btnPlay = document.getElementById('btn-play');
      var iconPlay = document.getElementById('icon-play');
      var iconPause = document.getElementById('icon-pause');
      var progressContainer = document.getElementById('progress-container');
      var progressBar = document.getElementById('progress-bar');
      var progressThumb = document.getElementById('progress-thumb');
      var timeDisplay = document.getElementById('time-display');
      var btnFs = document.getElementById('btn-fs');
      var volSlider = document.getElementById('vol-slider');
      var btnVol = document.getElementById('btn-vol');
      var spinner = document.getElementById('etoyatv-spinner');

      function fmt(t) {
        if (!isFinite(t)) return '00:00';
        t = Math.max(0, Math.floor(t));
        var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
        var mm = (m < 10 ? '0' : '') + m, ss = (s < 10 ? '0' : '') + s;
        return h > 0 ? h + ':' + mm + ':' + ss : mm + ':' + ss;
      }

      function syncPlayUi() {
        var paused = video.paused;
        if (iconPlay) iconPlay.style.display = paused ? 'block' : 'none';
        if (iconPause) iconPause.style.display = paused ? 'none' : 'block';
      }

      function setVolUi(vol) {
        vol = Math.max(0, Math.min(1, vol));
        if (volSlider) {
          volSlider.value = String(vol);
          volSlider.style.setProperty('--vol-pct', (vol * 100) + '%');
        }
      }

      function applyVolume(vol) {
        vol = Math.max(0, Math.min(1, vol));
        video.volume = vol;
        video.muted = vol === 0;
        setVolUi(vol);
        try {
          localStorage.setItem('yatv_volume', String(vol));
          localStorage.setItem('yatv_muted', String(video.muted));
        } catch (e) {}
      }

      function togglePlay() {
        if (video.paused) video.play().catch(function () {});
        else video.pause();
      }

      function seekToClientX(clientX) {
        if (!progressContainer || !isFinite(video.duration) || video.duration <= 0) return;
        var rect = progressContainer.getBoundingClientRect();
        var ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        video.currentTime = ratio * video.duration;
        updateProgress();
      }

      function updateProgress() {
        var d = video.duration || 0;
        var c = video.currentTime || 0;
        var pct = d > 0 ? (c / d) * 100 : 0;
        if (progressBar) progressBar.style.width = pct + '%';
        if (progressThumb) progressThumb.style.left = pct + '%';
        if (timeDisplay) timeDisplay.textContent = fmt(c) + ' / ' + fmt(d);
      }

      function tryAutoplay() {
        if (!wantAutoplay) return;
        video.muted = true;
        setVolUi(0);
        video.play().catch(function () {});
      }

      // HLS
      if (window.Hls && Hls.isSupported()) {
        hls = new Hls({ enableWorker: true, maxMaxBufferLength: 30 });
        hls.loadSource(src);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, tryAutoplay);
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = src;
        video.addEventListener('loadedmetadata', tryAutoplay);
      }

      // Restore volume (unless autoplay forces mute)
      try {
        var savedVol = localStorage.getItem('yatv_volume');
        if (!wantAutoplay && savedVol !== null) applyVolume(parseFloat(savedVol) || 1);
        else if (!wantAutoplay) applyVolume(1);
        else setVolUi(0);
      } catch (e) {
        if (!wantAutoplay) applyVolume(1);
      }

      if (btnPlay) btnPlay.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation(); togglePlay();
      });
      video.addEventListener('click', function (e) {
        e.preventDefault(); togglePlay();
      });
      video.addEventListener('play', syncPlayUi);
      video.addEventListener('pause', syncPlayUi);
      video.addEventListener('timeupdate', updateProgress);
      video.addEventListener('loadedmetadata', updateProgress);
      video.addEventListener('waiting', function () { if (spinner) spinner.style.display = 'block'; });
      video.addEventListener('playing', function () { if (spinner) spinner.style.display = 'none'; });
      video.addEventListener('canplay', function () { if (spinner) spinner.style.display = 'none'; });

      // Progress click + drag
      if (progressContainer) {
        var dragging = false;
        progressContainer.addEventListener('mousedown', function (e) {
          e.preventDefault(); e.stopPropagation();
          dragging = true;
          seekToClientX(e.clientX);
        });
        progressContainer.addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation();
          seekToClientX(e.clientX);
        });
        window.addEventListener('mousemove', function (e) {
          if (!dragging) return;
          seekToClientX(e.clientX);
        });
        window.addEventListener('mouseup', function () { dragging = false; });
      }

      if (volSlider) {
        volSlider.addEventListener('input', function (e) {
          e.stopPropagation();
          applyVolume(parseFloat(volSlider.value) || 0);
        });
        volSlider.addEventListener('click', function (e) { e.stopPropagation(); });
        volSlider.addEventListener('mousedown', function (e) { e.stopPropagation(); });
      }

      if (btnVol) {
        btnVol.addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation();
          if (video.muted || video.volume === 0) {
            var restore = 1;
            try {
              var s = parseFloat(localStorage.getItem('yatv_volume'));
              if (isFinite(s) && s > 0) restore = s;
            } catch (err) {}
            applyVolume(restore);
          } else {
            applyVolume(0);
          }
        });
      }

      if (btnFs) {
        btnFs.addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation();
          if (!document.fullscreenElement) {
            (shell.requestFullscreen || shell.webkitRequestFullscreen || function () {}).call(shell);
          } else {
            (document.exitFullscreen || document.webkitExitFullscreen || function () {}).call(document);
          }
        });
      }

      // Auto-hide chrome when cursor leaves
      var hideTimer = null;
      function showUi() {
        shell.classList.remove('is-ui-hidden');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () {
          if (!video.paused) shell.classList.add('is-ui-hidden');
        }, 2800);
      }
      function hideUiSoon() {
        clearTimeout(hideTimer);
        if (!video.paused) shell.classList.add('is-ui-hidden');
      }
      shell.addEventListener('mousemove', showUi);
      shell.addEventListener('mouseenter', showUi);
      shell.addEventListener('mouseleave', hideUiSoon);
      video.addEventListener('play', showUi);
      video.addEventListener('pause', function () {
        shell.classList.remove('is-ui-hidden');
        clearTimeout(hideTimer);
      });
      showUi();

      // Focus shell so keys work inside iframe without clicking inputs
      shell.setAttribute('tabindex', '0');
      try { shell.focus({ preventScroll: true }); } catch (e) { try { shell.focus(); } catch (e2) {} }
      shell.addEventListener('mousedown', function () {
        try { shell.focus({ preventScroll: true }); } catch (e) {}
      });

      document.addEventListener('keydown', function (e) {
        var tag = (e.target && e.target.tagName) || '';
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

        if (e.key === ' ' || e.key === 'Spacebar' || e.code === 'Space') {
          e.preventDefault();
          togglePlay();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          if (isFinite(video.duration)) video.currentTime = Math.min(video.duration, video.currentTime + 5);
          updateProgress();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          video.currentTime = Math.max(0, video.currentTime - 5);
          updateProgress();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          applyVolume((video.muted ? 0 : video.volume) + 0.1);
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          applyVolume((video.muted ? 0 : video.volume) - 0.1);
        } else if (e.key === 'f' || e.key === 'F' || e.key === 'а' || e.key === 'А') {
          if (btnFs) btnFs.click();
        } else if (e.key === 'm' || e.key === 'M' || e.key === 'ь' || e.key === 'Ь') {
          if (btnVol) btnVol.click();
        }
      });

      // Wheel volume over player
      shell.addEventListener('wheel', function (e) {
        e.preventDefault();
        var cur = video.muted ? 0 : video.volume;
        applyVolume(cur + (e.deltaY < 0 ? 0.05 : -0.05));
      }, { passive: false });

      if (!wantAutoplay) video.pause();
      syncPlayUi();
      updateProgress();
    })();
  </script>
  <% } %>
</body>
</html>
