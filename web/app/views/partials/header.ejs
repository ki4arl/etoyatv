    $(document).ready(function () {
      $('.tabs a').click(function (e) {
        if ($(this).attr('href').startsWith('#')) {
          e.preventDefault();
          var href = $(this).attr('href');
          var $target = $(href + '_text');
          if (!$target.length) return;
          if ($(this).hasClass('active')) return;
          $('.tabs a').removeClass('active');
          $(this).addClass('active');
          <% if (isModern) { %>
          var $current = $('.textbg .text:visible').first();
          if (window.ModernMotion && $current.length && !$current.is($target)) {
            $current.addClass('is-tab-leaving');
            $target.css('display', 'block').addClass('is-tab-entering');
            setTimeout(function () {
              $current.hide().removeClass('is-tab-leaving');
              $target.removeClass('is-tab-entering');
            }, 120);
          } else {
            $('.textbg .text').hide();
            $target.show();
          }
          <% } else { %>
          $('.textbg .text').hide();
          $target.show();
          <% } %>
        }
      });
    });
  </script>
