<div class="records_list" data-list-href="<%= listHref %>">
<% if (records.length === 0) { %>
    <div style="padding: 20px; text-align: center; color: #888;">Записи не найдены.</div>
<% } else { %>
    <% records.forEach(function(rec, index) { %>
    <div class="item <%= index === 0 ? 'first' : '' %> <%= index === records.length - 1 ? 'last' : '' %>">
        <div class="record_item" style="position: relative;">
            <a href="/tv,viewrecord,<%= rec.id %>" class="thumb"
                style="background: #000 url('<%= CDN_BASE_URL %><%= rec.thumbnail_url || '/images/default_record_thumb.png' %>') no-repeat center center; background-size: cover; position: relative; overflow: hidden;">
                <% if (rec.is_18_plus) { %>
                <div style="position: absolute; top: -5px; left: -5px; right: -5px; bottom: -5px; backdrop-filter: blur(5px); background: rgba(0,0,0,0.1); z-index: 1;"></div>
                <% } %>
                <span class="border_thumb" style="position: relative; z-index: 2;">
                    <div class="record_time">
                        <%= ('0' + Math.floor(rec.duration / 3600)).slice(-2) %>:<%= ('0' + Math.floor((rec.duration % 3600) / 60)).slice(-2) %>:<%= ('0' + (rec.duration % 60)).slice(-2) %>
                    </div>
                </span>
            </a>
            <div class="info">
                <div class="title"><a href="/tv,viewrecord,<%= rec.id %>"><%= rec.title %></a><% if(rec.is_18_plus) { %> <span class="label_18" style="display:inline-block; vertical-align:middle; margin-left:5px; margin-top:0; float:none;"></span><% } %></div>
                <div class="channel"><span class="label">Телеканал:</span> <a href="/<%= rec.shortname %>"><%= rec.channel_name %></a></div>
                <div class="date"><span class="label">Дата:</span>
                    <span class="white">
                        <%= ('0' + new Date(rec.created_at).getDate()).slice(-2) %>.<%= ('0' + (new Date(rec.created_at).getMonth() + 1)).slice(-2) %>.<%= new Date(rec.created_at).getFullYear() %>
                    </span></div>
                <div class="views"><span class="label">Просмотров:</span> <span class="white"><%= rec.views %></span></div>
            </div>
            <div class="record_likes">
              <% if (locals.user) { %>
              <div class="likes-badge">
                <span id="record_fans_count_<%= rec.id %>" style="color:#fff; font-size:10px; font-weight:bold; line-height: 18px; padding-top: 1px;"><%= rec.fans_count || 0 %></span>
                <a href="#" onclick="toggleFavoriteRecord('<%= rec.id %>'); return false;" style="display: flex; align-items: center; justify-content: center; width: 16px; height: 16px; text-decoration: none;"><span class="block-head-icon-heart heart-btn <%= rec.is_fan ? 'active' : '' %>" id="record_fan_icon_<%= rec.id %>" style="display: block; width: 16px; height: 16px; margin: 0; padding: 0;"></span></a>
              </div>
              <% } %>
            </div>
        </div>
        <div class="clear_both"></div>
    </div>
    <% }); %>
<% } %>
</div>

<div class="pager">
    <% if (totalPages > 1) { %>
        <% if (currentPage > 1) { %>
            <div style="float:left;">
                <div class="item prev"><a href="/tv,records?page=<%= currentPage - 1 %><%= listQuery %>">Предыдущая</a></div>
            </div>
        <% } %>
        <% for(let i=1; i<=totalPages; i++) { %>
            <% if (i === currentPage) { %>
                <div class="item active"><%= i %></div>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                <div class="item"><a href="/tv,records?page=<%= i %><%= listQuery %>"><%= i %></a></div>
            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                <div class="item">...</div>
            <% } %>
        <% } %>
        <% if (currentPage < totalPages) { %>
            <div style="float:right;">
                <div class="item next"><a href="/tv,records?page=<%= currentPage + 1 %><%= listQuery %>">Следующая</a></div>
            </div>
        <% } %>
    <% } %>
    <div class="clear_both"></div>
</div>
