<div class="blocks">
<div class="blackbox" style="width: auto;">
<div class="blackbox_tl"></div><div class="blackbox_tc"></div><div class="blackbox_tr"></div>
<div class="blackbox_cw"><div class="blackbox_c" style=""><div class="blackbox_ci"> 
<div class="block-head-bg"></div>
<div class="block-head">
<div class="block-head-right"><div class="block-title">Реклама</div></div> 
</div>
<div class="block-content">
  <% if (adsEnabled && adsConfig['sidebar_320x240'] && adsConfig['sidebar_320x240'].image) { %>
    <div class="ad-slot ad-slot--320x240">
      <% if (adsConfig['sidebar_320x240'].url) { %>
        <a href="<%= adsConfig['sidebar_320x240'].url %>" target="_blank" rel="noopener sponsored" class="ad-slot-link">
          <img src="<%= adsConfig['sidebar_320x240'].image %>" alt="">
        </a>
      <% } else { %>
        <img src="<%= adsConfig['sidebar_320x240'].image %>" alt="">
      <% } %>
    </div>
  <% } else if (!adsEnabled) { %>
    <!-- Ad is disabled -->
  <% } else { %>
    <div class="ad-slot ad-slot--320x240 ad-slot--placeholder" aria-hidden="true">Место для рекламы 320×240</div>
  <% } %>
</div>
<div class="clear_both"></div>
</div><div class="clear_both"></div>
</div></div>
<div class="blackbox_bl"></div><div class="blackbox_bc"></div><div class="blackbox_br"></div>
</div>
</div>
