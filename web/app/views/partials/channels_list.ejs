<div class="channels_list" data-list-href="<%= listHref %>">
<% if (channels.length === 0) { %>
    <div style="padding: 20px; text-align: center; color: #888;">Телеканалы не найдены.</div>
<% } else { %>
    <% channels.forEach((channel, idx) => { %>
    <div class="item <%= idx === 0 ? 'first' : '' %> <%= (idx + 1) % 3 === 0 ? 'item_end' : '' %>"> 
    <a href="/<%= channel.shortname %>" class="thumb" style="background: <%= channel.is_live ? `url('/tvsnapshots/${channel.shortname}.jpg?t=${Date.now()}') center center / cover no-repeat, ` : '' %>url('<%= CDN_BASE_URL %><%= channel.logo_url || '/images/default_channel_logo.png' %>') center center / contain no-repeat #000; position: relative; overflow: hidden;">
      <% if (channel.is_18_plus) { %>
      <div style="position: absolute; top: -5px; left: -5px; right: -5px; bottom: -5px; backdrop-filter: blur(15px); background: rgba(0,0,0,0.3); z-index: 1;"></div>
      <% } %>
      <span class="border_thumb" style="position: relative; z-index: 2;">
      <% if (channel.is_premium) { %>
        <div class="premium_label"></div>
      <% } %>
      <% if (channel.is_live) { %>
        <div class="live_label"></div>
      <% } else if (channel.autopilot_enabled === 1 || channel.autopilot_enabled) { %>
        <div class="online_label"></div>
      <% } %>
    </span></a>
      <div class="right_panel" style="float: right; width: 52px; text-align: center; margin-left: 10px;">
        <a href="/<%= channel.shortname %>" class="logo" style="display: block; width: 50px; height: 50px;"><img width="50" height="50" src="<%= CDN_BASE_URL %><%= channel.logo_url || '/images/default_channel_logo_50.png'  %>" alt="<%= channel.name %>" style="object-fit: <%= channel.logo_fit === 'contain' ? 'contain' : 'cover' %>; <%= channel.logo_fit === 'contain' ? 'background: #000;' : '' %> display: block; <%= channel.is_18_plus ? 'filter: blur(4px);' : '' %>"></a>
        <% if (locals.user) { %>
        <div class="likes-badge channel-badge">
          <span id="fans_count_<%= channel.id %>" style="color:#fff; font-size:10px; font-weight:bold; line-height: 16px;"><%= channel.fans_count || 0 %></span>
          <a href="#" onclick="toggleFavorite('<%= channel.id %>'); return false;" style="display: block; width: 16px; height: 16px;"><span class="block-head-icon-heart heart-btn <%= channel.is_fan ? 'active' : '' %>" id="fan_icon_<%= channel.id %>"></span></a>
        </div>
        <% } %>
      </div>
    <div class="info"> 
    <div class="grid_title">Телеканал: <a href="/<%= channel.shortname %>" class="translatable" data-ugc="1"><%= channel.name %></a><% if (channel.is_verified) { %><span class="verified_icon <%= channel.is_premium ? 'blue' : '' %>" title="<%= channel.is_premium ? 'Премиум канал' : 'Подтвержденный канал' %>"></span><% } %><% if(channel.is_18_plus) { %> <span class="label_18" style="display:inline-block; vertical-align:middle; margin-left:5px; margin-top:0; float:none;"></span><% } %></div> 
    <div class="list_title">Телеканал: <a href="/<%= channel.shortname %>" class="translatable" data-ugc="1"><%= channel.name %></a><% if (channel.is_verified) { %><span class="verified_icon <%= channel.is_premium ? 'blue' : '' %>" title="<%= channel.is_premium ? 'Премиум канал' : 'Подтвержденный канал' %>"></span><% } %><% if(channel.is_18_plus) { %> <span class="label_18" style="display:inline-block; vertical-align:middle; margin-left:5px; margin-top:0; float:none;"></span><% } %></div> 

    <div class="description darkgrey translatable" data-ugc="1" style="white-space: pre-wrap; overflow-wrap: break-word; word-wrap: break-word; word-break: break-word;"><%= channel.description || 'Описание телеканала не заполнено' %></div>
    </div>
    <div class="clear_both"></div>
    </div> 
        <% if ((idx + 1) % 3 === 0 && idx !== channels.length - 1) { %>
            <div class="clear_both dottedline breakline" style="height:25px;"></div> 
        <% } %>
    <% }) %>
<% } %>
<div class="clear_both" style="clear: both; height: 15px;"></div>
</div>

<div class="pager">
    <% if (totalPages > 1) { %>
        <% if (currentPage > 1) { %>
            <div style="float:left;">
                <div class="item prev"><a href="/tv,channels?page=<%= currentPage - 1 %><%= listQuery %>">Предыдущая</a></div>
            </div>
        <% } %>

        <% for(let i=1; i<=totalPages; i++) { %>
            <% if (i === currentPage) { %>
                <div class="item active"><%= i %></div>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                <div class="item"><a href="/tv,channels?page=<%= i %><%= listQuery %>"><%= i %></a></div>
            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                <div class="item">...</div>
            <% } %>
        <% } %>

        <% if (currentPage < totalPages) { %>
            <div style="float:right;">
                <div class="item next"><a href="/tv,channels?page=<%= currentPage + 1 %><%= listQuery %>">Следующая</a></div>
            </div>
        <% } %>
    <% } %>
<div class="clear_both"></div>
</div>
