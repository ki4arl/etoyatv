<%# Inline SVG access badges for unlisted / private records (no emoji) %>
<% if (typeof accessLevel !== 'undefined' && accessLevel === 'unlisted') { %>
<span class="record-access-icon" title="Доступ по ссылке (не в поиске)" aria-label="Доступ по ссылке" style="display:inline-flex;align-items:center;vertical-align:middle;margin-right:4px;color:#8c989e;">
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
</span>
<% } else if (typeof accessLevel !== 'undefined' && accessLevel === 'private') { %>
<span class="record-access-icon" title="Ограниченный доступ" aria-label="Ограниченный доступ" style="display:inline-flex;align-items:center;vertical-align:middle;margin-right:4px;color:#8c989e;">
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
</span>
<% } %>
