<%#
  Оверлеи плеера темы «Эфир».
  Одна разметка для страницы канала и дашборда панели: классы .pl-*
  из player_modern.css, идентификаторы player-ui / player-menu-bg /
  player-actions — на них висит автоскрытие и цвета канала.
  Флаги showPopout / showCast / showReport: на канале все три, в панели
  достаточно поделиться и записей.
%>
<%
  const ch = typeof channel !== 'undefined' && channel ? channel : (typeof panelChannel !== 'undefined' ? panelChannel : null);
  const cdn = typeof CDN_BASE_URL !== 'undefined' ? CDN_BASE_URL : '';
  const shortname = ch && ch.shortname ? ch.shortname : '';
  const chName = ch && ch.name ? ch.name : '';
  const logoSrc = cdn + ((ch && ch.logo_url) ? ch.logo_url : '/images/default_channel_logo_50.png');
  const withPopout = typeof showPopout !== 'undefined' && showPopout;
  const withCast = typeof showCast !== 'undefined' && showCast;
  const withReport = typeof showReport !== 'undefined' && showReport;
  const loggedIn = typeof user !== 'undefined' && user;
  const channelId = ch && ch.id ? ch.id : 0;
%>
<div id="player_live_idle" class="pl-idle">
  <div class="live_label" id="player_live_label" style="display: none;"></div>
  <div class="online_label" id="player_autopilot_label" style="display: none;"></div>
</div>

<div class="player-ui pl-bar pl-bar--top">
  <a class="pl-channel" href="/<%= shortname %>">
    <img class="pl-channel__logo" src="<%= logoSrc %>" alt="<%= chName %>">
    <span class="pl-channel__name"><%= chName %><% if (ch && ch.is_verified) { %><span class="verified_icon <%= ch.is_premium ? 'blue' : '' %>" title="<%= ch.is_premium ? 'Премиум канал' : 'Подтвержденный канал' %>"></span><% } %></span>
  </a>

  <span class="pl-now" id="player_now_title" style="display: none;"></span>

  <div class="player-actions pl-actions">
    <button type="button" class="pl-btn" onclick="copyShareLink('<%= shortname %>')" title="Поделиться"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
    <% if (withReport) { %>
    <button type="button" class="pl-btn" onclick="<% if (loggedIn) { %>openReportModal('channel', <%= channelId %>)<% } else { %>window.location.href='/login'<% } %>" title="Пожаловаться"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></button>
    <% } %>
    <a class="pl-btn" href="/channel,records?shortname=<%= shortname %>" title="Записи"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2.2"/><path d="M12 20v2M8 22h8M12 17v3"/></svg></a>
    <% if (withPopout) { %>
    <button id="btn-popout" type="button" class="pl-btn" title="Мини-плеер"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><rect x="12" y="10" width="8" height="5" rx="1" fill="currentColor" stroke="none"/></svg></button>
    <% } %>
    <% if (withCast) { %>
    <button id="btn-cast" type="button" class="pl-btn pl-btn--hidden" title="Chromecast"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M1 18v3h3c0-1.66-1.34-3-3-3zm0-4v2c2.76 0 5 2.24 5 5h2c0-3.87-3.13-7-7-7zm0-4v2c4.97 0 9 4.03 9 9h2c0-6.08-4.93-11-11-11zM21 3H3c-1.1 0-2 .9-2 2v3h2V5h18v14h-7v2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg></button>
    <% } %>
  </div>
</div>

<div class="player-ui player-menu-bg pl-bar pl-bar--bottom">
  <button id="btn-play-pause" type="button" class="pl-btn pl-btn--play" title="Play/Pause"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg></button>

  <div class="pl-volume">
    <button id="btn-volume" type="button" class="pl-btn" title="Звук"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg></button>
    <input type="range" id="volume-slider" class="pl-volume__range" min="0" max="1" step="0.05" value="1" aria-label="Громкость">
  </div>

  <div class="pl-viewers" title="Зрителей">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-6.8 10-6.8S22 12 22 12s-3.6 6.8-10 6.8S2 12 2 12z"/><circle cx="12" cy="12" r="2.8"/></svg>
    <span id="viewers-count-player">1</span>
  </div>

  <div class="pl-spacer"></div>

  <div id="stream-selector-container" class="pl-streams is-hidden">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
    <div id="stream-buttons" class="pl-streams__list"></div>
  </div>

  <button id="btn-fullscreen" type="button" class="pl-btn" title="На весь экран"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg></button>

  <a class="pl-brand" href="/" target="_blank" rel="noopener">ЭтоЯTV</a>
</div>
