<div style="position:absolute;top:0;left:-9999px;">
<% const bugLangs=['ru','en','uk','be','kk']; const bugLang=(typeof currentLang!=='undefined'&&bugLangs.includes(currentLang))?currentLang:'ru'; %>
<a href="https://github.com/etoyatv/etoyatv/issues/new" class="bugreport" style="background-image:url('<%= CDN_BASE_URL %>/images/css_img_73_bugreport_sprite.<%= bugLang %>.png');" title="Bug report"></a>
</div>
<%- include('report_modal') %>
<%- include('confirm_modal') %>
<script>
document.addEventListener("DOMContentLoaded", function() {
  // Footer Language Switcher logic
  const footerLangSwitcher = document.getElementById('footer-lang-switcher');
  if (footerLangSwitcher) {
    footerLangSwitcher.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const lang = this.getAttribute('data-lang');
        fetch('/api/set-lang', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lang })
        }).then(res => {
          if (res.ok) {
            window.location.reload();
          }
        });
      });
    });
  }

  setTimeout(() => {
    // Target EJS status/success/error elements on pages like settings/profile
    const alertDivs = document.querySelectorAll(
      'div[style*="color:#39b54a"], div[style*="color: #39b54a"], ' +
      'div[style*="color:#ff6666"], div[style*="color: #ff6666"]'
    );
    alertDivs.forEach(el => {
      const text = el.textContent || '';
      // Don't fade out persistent critical block errors/warnings
      if (text.includes('отключена') || text.includes('удален') || text.includes('заблокирован') || text.includes('ограничил')) {
        return;
      }
      el.style.transition = 'opacity 0.5s ease-out, height 0.5s ease-out, margin 0.5s ease-out, padding 0.5s ease-out';
      el.style.opacity = '0';
      setTimeout(() => {
        el.style.height = '0';
        el.style.margin = '0';
        el.style.padding = '0';
        el.style.overflow = 'hidden';
        setTimeout(() => el.remove(), 500);
      }, 500);
    });
  }, 5000);

  // RTMP Speed indicator setup
  const footerSpeedVal = document.getElementById('footer-rtmp-speed');
  const footerSpeedLink = document.getElementById('footer-speedtest-link');

  function updateFooterSpeed(result) {
    if (result && (result.downloadRaw !== undefined || result.download)) {
      const t = (str) => window.t ? window.t(str) : str;
      const speedUnit = t('Мбит/с');
      const pingUnit = t('мс');
      const titleInbound = t('Входящая');
      const titleOutbound = t('Исходящая');

      let dl = result.downloadRaw !== undefined ? parseFloat(result.downloadRaw) : parseFloat(result.download);
      let ul = result.uploadRaw !== undefined ? parseFloat(result.uploadRaw) : parseFloat(result.upload);
      let pg = result.pingRaw !== undefined ? parseFloat(result.pingRaw) : parseFloat(result.ping);

      if (isNaN(dl)) dl = 0;
      if (isNaN(ul)) ul = 0;
      if (isNaN(pg)) pg = 0;

      const download = `${dl.toFixed(1)} ${speedUnit}`;
      const upload = `${ul.toFixed(1)} ${speedUnit}`;
      const ping = `${Math.round(pg)} ${pingUnit}`;
      
      footerSpeedVal.textContent = download;
      footerSpeedVal.title = `${titleInbound}: ${download}, ${titleOutbound}: ${upload}, Ping: ${ping}`;
    } else {
      const t = (str) => window.t ? window.t(str) : str;
      footerSpeedVal.textContent = t('не измерена');
      footerSpeedVal.title = '';
    }
  }

  // Initial load
  try {
    const saved = localStorage.getItem('rtmp_speed_result');
    if (saved) {
      updateFooterSpeed(JSON.parse(saved));
    }
  } catch (e) {
    console.error('Error reading rtmp speed from localStorage:', e);
  }

  // Listen to custom updates
  window.addEventListener('rtmpSpeedUpdate', function(event) {
    updateFooterSpeed(event.detail);
  });

});
</script>
<% if (typeof showBoostyDonatePopup !== 'undefined' && showBoostyDonatePopup) { %>
<style>
  #boosty-donate-popup {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 10050;
    max-width: min(360px, calc(100vw - 32px));
    background: linear-gradient(160deg, #1a0f0a 0%, #2b1510 55%, #3a1a12 100%);
    border: 2px solid #f15a2b;
    border-radius: 10px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.55), 0 0 0 1px rgba(241,90,43,0.25);
    padding: 22px 44px 20px 20px;
    color: #fff;
    font-family: Georgia, 'Times New Roman', serif;
    display: none;
    animation: boostyPopupIn 0.35s ease-out;
  }
  #boosty-donate-popup.is-visible { display: block; }
  #boosty-donate-popup .boosty-popup-close {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 28px;
    height: 28px;
    border: 0;
    background: transparent;
    color: #ffb39a;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  #boosty-donate-popup .boosty-popup-close:hover { color: #fff; }
  #boosty-donate-popup .boosty-popup-title {
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.02em;
    line-height: 1.25;
    margin: 0 0 10px 0;
    color: #ffe6dc;
    text-transform: uppercase;
  }
  #boosty-donate-popup .boosty-popup-sub {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #d9b5a8;
    line-height: 1.4;
    margin: 0;
  }
  #boosty-donate-popup a.boosty-popup-cta {
    display: inline-block;
    margin-top: 14px;
    background: #f15a2b;
    color: #fff;
    text-decoration: none;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: bold;
    font-size: 13px;
    padding: 9px 14px;
    border-radius: 4px;
  }
  @keyframes boostyPopupIn {
    from { opacity: 0; transform: translateY(16px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>
<div id="boosty-donate-popup" role="dialog" aria-live="polite" aria-label="Boosty">
  <button type="button" class="boosty-popup-close" id="boosty-donate-popup-close" title="Закрыть" aria-label="Закрыть">&times;</button>
  <div class="boosty-popup-title">А ТЫ ЗАДОНАТИЛ НА ЭТОЯTV?!</div>
  <p class="boosty-popup-sub">Поддержи проект на Boosty — без донатов эфир не крутится.</p>
  <a class="boosty-popup-cta" href="https://boosty.to/etoyatv" target="_blank" rel="noopener noreferrer">Перейти на Boosty</a>
</div>
<script>
(function () {
  var BOOSTY_URL = 'https://boosty.to/etoyatv';
  var el = document.getElementById('boosty-donate-popup');
  var closeBtn = document.getElementById('boosty-donate-popup-close');
  if (!el || !closeBtn) return;

  var hideTimer = null;
  var nextTimer = null;
  var visible = false;

  function randBetween(minMs, maxMs) {
    return minMs + Math.floor(Math.random() * (maxMs - minMs + 1));
  }

  function hidePopup(redirect) {
    if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
    visible = false;
    el.classList.remove('is-visible');
    if (redirect) {
      window.location.href = BOOSTY_URL;
      return;
    }
    scheduleNext();
  }

  function showPopup() {
    if (visible) return;
    visible = true;
    el.classList.add('is-visible');
    // auto-dismiss after 1–2 minutes
    hideTimer = setTimeout(function () { hidePopup(false); }, randBetween(60 * 1000, 120 * 1000));
  }

  function scheduleNext() {
    if (nextTimer) clearTimeout(nextTimer);
    // random gap 1–5 minutes
    nextTimer = setTimeout(showPopup, randBetween(60 * 1000, 5 * 60 * 1000));
  }

  closeBtn.addEventListener('click', function (e) {
    e.preventDefault();
    hidePopup(true);
  });

  // first appearance also after a short random delay (1–5 min)
  scheduleNext();
})();
</script>
<% } %>
