<div style="padding:10px 10px 0 10px;font-size:10px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
  <span>
    Проект развивается независимым сообществом разработчиков.
    <span style="margin-left: 10px; color: #666;">|</span>
    <span id="footer-lang-switcher" style="margin-left: 10px; display: inline-flex; gap: 8px;">
      <% if (typeof supportedLangs !== 'undefined') { %>
        <% const langLabels = { ru: 'RU', en: 'EN', uk: 'UA', be: 'BY' }; %>
        <% supportedLangs.forEach(function(lang) { %>
          <a href="#" data-lang="<%= lang %>" style="color: <%= typeof currentLang !== 'undefined' && currentLang === lang ? '#fff' : '#6fdeee' %>; font-weight: <%= typeof currentLang !== 'undefined' && currentLang === lang ? 'bold' : 'normal' %>; text-decoration: none;"><%= langLabels[lang] || lang.toUpperCase() %></a>
        <% }); %>
      <% } else { %>
        <a href="#" data-lang="ru" style="color: <%= typeof currentLang !== 'undefined' && currentLang === 'ru' ? '#fff' : '#6fdeee' %>; font-weight: <%= typeof currentLang !== 'undefined' && currentLang === 'ru' ? 'bold' : 'normal' %>; text-decoration: none;">RU</a>
        <a href="#" data-lang="en" style="color: <%= typeof currentLang !== 'undefined' && currentLang === 'en' ? '#fff' : '#6fdeee' %>; font-weight: <%= typeof currentLang !== 'undefined' && currentLang === 'en' ? 'bold' : 'normal' %>; text-decoration: none;">EN</a>
        <a href="#" data-lang="uk" style="color: <%= typeof currentLang !== 'undefined' && currentLang === 'uk' ? '#fff' : '#6fdeee' %>; font-weight: <%= typeof currentLang !== 'undefined' && currentLang === 'uk' ? 'bold' : 'normal' %>; text-decoration: none;">UA</a>
        <a href="#" data-lang="be" style="color: <%= typeof currentLang !== 'undefined' && currentLang === 'be' ? '#fff' : '#6fdeee' %>; font-weight: <%= typeof currentLang !== 'undefined' && currentLang === 'be' ? 'bold' : 'normal' %>; text-decoration: none;">BY</a>
      <% } %>
    </span>
  </span>
  <span style="color: #888;">Скорость подключения к RTMP: <strong id="footer-rtmp-speed" style="color: #6fdeee; font-weight: bold;">не измерена</strong> (<a href="/speedtest" id="footer-speedtest-link" style="color: #6fdeee; text-decoration: underline;">тест</a>)</span>
</div>

</div>
</div> 
