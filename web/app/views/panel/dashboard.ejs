<%
  // Sanitize channel-controlled colors/URLs before they are interpolated raw into the panel body (XSS/CSS-injection hardening).
  if (locals.panelChannel) {
    locals.panelChannel.bg_color = safeColor(locals.panelChannel.bg_color, '');
    locals.panelChannel.pinned_color = safeColor(locals.panelChannel.pinned_color, '');
    locals.panelChannel.text_color = safeColor(locals.panelChannel.text_color, '');
    locals.panelChannel.player_bg_color = safeColor(locals.panelChannel.player_bg_color, '');
    locals.panelChannel.chat_color = safeColor(locals.panelChannel.chat_color, '');
    locals.panelChannel.logo_url = safeUrlPath(locals.panelChannel.logo_url);
    locals.panelChannel.bg_url = safeUrlPath(locals.panelChannel.bg_url);
    locals.panelChannel.player_bg_url = safeUrlPath(locals.panelChannel.player_bg_url);
  }
  const playerModern = typeof isModernTheme !== 'undefined' && isModernTheme;
%>
<% if (playerModern) { %>
<%- include('../panel_layout', { activeMenu: 'dashboard', activeSubmenu: '', breadcrumbs: 'Панель управления', body: include('dashboard_body_modern') }) %>
<% } else { %>
<%- include('../panel_layout', { activeMenu: 'dashboard', activeSubmenu: '', breadcrumbs: 'Панель управления', body: `
${locals.panelChannel && locals.panelChannel.status === 'banned' ? `
<div style="background-color: #ffcccc; color: #cc0000; padding: 20px; text-align: center; border: 1px solid #cc0000; margin-bottom: 20px;">
  <h2>Данный телеканал заблокирован администрацией.</h2>
  <p>Весь функционал канала недоступен. Вещание остановлено.</p>
</div>
` : (locals.panelChannel && locals.panelChannel.status === 'pending_approval') ? `
<div style="background-color: #3a2a1a; color: #ffcc80; padding: 20px; text-align: center; border: 1px solid #e6a23c; margin-bottom: 20px;">
  <h2>Канал ожидает одобрения</h2>
  <p>Пока администрация не одобрит канал, он скрыт от зрителей и эфир недоступен.</p>
</div>
` : (locals.panelChannel && locals.panelChannel.status === 'rejected_approval') ? `
<div style="background-color: #3a1a1a; color: #ffb3b3; padding: 20px; text-align: center; border: 1px solid #ff6b6b; margin-bottom: 20px;">
  <h2>Канал отклонён администрацией</h2>
  <p>По вопросам: обратитесь к администрации этого инстанса</p>
</div>
` : `
<div class="dashboard-grid">
    <!-- Channel Info -->
    <div class="card" style="grid-column: 1 / -1;">
        <div class="card-title">Ваш телеканал</div>
        <div style="display: flex; gap: 15px;">
            <div class="channel-logo">
                <img src="${(locals.CDN_BASE_URL || '') + (locals.panelChannel && locals.panelChannel.logo_url ? locals.panelChannel.logo_url : '/images/default_channel_logo.png')}" width="100" height="60" style="background:#fff; border: 1px solid #4a5359; object-fit: contain;" alt="Logo">
            </div>
            <div class="channel-details" style="font-size: 12px; line-height: 1.8;">
                <a href="/${locals.panelChannel ? locals.panelChannel.shortname : ''}" style="font-size: 14px; font-weight: bold;">${locals.panelChannel ? escapeHtml(locals.panelChannel.name) : 'Без названия'}</a><br>
                <div style="margin-top: 10px;">
                    <span style="color:#8c989e; display:inline-block; width: 80px;">В эфире:</span> ${locals.panelChannel && locals.panelChannel.is_live
                      ? `<span style="color:#ff6b6b;font-weight:bold;">Да</span>${(typeof liveStreamerUsername !== 'undefined' && liveStreamerUsername) ? ` <span style="color:#aaa;">· ведёт <a href="/account,userinfo?username=${encodeURIComponent(liveStreamerUsername)}" style="color:#6fdeee;">${escapeHtml(liveStreamerUsername)}</a></span>` : ''}`
                      : 'Нет'}<br>
                    <span style="color:#8c989e; display:inline-block; width: 80px;">Владелец:</span> <a href="#">${locals.user ? escapeHtml(locals.user.username) : 'Гость'}</a><br>
                    <span style="color:#8c989e; display:inline-block; width: 80px;">Записей:</span> ${locals.panelStats ? locals.panelStats.totalRecords : 0}<br>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card" style="margin-top: 20px; padding: 0; background: transparent; border: none;">
`}
<div class="playerchat" style="display: flex; width: 100%; height: 331px; background: #000; font-family: Tahoma, sans-serif;">
  <!-- Scoped player overrides -->
  <style>
    #etoyatv-offline-overlay {
      z-index: 15 !important;
      ${locals.panelChannel && locals.panelChannel.player_bg_url ? `
        background-image: url('${locals.CDN_BASE_URL || ''}${locals.panelChannel.player_bg_url}') !important;
        background-size: ${locals.panelChannel.player_bg_fit === 'contain' ? 'contain' : (locals.panelChannel.player_bg_fit === 'stretch' ? '100% 100%' : 'cover')} !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
        background-color: ${locals.panelChannel.player_bg_color || 'transparent'} !important;
      ` : `
        background-image: none !important;
        background-color: #000 !important;
      `}
    }
    #container_swf .player-menu-bg:not(.pl-bar--bottom),
    #container_swf .player-actions button, 
    #container_swf .player-actions a,
    #container_swf .pl-bar--bottom .pl-btn,
    #container_swf .volume-slider-wrapper {
      ${locals.panelChannel && locals.panelChannel.player_menu_color ? `background: ${locals.panelChannel.player_menu_color} !important;` : ''}
    }
    #container_swf .player-ui a, 
    #container_swf .player-ui button, 
    #container_swf .player-ui span, 
    #container_swf #viewers-count-player {
      ${locals.panelChannel && locals.panelChannel.player_link_color ? `color: ${locals.panelChannel.player_link_color} !important;` : ''}
    }
  </style>
  
  <!-- LEFT: PLAYER -->
  <div id="container_swf" style="flex: 1; height: 331px; position: relative; background: #000; border-right: 1px solid #333;">
    
    <video id="etoyatv-video" width="100%" height="100%" style="width: 100%; height: 100%; background: #000; object-fit: contain; cursor: pointer;" playsinline webkit-playsinline disablePictureInPicture disableRemotePlayback></video>

    <!-- Transition Canvas -->
    <canvas id="etoyatv-transition-canvas" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 0.5s ease-out; object-fit: contain;"></canvas>

    <!-- Overlays Canvas -->
    <canvas id="etoyatv-overlays-canvas" width="1280" height="720"
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; object-fit: contain; display: none;"></canvas>

    <!-- Loading Spinner -->
    <div id="etoyatv-spinner" style="display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5; pointer-events: none;">
      <svg width="24" height="24" viewBox="0 0 24 24" style="animation: etoyatv-spin 1s steps(8, end) infinite;">
        <circle cx="12" cy="2" r="2.5" fill="rgba(255,255,255,1)" />
        <circle cx="19.07" cy="4.93" r="2" fill="rgba(255,255,255,0.8)" />
        <circle cx="22" cy="12" r="1.5" fill="rgba(255,255,255,0.6)" />
        <circle cx="19.07" cy="19.07" r="1.5" fill="rgba(255,255,255,0.4)" />
        <circle cx="12" cy="22" r="1.5" fill="rgba(255,255,255,0.2)" />
        <circle cx="4.93" cy="19.07" r="1.5" fill="rgba(255,255,255,0.1)" />
        <circle cx="2" cy="12" r="1.5" fill="rgba(255,255,255,0.1)" />
        <circle cx="4.93" cy="4.93" r="1.5" fill="rgba(255,255,255,0.1)" />
      </svg>
    </div>
    <style>@keyframes etoyatv-spin { to { transform: rotate(360deg); } }</style>
 
    <!-- Offline Overlay -->
    <div id="etoyatv-offline-overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; color: #fff; align-items: center; justify-content: center; font-size: 18px; font-weight: bold; font-family: Tahoma, sans-serif; z-index: 15;">
      ${locals.panelChannel && locals.panelChannel.player_bg_url ? '' : `
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2" fill="white" />
            <line x1="15" y1="9" x2="9" y2="15" stroke="black" stroke-width="2.5" stroke-linecap="round" />
            <line x1="9" y1="9" x2="15" y2="15" stroke="black" stroke-width="2.5" stroke-linecap="round" />
          </svg>
          <span style="font-size: 16px; font-weight: bold; color: #fff; font-family: Tahoma, sans-serif;">Нет трансляции</span>
        </div>
      `}
    </div>

    <!-- No Signal Overlay -->
    <div id="etoyatv-nosignal-overlay" style="display: none; flex-direction: column; gap: 15px; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); color: #fff; align-items: center; justify-content: center; font-size: 18px; font-weight: bold; font-family: Tahoma, sans-serif; z-index: 2.5;">
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M14 7H3C1.9 7 1 7.9 1 9v6c0 1.1.9 2 2 2h8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M17 8.5L22 5v14l-5-3.5v-7z" fill="white" />
          <path d="M15 13l5 5M20 13l-5 5" stroke="white" stroke-width="2.5" stroke-linecap="round" />
        </svg>
        <span style="font-size: 16px; font-weight: bold; color: #fff; font-family: Tahoma, sans-serif;">Нет сигнала</span>
      </div>
    </div>

    <div id="etoyatv-signal-banner" class="etoyatv-signal-banner" style="display: none;" role="status" aria-live="polite">
      <span class="etoyatv-signal-banner__dot" aria-hidden="true"></span>
      <span class="etoyatv-signal-banner__text">В данный момент у канала проблемы с сигналом — нестабильное соединение. Трансляция продолжится, когда связь восстановится.</span>
    </div>

    ${locals.panelChannel && locals.panelChannel.is_18_plus ? `
    <!-- 18+ Overlay -->
    <div id="etoyatv-18plus-overlay" style="display: none; flex-direction: column; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; color: #fff; align-items: center; justify-content: center; font-family: Tahoma, sans-serif; z-index: 20;">
      <div style="font-size: 24px; font-weight: bold; margin-bottom: 15px;">Внимание! Контент 18+</div>
      <div style="font-size: 16px; margin-bottom: 25px;">Подтвердите, что вам уже исполнилось 18 лет.</div>
      <button onclick="confirm18Plus()" style="padding: 10px 20px; background: #3b9cd9; color: #fff; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;">Мне есть 18 лет</button>
    </div>
    <script>
      function confirm18Plus() {
        localStorage.setItem('etoyatv_global_18plus', 'true');
        document.getElementById('etoyatv-18plus-overlay').style.display = 'none';
        const video = document.getElementById('etoyatv-video');
        if (video) video.play().catch(e => console.error('Play error after 18+ confirmation:', e));
      }
      if (localStorage.getItem('etoyatv_global_18plus') !== 'true') {
        document.getElementById('etoyatv-18plus-overlay').style.display = 'flex';
      }
      document.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('etoyatv_global_18plus') !== 'true') {
          const video = document.getElementById('etoyatv-video');
          if (video) video.pause();
        }
      });
    </script>
    ` : ''}

    <!-- Logo and Title -->
    <div class="player-ui" style="position: absolute; top: 10px; left: 10px; display: flex; align-items: flex-start; gap: 5px; z-index: 10; transition: opacity 0.3s;">
      <a href="/${locals.panelChannel ? locals.panelChannel.shortname : ''}" style="display: block;">
        <img src="${(locals.CDN_BASE_URL || '') + (locals.panelChannel ? (locals.panelChannel.logo_url || '/images/default_channel_logo_50.png') : '/images/default_channel_logo_50.png')}" alt="Logo" style="width: 50px; height: 50px; background: ${locals.panelChannel && locals.panelChannel.player_bg_color ? locals.panelChannel.player_bg_color : '#000000'}; border: 1px solid #444; box-sizing: border-box; object-fit: ${locals.panelChannel && locals.panelChannel.logo_fit === 'contain' ? 'contain' : 'cover'};">
      </a>
      <div style="display: flex; flex-direction: row; align-items: center; gap: 5px;">
        <a href="/${locals.panelChannel ? locals.panelChannel.shortname : ''}" style="background: rgba(0,0,0,0.6); color: #00A3E0; font-size: 11px; font-family: Tahoma, sans-serif; padding: 3px 6px; display: inline-block; text-decoration: none; white-space: nowrap;">
          ${locals.panelChannel ? escapeHtml(locals.panelChannel.name) : ''}
        </a>
        <div class="live_label" id="player_live_label" style="display: none; position: relative; width: 32px; height: 17px; background: url(${(locals.CDN_BASE_URL || '')}/images/css_img_2_sprite1.png) no-repeat -124px -254px; top: 0; left: 0;"></div>
        <!-- Автопилот: тот же бейдж и то же название передачи, что на странице телеканала -->
        <div class="online_label" id="player_autopilot_label" style="display: none;"></div>
        <span class="pl-now pl-now--panel" id="player_now_title" style="display: none;"></span>
      </div>
    </div>
    <style>
      @keyframes rec-blink {
        from { opacity: 1; }
        to { opacity: 0.2; }
      }
    </style>

    <!-- Right Action Bar -->
    <div class="player-actions player-ui" style="position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; gap: 5px; z-index: 10; transition: opacity 0.3s;">
      <button onclick="copyShareLink('${locals.panelChannel ? locals.panelChannel.shortname : ''}')" title="Поделиться" style="width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; font-size: 16px; display: flex; justify-content: center; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button>
      <button title="Пожаловаться" style="width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; font-size: 16px; display: flex; justify-content: center; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></button>
      <a href="/channel,records?shortname=${locals.panelChannel ? locals.panelChannel.shortname : ''}" title="Записи" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; text-decoration: none; font-size: 16px;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><rect x="2" y="2" width="20" height="14" rx="2.18" ry="2.18"></rect><line x1="12" y1="20" x2="12" y2="22"></line><line x1="8" y1="22" x2="16" y2="22"></line><line x1="12" y1="16" x2="12" y2="20"></line></svg></a>
    </div>

    <!-- Bottom Left Controls -->
    <div class="player-ui player-menu-bg" style="position: absolute; bottom: 10px; left: 10px; background: rgba(0,0,0,0.7); padding: 5px 12px; border-radius: 3px; z-index: 10; display: flex; align-items: center; justify-content: center; transition: opacity 0.3s;">
      <button id="btn-play-pause" title="Play/Pause" style="background: transparent; border: none; color: #fff; font-size: 18px; cursor: pointer; outline: none; display: inline-flex; align-items: center; justify-content: center; padding: 0;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg></button>
    </div>

    <!-- Bottom Right Controls -->
    <div class="player-ui player-menu-bg" style="position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.7); padding: 5px 10px; border-radius: 3px; z-index: 10; display: flex; align-items: center; gap: 6px; transition: opacity 0.3s;">
      <!-- Stream Selector Container -->
      <div id="stream-selector-container" style="display: none; align-items: center; gap: 4px; margin: 0; padding: 0;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; color: #fff; margin: 0;" title="Камера"><path d="M23 7l-7 5 7 5V7z"></path><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
        <div id="stream-buttons" style="display: flex; gap: 4px; margin: 0; padding: 0;"></div>
      </div>
      <div style="position: relative; display: flex; align-items: center; justify-content: center;" class="volume-container" onmouseenter="this.querySelector('.volume-slider-wrapper').style.display='block'" onmouseleave="this.querySelector('.volume-slider-wrapper').style.display='none'">
        <button id="btn-volume" style="background: transparent; border: none; color: #fff; font-size: 14px; cursor: pointer; outline: none; padding: 0 5px; position: relative; z-index: 5;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg></button>
        <div class="volume-slider-wrapper" style="position: absolute; bottom: 25px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); border-radius: 3px; display: none; height: 90px; width: 30px; padding: 0; z-index: 4;">
          <div style="position: absolute; bottom: -25px; left: 0; width: 100%; height: 25px; background: transparent;"></div>
          <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="1" style="position: absolute; top: 50%; left: 50%; width: 70px; height: 4px; cursor: pointer; transform: translate(-50%, -50%) rotate(-90deg); margin: 0; padding: 0;">
        </div>
      </div>
      <div style="display: flex; align-items: center; color: #fff; font-size: 11px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="vertical-align: middle; margin-right: 3px; color: #fff;"><g transform="translate(16, 0) scale(-1, 1)"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/></g></svg>
        <span id="viewers-count-player" style="margin-left: 3px;">1</span>
      </div>
      <button id="btn-fullscreen" style="background: transparent; border: none; color: #fff; font-size: 14px; cursor: pointer; outline: none; display: flex; align-items: center; justify-content: center; padding: 0;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg></button>
      <a href="/" style="font-weight: bold; color: #fff; font-size: 12px; text-decoration: none;">ЭтоЯTV</a>
    </div>
  </div>

  <!-- RIGHT: CHAT (400px) -->
  <div id="chat_body" style="width: 400px; height: 331px; background: #000; display: flex; flex-direction: column; position: relative;">
    
    <!-- Top section: Messages (left) and Users (right) -->
    <div style="display: flex; height: 290px;">
      
      <!-- Messages List (270px) -->
      <div style="width: 270px; height: 100%; position: relative; display: flex; flex-direction: column;">
        <style>
          .chat-message-row {
            position: relative;
          }
          .chat-message-row .btn-pin-message {
            display: none;
            cursor: pointer;
            margin-left: 5px;
            opacity: 0.7;
          }
          .chat-message-row:hover .btn-pin-message {
            display: inline;
          }
          .chat-message-row .btn-pin-message:hover {
            opacity: 1;
          }
          .chat-message-row .btn-delete-message {
            display: none;
            cursor: pointer;
            margin-left: 3px;
            opacity: 0.7;
          }
          .chat-message-row:hover .btn-delete-message {
            display: inline;
          }
          .chat-message-row .btn-delete-message:hover {
            opacity: 1;
          }
          .emoji-tab {
            opacity: 0.6;
            transition: opacity 0.2s, background-color 0.2s;
          }
          .emoji-tab:hover {
            opacity: 1;
            background-color: #333;
          }
          .emoji-tab.active {
            opacity: 1;
            background-color: #444;
          }
          .emoji-item {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 16px;
            padding: 0;
            text-align: center;
            border-radius: 4px;
            transition: background-color 0.15s;
            outline: none;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 26px;
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
          }
          .emoji-item:hover {
            background-color: #444;
          }

