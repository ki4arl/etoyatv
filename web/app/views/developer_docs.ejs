<%- include('partials/header') %>
<% const isModern = typeof isModernTheme !== 'undefined' && isModernTheme; %>

<% if (!isModern) { %>
<style>
  /* Developer Documentation Portal Styles - Matching Site Theme */
  #dev-portal-container {
    font-family: 'Tahoma', sans-serif;
    color: #c0c0b2;
    background: transparent;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    min-height: 700px;
    overflow: hidden;
  }

  /* Sidebar styling - transparent dark overlay matching retro site elements */
  .dev-sidebar {
    width: 250px;
    background: rgba(0, 0, 0, 0.25);
    border-right: 1px solid #2d2d2d;
    padding: 15px 10px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-shrink: 0;
  }

  .dev-brand {
    font-size: 13px;
    font-weight: bold;
    color: #6fdeee;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px dotted #333;
    padding-bottom: 10px;
  }

  .dev-brand span {
    color: #fff;
  }

  .dev-menu-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dev-menu-title {
    font-size: 11px;
    text-transform: uppercase;
    color: #777777;
    font-weight: bold;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    padding-left: 8px;
  }

  .dev-menu-item {
    font-size: 12px;
    color: #c0c0b2;
    text-decoration: none;
    padding: 6px 10px;
    transition: all 0.1s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: normal;
  }

  .dev-menu-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .dev-menu-item.active {
    color: #6fdeee;
    background: #111111;
    border-left: 3px solid #6fdeee;
    font-weight: bold;
    padding-left: 7px;
  }

  /* Retro styled badge */
  .method-badge {
    font-size: 9px;
    font-weight: bold;
    padding: 1px 4px;
    text-transform: uppercase;
  }

  .method-badge.get {
    border: 1px solid #39b54a;
    color: #39b54a;
    background: rgba(57, 181, 74, 0.1);
  }

  /* Main content area */
  .dev-content {
    flex-grow: 1;
    padding: 20px 25px;
    box-sizing: border-box;
    overflow-y: auto;
    max-height: 800px;
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  /* Sections */
  .dev-section {
    display: none;
    flex-direction: column;
    gap: 20px;
    animation: fadeIn 0.15s ease-in-out forwards;
  }

  .dev-section.active {
    display: flex;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .dev-title {
    font-size: 18px;
    font-weight: bold;
    color: #fff;
    margin: 0;
    border-bottom: 1px solid #2d2d2d;
    padding-bottom: 8px;
  }

  .dev-subtitle {
    font-size: 12px;
    color: #c0c0b2;
    line-height: 1.5;
    margin: 0;
  }

  .api-notice {
    background: rgba(111, 222, 238, 0.05);
    border: 1px solid rgba(111, 222, 238, 0.15);
    border-radius: 4px;
    padding: 20px;
    line-height: 1.6;
    font-size: 13px;
  }

  .api-heading {
    color: #6fdeee;
    font-size: 14px;
    margin: 0 0 8px;
  }

  /* Info block styled like site's classic blocks */
  .api-card {
    background: #161616;
    border: 1px solid #2d2d2d;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .api-header {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .api-label {
    font-weight: bold;
    color: #fff;
    font-size: 13px;
  }

  .api-url-wrapper {
    background: #0c0c0c;
    border: 1px solid #252525;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-grow: 1;
    font-family: monospace;
    font-size: 12px;
  }

  .api-url {
    color: #6fdeee;
    word-break: break-all;
  }

  .btn-copy {
    background: #252525;
    border: 1px solid #333;
    color: #6fdeee;
    cursor: pointer;
    font-size: 11px;
    padding: 3px 6px;
    transition: all 0.1s;
  }

  .btn-copy:hover {
    color: #fff;
    background: #333;
    border-color: #555;
  }

  .params-table-wrapper {
    width: 100%;
    overflow-x: auto;
  }

  /* Retro styled table */
  .params-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 12px;
  }

  .params-table th, .params-table td {
    padding: 8px 10px;
    text-align: left;
    border-bottom: 1px dotted #2d2d2d;
  }

  .params-table th {
    color: #fff;
    font-weight: bold;
    background: #222222;
    border-bottom: 1px solid #2d2d2d;
  }

  .params-table td {
    color: #c0c0b2;
  }

  .param-name {
    font-family: monospace;
    color: #6fdeee;
    font-weight: bold;
  }

  .param-type {
    font-size: 11px;
    color: #777777;
    font-style: italic;
  }

  .param-req {
    font-size: 9px;
    font-weight: bold;
    padding: 1px 3px;
    text-transform: uppercase;
  }

  .param-req.required {
    border: 1px solid #b76868;
    color: #b76868;
    background: rgba(183, 104, 104, 0.1);
  }

  .param-req.optional {
    border: 1px solid #777;
    color: #777;
    background: rgba(119, 119, 119, 0.1);
  }

  /* Playground tester panel */
  .playground-panel {
    background: #111111;
    border: 1px dashed #333333;
    padding: 15px;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .playground-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px dotted #333;
    padding-bottom: 6px;
  }

  .playground-title {
    font-size: 12px;
    font-weight: bold;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .playground-inputs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .playground-input-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex-grow: 1;
    min-width: 150px;
  }

  .playground-input-group label {
    font-size: 11px;
    color: #c0c0b2;
    font-weight: bold;
  }

  .playground-input {
    background: #0c0c0c;
    border: 1px solid #2d2d2d;
    color: #fff;
    padding: 5px 8px;
    font-size: 12px;
    font-family: monospace;
    outline: none;
    transition: border-color 0.1s;
  }

  .playground-input:focus {
    border-color: #6fdeee;
  }

  .btn-execute {
    background: #252525;
    border: 1px solid #444;
    color: #6fdeee;
    padding: 6px 14px;
    font-weight: bold;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.1s;
    display: flex;
    align-items: center;
    gap: 6px;
    align-self: flex-end;
  }

  .btn-execute:hover {
    background: #333;
    color: #fff;
    border-color: #555;
  }

  /* Response visualizer */
  .response-box {
    background: #080808;
    border: 1px solid #252525;
    padding: 12px;
    max-height: 350px;
    overflow-y: auto;
    font-family: monospace;
    font-size: 11px;
    white-space: pre-wrap;
    color: #c0c0b2;
    display: none;
  }

  .response-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #777777;
    margin-bottom: 5px;
  }

  .res-loading { color: #718096; }
  .res-error { color: #f56565; }

  /* Highlight colors matching site console */
  .response-box .key { color: #3fa9c8; }
  .response-box .string { color: #ffffff; }
  .response-box .number { color: #39b54a; }
  .response-box .boolean { color: #ffcc00; }
  .response-box .null { color: #b76868; }
</style>
<% } %>

<div id="content">
  <div class="mono_blocks" style="margin-bottom:20px;">
    <div class="blackbox" style="width: auto;">
      <div class="blackbox_tl"></div>
      <div class="blackbox_tc"></div>
      <div class="blackbox_tr"></div>
      <div class="blackbox_cw">
        <div class="blackbox_c">
          <div class="blackbox_ci">
            <% if (!isModern) { %><div style="height:700px; width:1px; margin-left:-1px; float:left;"></div><% } %>
            <% if (!isModern) { %><div style="width:100%; float:left;"><% } %>
              <% if (!isModern) { %>
              <div class="block-head-bg"></div>
              <div class="block-head">
                <div class="block-head-right">
                  <div class="block-title">Документация API для сторонних приложений</div>
                </div>
              </div>
              <% } %>
              <div class="block-content api-docs-body" style="padding: 0;">
                
                <div id="dev-portal-container" class="api-docs">
                  <!-- Sidebar navigation -->
                  <div class="dev-sidebar">
                    <% if (isModern) { %>
                    <div class="dev-sidebar-head">Документация API</div>
                    <% } %>
                    <div class="dev-menu-group">
                      <div class="dev-menu-title">Основное</div>
                      <a href="#intro" class="dev-menu-item active" onclick="switchSection('intro', this); return false;"><span class="dev-menu-text">Введение</span></a>
                      <a href="#stats" class="dev-menu-item" onclick="switchSection('stats', this); return false;">
                        <span class="dev-menu-text">Статистика</span><span class="method-badge get">GET</span>
                      </a>
                    </div>

                    <div class="dev-menu-group">
                      <div class="dev-menu-title">Телеканалы</div>
                      <a href="#channels-list" class="dev-menu-item" onclick="switchSection('channels-list', this); return false;">
                        <span class="dev-menu-text">Список каналов</span><span class="method-badge get">GET</span>
                      </a>
                      <a href="#channel-detail" class="dev-menu-item" onclick="switchSection('channel-detail', this); return false;">
                        <span class="dev-menu-text">Детали канала</span><span class="method-badge get">GET</span>
                      </a>
                      <a href="#channel-streams" class="dev-menu-item" onclick="switchSection('channel-streams', this); return false;">
                        <span class="dev-menu-text">Эфирные стримы</span><span class="method-badge get">GET</span>
                      </a>
                    </div>

                    <div class="dev-menu-group">
                      <div class="dev-menu-title">Контент канала</div>
                      <a href="#channel-schedule" class="dev-menu-item" onclick="switchSection('channel-schedule', this); return false;">
                        <span class="dev-menu-text">Расписание</span><span class="method-badge get">GET</span>
                      </a>
                      <a href="#channel-news" class="dev-menu-item" onclick="switchSection('channel-news', this); return false;">
                        <span class="dev-menu-text">Новости</span><span class="method-badge get">GET</span>
                      </a>
                      <a href="#channel-records" class="dev-menu-item" onclick="switchSection('channel-records', this); return false;">
                        <span class="dev-menu-text">Записи эфиров</span><span class="method-badge get">GET</span>
                      </a>
                    </div>
                  </div>

                  <!-- Main documentation body -->
                  <div class="dev-content">
                    
                    <!-- Introduction section -->
                    <div id="section-intro" class="dev-section active">
                      <h1 class="dev-title">Публичный API для разработчиков</h1>
                      <p class="dev-subtitle">
                        Добро пожаловать в центр документации разработчиков платформы ЭтоЯTV! Здесь собраны API эндпоинты, которые позволят вам создавать ботов, внешние виджеты, плееры, мобильные приложения или собственные сервисы интеграции на базе нашей платформы.
                      </p>
                      <div class="api-notice">
                        <h3 class="api-heading"><span class="api-emoji">🔒</span> Важная информация о безопасности</h3>
                        Все описанные ниже API-методы являются публичными и доступны исключительно для <strong>чтения (Read-Only)</strong>. Доступ к админ-панели канала, панели управления трансляциями, ключам вещания (Stream Key) и паролям через эти методы полностью исключен. Авторизация или регистрация для выполнения запросов не требуются.
                      </div>
                      <div class="api-card">
                        <div class="api-header">
                          <span class="api-label">Базовый URL для запросов:</span>
                          <div class="api-url-wrapper">
                            <span class="api-url" id="base-url-display"><%= APP_URL %></span>
                            <button type="button" class="btn-copy api-btn-copy" onclick="copyText('base-url-display')" aria-label="Копировать"><span class="api-emoji">📋</span></button>
                          </div>
                        </div>
                      </div>
                      <% if (isModern) { %>
                      <div class="api-card api-keys-card">
                        <h3 class="api-heading">Ключи и доступ</h3>
                        <p class="dev-subtitle">Публичный API не выдаёт и не принимает ключи. Запросы идут без авторизации. Ключ вещания RTMP живёт в панели канала и к этим методам не относится.</p>
                        <div class="api-chip-row">
                          <span class="api-chip">без API-ключа</span>
                          <span class="api-chip">read-only</span>
                          <span class="api-chip">без сессии</span>
                        </div>
                      </div>
                      <div class="api-card">
                        <h3 class="api-heading">Справочник методов</h3>
                        <div class="api-index" role="list">
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('stats')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/stats</code>
                            <span>Глобальная статистика</span>
                          </button>
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('channels-list')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/channels</code>
                            <span>Список каналов</span>
                          </button>
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('channel-detail')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/channels/:shortname</code>
                            <span>Детали канала</span>
                          </button>
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('channel-streams')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/streams</code>
                            <span>Эфирные стримы</span>
                          </button>
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('channel-schedule')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/channels/:shortname/schedule</code>
                            <span>Расписание</span>
                          </button>
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('channel-news')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/channels/:shortname/news</code>
                            <span>Новости</span>
                          </button>
                          <button type="button" class="api-index-row" role="listitem" onclick="switchSection('channel-records')">
                            <span class="method-badge get">GET</span>
                            <code>/api/public/channels/:shortname/records</code>
                            <span>Записи эфиров</span>
                          </button>
                        </div>
                      </div>
                      <div class="api-card">
                        <h3 class="api-heading">Примеры запросов</h3>
                        <p class="dev-subtitle">Один и тот же метод — curl и fetch. Ответ всегда JSON.</p>
                        <pre class="api-pre"><code>curl -s "<%= APP_URL %>/api/public/stats"</code></pre>
                        <pre class="api-pre"><code>const res = await fetch("<%= APP_URL %>/api/public/stats");
const data = await res.json();</code></pre>
                      </div>
                      <% } %>
                    </div>

                    <!-- Stats section -->
                    <div id="section-stats" class="dev-section">
                      <h1 class="dev-title">Глобальная статистика платформы</h1>
                      <p class="dev-subtitle">Возвращает сводную статистику всей платформы в режиме реального времени: общее число активных каналов, количество онлайн стримов, суммарную аудиторию зрителей и общее количество обработанных записей.</p>
                      
                      <div class="api-card">
                        <div class="api-header">
                          <span class="method-badge get">GET</span>
                          <div class="api-url-wrapper">
                            <span class="api-url" id="url-stats">/api/public/stats</span>
                            <button type="button" class="btn-copy api-btn-copy" onclick="copyText('url-stats')" aria-label="Копировать"><span class="api-emoji">📋</span></button>
                          </div>
                        </div>

                        <h3 class="api-heading">Интерактивная песочница</h3>
                        <div class="playground-panel">
                          <div class="playground-header">
                            <span class="playground-title"><span class="api-emoji">⚡</span> Тест GET /api/public/stats</span>
                          </div>
                          <button type="button" class="btn-execute api-btn-run" onclick="executeApi('/api/public/stats', 'stats')">Выполнить запрос</button>
                          <div id="res-stats" class="response-box"></div>
                        </div>
                      </div>
                    </div>

                    <!-- Channels List section -->
                    <div id="section-channels-list" class="dev-section">
                      <h1 class="dev-title">Список каналов и поиск</h1>
                      <p class="dev-subtitle">Возвращает список публичных телеканалов с поддержкой фильтрации по эфиру, поискового запроса и пагинации.</p>
                      
                      <div class="api-card">
                        <div class="api-header">
                          <span class="method-badge get">GET</span>
                          <div class="api-url-wrapper">
                            <span class="api-url" id="url-channels">/api/public/channels</span>
                            <button type="button" class="btn-copy api-btn-copy" onclick="copyText('url-channels')" aria-label="Копировать"><span class="api-emoji">📋</span></button>
                          </div>
                        </div>

                        <h3 class="api-heading">Query параметры</h3>
                        <div class="params-table-wrapper">
                          <table class="params-table">
                            <thead>
                              <tr>
                                <th>Параметр</th>
                                <th>Тип</th>
                                <th>Требование</th>
                                <th>Описание</th>
                              </tr>
                            </thead>
                            <tbody>
                              <tr>
                                <td class="param-name">q</td>
                                <td class="param-type">string</td>
                                <td><span class="param-req optional">Optional</span></td>
                                <td>Поисковый запрос по названию или короткому имени канала (shortname)</td>
                              </tr>
                              <tr>
                                <td class="param-name">live</td>
                                <td class="param-type">string</td>
                                <td><span class="param-req optional">Optional</span></td>
                                <td>Фильтр по эфиру: <code>1</code> - только онлайн, <code>0</code> - только оффлайн</td>
                              </tr>
                              <tr>
                                <td class="param-name">limit</td>
                                <td class="param-type">integer</td>
                                <td><span class="param-req optional">Optional</span></td>
                                <td>Лимит результатов (от 1 до 100, по умолчанию 20)</td>
                              </tr>
                              <tr>
                                <td class="param-name">offset</td>
                                <td class="param-type">integer</td>
                                <td><span class="param-req optional">Optional</span></td>
                                <td>Смещение для пагинации (по умолчанию 0)</td>
                              </tr>
                            </tbody>
                          </table>
                        </div>

                        <h3 class="api-heading">Интерактивная песочница</h3>
                        <div class="playground-panel">
                          <div class="playground-header">
                            <span class="playground-title"><span class="api-emoji">⚡</span> Тест GET /api/public/channels</span>
                          </div>
                          <div class="playground-inputs">
                            <div class="playground-input-group">
                              <label>Поиск (q)</label>
                              <input type="text" id="play-channels-q" class="playground-input" placeholder="например, rvota">
                            </div>
                            <div class="playground-input-group">
                              <label>В эфире (live)</label>
                              <input type="text" id="play-channels-live" class="playground-input" placeholder="1 или 0">
                            </div>
                            <div class="playground-input-group">
                              <label>Лимит (limit)</label>
                              <input type="number" id="play-channels-limit" class="playground-input" value="5">
                            </div>
                          </div>
                          <button type="button" class="btn-execute api-btn-run" onclick="runChannelsListTest()">Выполнить запрос</button>
                          <div id="res-channels-list" class="response-box"></div>
                        </div>
                      </div>
                    </div>

                    <!-- Channel Detail section -->
                    <div id="section-channel-detail" class="dev-section">
                      <h1 class="dev-title">Детали конкретного телеканала</h1>
                      <p class="dev-subtitle">Возвращает профиль и подробные характеристики одного указанного канала по его короткому названию (shortname).</p>
                      
                      <div class="api-card">
                        <div class="api-header">
                          <span class="method-badge get">GET</span>
                          <div class="api-url-wrapper">
                            <span class="api-url" id="url-channel-detail">/api/public/channels/:shortname</span>
                            <button type="button" class="btn-copy api-btn-copy" onclick="copyText('url-channel-detail')" aria-label="Копировать"><span class="api-emoji">📋</span></button>
                          </div>
                        </div>

                        <h3 class="api-heading">Параметры пути</h3>
                        <div class="params-table-wrapper">
                          <table class="params-table">
                            <thead>
                              <tr>
                                <th>Параметр</th>
                                <th>Тип</th>
                                <th>Описание</th>
                              </tr>
