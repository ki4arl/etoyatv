<script>
  // Section switcher logic
  function switchSection(secId, menuEl) {
    if (!secId) secId = 'intro';
    
    // Switch active menu item
    document.querySelectorAll('.dev-menu-item').forEach(function(el) {
      el.classList.remove('active');
    });
    const item = menuEl || document.querySelector('.dev-menu-item[href="#' + secId + '"]');
    if (item) item.classList.add('active');

    // Switch active section panel
    document.querySelectorAll('.dev-section').forEach(function(el) {
      el.classList.remove('active');
    });
    const targetSec = document.getElementById('section-' + secId);
    if (targetSec) {
      targetSec.classList.add('active');
    }

    // Update URL hash without scrolling
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '#' + secId);
    }

    // Smooth scroll to top of documentation if scrolled past
    const portal = document.getElementById('dev-portal-container');
    if (portal && window.scrollY > portal.offsetTop) {
      portal.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Handle hash on page load and navigation
  (function() {
    function checkHash() {
      var h = (window.location.hash || '').replace(/^#/, '');
      if (h && document.getElementById('section-' + h)) {
        switchSection(h);
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkHash);
    } else {
      checkHash();
    }
    window.addEventListener('hashchange', checkHash);
  })();

  // Copy to clipboard utility
  function copyText(elId) {
    const textEl = document.getElementById(elId);
    if (!textEl) return;
    
    let text = textEl.textContent.trim();
    if (elId !== 'base-url-display' && !text.startsWith('http')) {
      const baseUrl = window.location.origin;
      text = baseUrl + text;
    }

    navigator.clipboard.writeText(text).then(function() {
      const origColor = textEl.style.color;
      textEl.style.color = 'var(--success, #10b981)';
      setTimeout(function() {
        textEl.style.color = origColor;
      }, 1000);
    }).catch(function(err) {
      console.error('Copy failed:', err);
    });
  }

  // Highlight syntax inside JSON response box
  function syntaxHighlight(json) {
    if (typeof json !== 'string') {
      json = JSON.stringify(json, undefined, 2);
    }
    json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)/g, function (match) {
      let cls = 'number';
      if (/^"/.test(match)) {
        if (/:$/.test(match)) {
          cls = 'key';
        } else {
          cls = 'string';
        }
      } else if (/true|false/.test(match)) {
        cls = 'boolean';
      } else if (/null/.test(match)) {
        cls = 'null';
      }
      return '<span class="' + cls + '">' + match + '</span>';
    });
  }

  // API query executor
  async function executeApi(endpoint, resBoxSuffix) {
    const resBox = document.getElementById('res-' + resBoxSuffix);
    if (!resBox) return;

    resBox.style.display = 'block';
    resBox.innerHTML = '<span class="res-loading">Загрузка...</span>';

    try {
      const start = Date.now();
      const res = await fetch(endpoint);
      const latency = Date.now() - start;
      const data = await res.json();
      
      resBox.innerHTML = '<div class="response-meta">' +
        '<span>Status: ' + res.status + ' ' + res.statusText + '</span>' +
        '<span>Time: ' + latency + 'ms</span>' +
        '</div>' +
        '<code>' + syntaxHighlight(data) + '</code>';
    } catch (err) {
      resBox.innerHTML = '<span class="res-error">Ошибка выполнения запроса: ' + err.message + '</span>';
    }
  }

  // Tester implementations for dynamic fields
  function runChannelsListTest() {
    const q = (document.getElementById('play-channels-q') || {}).value || '';
    const live = (document.getElementById('play-channels-live') || {}).value || '';
    const limit = (document.getElementById('play-channels-limit') || {}).value || '';
    
    let path = '/api/public/channels?';
    const params = [];
    if (q.trim()) params.push('q=' + encodeURIComponent(q.trim()));
    if (live.trim()) params.push('live=' + encodeURIComponent(live.trim()));
    if (limit.trim()) params.push('limit=' + encodeURIComponent(limit.trim()));
    path += params.join('&');

    executeApi(path, 'channels-list');
  }

  function runChannelDetailTest() {
    const name = ((document.getElementById('play-detail-name') || {}).value || '').trim() || 'rvota_tv_official';
    executeApi('/api/public/channels/' + encodeURIComponent(name), 'channel-detail');
  }

  function runScheduleTest() {
    const name = ((document.getElementById('play-schedule-name') || {}).value || '').trim() || 'rvota_tv_official';
    const date = ((document.getElementById('play-schedule-date') || {}).value || '').trim();
    
    let path = '/api/public/channels/' + encodeURIComponent(name) + '/schedule';
    if (date) path += '?date=' + encodeURIComponent(date);
    
    executeApi(path, 'schedule');
  }

  function runNewsTest() {
    const name = ((document.getElementById('play-news-name') || {}).value || '').trim() || 'rvota_tv_official';
    executeApi('/api/public/channels/' + encodeURIComponent(name) + '/news', 'news');
  }

  function runRecordsTest() {
    const name = ((document.getElementById('play-records-name') || {}).value || '').trim() || 'rvota_tv_official';
    executeApi('/api/public/channels/' + encodeURIComponent(name) + '/records', 'records');
  }
</script>

