<%- include('partials/header') %>

<div id="content">
<div class="left_blocks" style="width: 640px; margin: 20px auto; float: none;">
<div class="blackbox" style="width: auto;">
<div class="blackbox_tl"></div><div class="blackbox_tc"></div><div class="blackbox_tr"></div>
<div class="blackbox_cw"><div class="blackbox_c"><div class="blackbox_ci">
<div class="block-head-bg"></div>
<div class="block-head"><div class="block-head-right"><div class="block-title"><%= focused ? 'Обжаловать санкцию' : 'Новое обжалование' %></div></div></div>
<div class="block-content" style="padding: 20px;">
  <% if (error) { %><div style="color:#ff6666;margin-bottom:12px;"><%= error %></div><% } %>

  <% if (focused) { %>
    <div style="background:#1c1c1c; border:1px solid #333; border-radius:6px; padding:14px 16px; margin-bottom:16px;">
      <div style="font-size:12px; color:#888; margin-bottom:6px;">Вы обжалуете</div>
      <div style="color:#e8e8e8; font-size:14px; font-weight:bold;"><%= focused.label %></div>
      <% if (focused.detail) { %><div style="color:#9ca3af; font-size:13px; margin-top:4px;"><%= focused.detail %></div><% } %>
    </div>
    <p style="color:#aaa; font-size:13px; line-height:1.45; margin-top:0;">Кратко опишите, почему санкцию нужно пересмотреть. Имена сотрудников в переписке не показываются.</p>
    <form action="/appeals/new" method="post">
      <input type="hidden" name="subject_type" value="<%= focused.subject_type %>">
      <input type="hidden" name="subject_id" value="<%= focused.subject_id %>">
      <div style="margin-bottom:14px;">
        <label style="display:block; color:#c0c0b2; margin-bottom:8px; font-weight:bold;">Текст обжалования</label>
        <textarea name="message" required minlength="10" maxlength="4000" rows="6" autofocus placeholder="Почему решение ошибочно…" style="width:100%; box-sizing:border-box; background:#1a1a1a; border:1px solid #444; color:#fff; padding:10px; border-radius:3px;"></textarea>
      </div>
      <button type="submit" style="background:#3b9cd9;border:none;color:#fff;padding:8px 18px;border-radius:3px;font-weight:bold;cursor:pointer;">Отправить обжалование</button>
      <a href="/appeals" style="margin-left:12px;color:#6fdeee;">К списку</a>
    </form>

  <% } else if (!options.length) { %>
    <p style="color:#e6a23c;">Сейчас нет активных санкций, доступных для обжалования.</p>
    <a href="/appeals" style="color:#6fdeee;">← К списку</a>

  <% } else { %>
    <p style="color:#aaa; font-size:13px; line-height:1.45;">Выберите санкцию и опишите, почему её следует пересмотреть.</p>
    <form action="/appeals/new" method="post">
      <div style="margin-bottom:14px;">
        <label style="display:block; color:#c0c0b2; margin-bottom:8px; font-weight:bold;">Предмет</label>
        <% options.forEach(function(o, i) { %>
          <label style="display:block; margin-bottom:8px; color:#ddd; font-size:13px; padding:8px 10px; background:#1a1a1a; border:1px solid #333; border-radius:4px; cursor:pointer;">
            <input type="radio" name="subject_type" value="<%= o.subject_type %>"
              data-id="<%= o.subject_id %>"
              <%= (preselect === o.subject_type && String(preselectId) === String(o.subject_id)) || (!preselect && i === 0) ? 'checked' : '' %>
              style="margin-right:8px;"
              onchange="document.getElementById('subject_id').value=this.getAttribute('data-id');">
            <strong><%= o.label %></strong><% if (o.detail) { %> <span style="color:#888;">— <%= o.detail %></span><% } %>
          </label>
        <% }); %>
        <input type="hidden" name="subject_id" id="subject_id" value="<%= preselectId || (options[0] && options[0].subject_id) || '' %>">
      </div>
      <div style="margin-bottom:14px;">
        <label style="display:block; color:#c0c0b2; margin-bottom:8px; font-weight:bold;">Текст обжалования</label>
        <textarea name="message" required minlength="10" maxlength="4000" rows="6" style="width:100%; box-sizing:border-box; background:#1a1a1a; border:1px solid #444; color:#fff; padding:10px; border-radius:3px;"></textarea>
      </div>
      <button type="submit" style="background:#3b9cd9;border:none;color:#fff;padding:8px 18px;border-radius:3px;font-weight:bold;cursor:pointer;">Отправить</button>
      <a href="/appeals" style="margin-left:12px;color:#6fdeee;">Отмена</a>
    </form>
  <% } %>
</div>
</div><div class="clear_both"></div></div></div>
<div class="blackbox_bl"></div><div class="blackbox_bc"></div><div class="blackbox_br"></div>
</div></div>
<div class="clear_both"></div></div>
<%- include('partials/footer') %>
