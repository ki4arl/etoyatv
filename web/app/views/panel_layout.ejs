<!DOCTYPE html>
<html lang="ru"<% if (typeof isModernTheme !== 'undefined' && isModernTheme) { %> data-scheme="<%= (typeof colorScheme !== 'undefined' && colorScheme === 'light') ? 'light' : 'dark' %>"<% } %>>
<head>
    <%- include('partials/scheme_boot') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель управления телеканалом | ЭтоЯTV</title>
    <link rel="icon" type="image/svg+xml" href="<%= CDN_BASE_URL %>/images/favicon.svg">
    <link rel="stylesheet" href="<%= CDN_BASE_URL %>/css/panel.css?v=<%= ASSET_VERSION %>">
    <% if (typeof isModernTheme !== 'undefined' && isModernTheme) { %>
    <link rel="stylesheet" href="<%= CDN_BASE_URL %>/css/theme_tokens.css?v=<%= ASSET_VERSION %>-lt2">
    <link rel="stylesheet" href="<%= CDN_BASE_URL %>/css/panel_modern.css?v=<%= ASSET_VERSION %>-p4">
    <%# Плеер и чат на дашборде — та же разметка классов, что и на сайте %>
    <link rel="stylesheet" href="<%= CDN_BASE_URL %>/css/player_modern.css?v=<%= ASSET_VERSION %>-p24">
    <% } %>
    <script src="<%= CDN_BASE_URL %>/js/toast.js?v=<%= ASSET_VERSION %>"></script>
    <style>
        .mobile-header {
            display: none;
        }

    </style>
</head>
<body class="<%= typeof themeBodyClass !== 'undefined' ? themeBodyClass : 'theme_default' %>"<% if (typeof isModernTheme !== 'undefined' && isModernTheme) { %> data-scheme="<%= (typeof colorScheme !== 'undefined' && colorScheme === 'light') ? 'light' : 'dark' %>"<% } %>>



<% const panelLogoLangs = ['ru','en','uk','be','kk']; const panelLogoLang = (typeof currentLang !== 'undefined' && panelLogoLangs.includes(currentLang)) ? currentLang : 'ru'; const panelIsModern = typeof isModernTheme !== 'undefined' && isModernTheme; %>
<div class="mobile-header">
    <button class="menu-toggle" id="menuToggleBtn">☰</button>
    <a href="/"<% if (panelIsModern) { %> aria-label="ЭтоЯTV"<% } %>>
        <% if (panelIsModern) { %>
        <img class="logotype-img logotype-img--dark" src="<%= CDN_BASE_URL %>/images/logo.emblem.svg" height="32" alt="ЭтоЯTV" style="vertical-align: middle;">
        <img class="logotype-img logotype-img--light" src="<%= CDN_BASE_URL %>/images/logo.emblem.light.svg" height="32" alt="" aria-hidden="true" style="vertical-align: middle;">
        <% } else { %>
        <img src="<%= CDN_BASE_URL %>/images/logo.<%= panelLogoLang %>.svg" height="40" alt="ЭтоЯTV" style="vertical-align: middle;">
        <% } %>
    </a>
</div>

<div class="panel-container">

    <!-- Left Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="logo-box">
                <a href="/"<% if (panelIsModern) { %> aria-label="ЭтоЯTV"<% } %>>
                    <% if (panelIsModern) { %>
                    <img class="logotype-img logotype-img--dark" src="<%= CDN_BASE_URL %>/images/logo.emblem.svg" height="36" alt="ЭтоЯTV" style="vertical-align: middle;">
                    <img class="logotype-img logotype-img--light" src="<%= CDN_BASE_URL %>/images/logo.emblem.light.svg" height="36" alt="" aria-hidden="true" style="vertical-align: middle;">
                    <% } else { %>
                    <img src="<%= CDN_BASE_URL %>/images/logo.<%= panelLogoLang %>.svg" height="55" alt="ЭтоЯTV" style="vertical-align: middle;">
                    <% } %>
                </a>
            </div>
            <% const panelModern = panelIsModern; %>
            <% if (panelModern) { %>
            <div class="sidebar-who">
                <div class="sidebar-who__line">
                    <span class="sidebar-who__label">Пользователь</span>
                    <% if (locals.user) { %><a href="/account,userinfo/?username=<%= encodeURIComponent(locals.user.username) %>" class="user-highlight"><%= locals.user.username %></a><% } else { %><span class="user-highlight">Гость</span><% } %>
                </div>
                <div class="sidebar-who__line sidebar-who__line--channel">
                    <span class="sidebar-who__label">Телеканал</span>
                    <div class="sidebar-who__channel">
                    <% if (locals.panelChannel) { %>
                        <a href="/<%= locals.panelChannel.shortname %>" class="channel-highlight" title="Роль: <%= locals.panelRoleLabel || locals.panelRole %>"><%= locals.panelChannel.name %></a>
                        <% if (locals.availableChannels && locals.availableChannels.length > 1) { %>
                            <a href="/panel,select" class="channel-switch" aria-label="Сменить канал" title="Сменить канал"><span class="channel-switch__icon" aria-hidden="true"></span></a>
                        <% } %>
                    <% } else { %>
                        <span class="channel-highlight">Без названия</span>
                    <% } %>
                    </div>
                </div>
                <div class="sidebar-who__nav">
                    <%- include('partials/scheme_toggle') %>
                    <a href="/" class="sidebar-home" aria-label="На главную" title="На главную"><span class="sidebar-home__icon" aria-hidden="true"></span></a>
                </div>
            </div>
            <% } else { %>
            <div class="user-info">
                Пользователь: <% if (locals.user) { %><a href="/account,userinfo/?username=<%= encodeURIComponent(locals.user.username) %>" class="user-highlight"><%= locals.user.username %></a><% } else { %><span class="user-highlight">Гость</span><% } %><br>
                Телеканал: 
                <% if (locals.panelChannel) { %>
                    <a href="/<%= locals.panelChannel.shortname %>" class="channel-highlight" title="Роль: <%= locals.panelRoleLabel || locals.panelRole %>"><%= locals.panelChannel.name %></a> 
                    <% if (locals.availableChannels && locals.availableChannels.length > 1) { %>
                        <a href="/panel,select" class="channel-switch">[сменить]</a>
                    <% } %>
                <% } else { %>
                    <span class="channel-highlight">Без названия</span>
                <% } %><br>
                <%- include('partials/scheme_toggle') %><a href="/logout">Выйти</a>
            </div>
            <% } %>
        </div>

        <div class="sidebar-actions">
            <% if (locals.panelChannel && locals.panelChannel.status !== 'banned') { %>
            <% if (typeof isModernTheme !== 'undefined' && isModernTheme) { %>
            <a class="panel-chip" href="/panel,settings,broadcast"><span class="panel-chip__icon panel-chip__icon--live" aria-hidden="true"></span>Начать трансляцию</a>
            <a class="panel-chip" href="/tv,studio?channel_id=<%= locals.panelChannel.id %>"><span class="panel-chip__icon panel-chip__icon--studio" aria-hidden="true"></span>Эфирная студия</a>
            <a class="panel-chip" href="/panel,records,upload"><span class="panel-chip__icon panel-chip__icon--upload" aria-hidden="true"></span>Загрузить видео</a>
            <% } else { %>
            <button class="btn-action" onclick="window.location.href='/panel,settings,broadcast'">Начать трансляцию</button>
            <button class="btn-action" onclick="window.location.href='/tv,studio?channel_id=<%= locals.panelChannel.id %>'">Эфирная студия</button>
            <button class="btn-action" onclick="window.location.href='/panel,records,upload'">Загрузить видео</button>
            <% } %>
            <% } %>
            
            <div class="disk-usage">
                <% 
                   const totalBytes = locals.panelStats ? locals.panelStats.totalSize : 0;
                   const quotaMB = (locals.panelChannel && locals.panelChannel.cdn_quota_mb) ? locals.panelChannel.cdn_quota_mb : 2048;
                   const limitBytes = quotaMB * 1024 * 1024;
                   const usedMB = (totalBytes / 1024 / 1024).toFixed(2);
                   const usedPercent = Math.min(100, Math.round((totalBytes / limitBytes) * 100));
                   const quotaGBStr = (quotaMB / 1024).toFixed(2).replace(/\.00$/, '');
                %>
                <div class="progress-bar">
                    <div class="progress" style="width: <%= usedPercent %>%;"></div>
                </div>
                <div class="disk-text"><%= usedMB %> MB (<%= usedPercent %>%) из <%= quotaGBStr %> GB.</div>
            </div>
        </div>

        <ul class="sidebar-menu">
            <% if (locals.panelChannel && locals.panelChannel.status !== 'banned') { %>
              <% if (['owner', 'coowner', 'editor', 'reporter', 'staff'].includes(locals.panelRole)) { %>
              <li class="<%= activeMenu === 'settings' ? 'active expanded' : '' %>">
                  <a href="/panel,settings,channel"><span class="icon icon-settings"></span> Настройки</a>
                  <% if (activeMenu === 'settings') { %>
                      <ul class="submenu">
                          <li class="<%= activeSubmenu === 'channel' ? 'active' : '' %>"><a href="/panel,settings,channel">Телеканал</a></li>
                          <li class="<%= activeSubmenu === 'broadcast' ? 'active' : '' %>"><a href="/panel,settings,broadcast">Трансляция</a></li>
                          <% if (['owner', 'coowner', 'editor', 'staff'].includes(locals.panelRole)) { %>
                          <li class="<%= activeSubmenu === 'design' ? 'active' : '' %>"><a href="/panel,settings,design">Дизайн</a></li>
                          <li class="<%= activeSubmenu === 'moderation' ? 'active' : '' %>"><a href="/panel,settings,moderation">Модерация</a></li>
                          <% } %>
                          <% if (['owner', 'coowner', 'staff'].includes(locals.panelRole)) { %>
                          <li class="<%= activeSubmenu === 'access' ? 'active' : '' %>"><a href="/panel,settings,access">Доступ</a></li>
                          <li class="<%= activeSubmenu === 'team' ? 'active' : '' %>"><a href="/panel,settings,team">Команда</a></li>
                          <% } %>
                      </ul>
                  <% } %>
              </li>
              <% } %>


              <li class="<%= activeMenu === 'records' ? 'active expanded' : '' %>">
                  <a href="/panel,records"><span class="icon icon-media"></span> Медиа-архив</a>
                  <% if (activeMenu === 'records') { %>
                      <ul class="submenu">
                          <li class="<%= activeSubmenu === 'all' ? 'active' : '' %>"><a href="/panel,records">Все записи (<%= locals.panelStats ? locals.panelStats.totalRecords : 0 %>)</a></li>
                          <li class="<%= activeSubmenu === 'processing' ? 'active' : '' %>"><a href="/panel,records,processing">В обработке (<%= locals.panelStats ? locals.panelStats.processingRecords : 0 %>)</a></li>
                          <li class="<%= activeSubmenu === 'albums' ? 'active' : '' %>"><a href="/panel,albums">Альбомы (<%= locals.panelStats ? locals.panelStats.totalAlbums : 0 %>)</a></li>
                      </ul>
                  <% } %>
              </li>
              
              <% if (['owner', 'coowner', 'editor', 'staff'].includes(locals.panelRole)) { %>
              <li class="<%= activeMenu === 'autopilot' ? 'active' : '' %>">
                  <a href="/panel,autopilot"><span class="icon icon-autopilot"></span> Автопилот</a>
              </li>
              <li class="<%= activeMenu === 'announces' ? 'active' : '' %>">
                  <a href="/panel,announces"><span class="icon icon-announces"></span> Анонсы</a>
              </li>
              <% } %>

              <li class="<%= activeMenu === 'news' ? 'active' : '' %>">
                  <a href="/panel,news"><span class="icon icon-news"></span> Новости</a>
              </li>

              <% if (['owner', 'coowner', 'editor', 'staff'].includes(locals.panelRole)) { %>
              <li class="<%= activeMenu === 'stat' ? 'active expanded' : '' %>">
                  <a href="/panel,stat,viewers"><span class="icon icon-stat"></span> Статистика</a>
                  <% if (activeMenu === 'stat') { %>
                      <ul class="submenu">
                          <li class="<%= activeSubmenu === 'viewers' ? 'active' : '' %>"><a href="/panel,stat,viewers">Одновременные зрители</a></li>
                          <li class="<%= activeSubmenu === 'audience' ? 'active' : '' %>"><a href="/panel,stat,audience">Аудитория</a></li>
                          <li class="<%= activeSubmenu === 'records_stat' ? 'active' : '' %>"><a href="/panel,stat,records">Все записи</a></li>
                      </ul>
                  <% } %>
              </li>
              <% } %>
            <% } %>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <div class="content-wrapper">
            <% if (locals.query && locals.query.success) { %>
                <div class="panel-alert panel-alert--ok">
                    <% if (locals.query.success === 'invited') { %>
                        Приглашение отправлено пользователю. Он появится в команде после подтверждения.
                    <% } else if (locals.query.success === '1') { %>
                        Изменения успешно сохранены!
                    <% } else { %>
                        <%= locals.query.success %>
                    <% } %>
                </div>
            <% } %>
            <% if (locals.query && locals.query.error) { %>
                <div class="panel-alert panel-alert--err">
                    Ошибка: <%= locals.query.error %>
                </div>
            <% } %>
            <% if (locals.panelChannel && locals.panelChannel.status === 'banned') { %>
                <div class="panel-alert panel-alert--ban">
                    ВНИМАНИЕ: Данный телеканал был заблокирован администрацией платформы. Он недоступен для зрителей, и ваш аккаунт ограничен в создании новых телеканалов.
                    <a href="/appeals/new?type=channel_ban&id=<%= panelChannel.id %>" style="color:#6fdeee; margin-left:8px;">Обжаловать</a>
                </div>
            <% } %>
            <% if (typeof isModernTheme !== 'undefined' && isModernTheme && typeof breadcrumbs !== 'undefined' && breadcrumbs) { %>
            <nav class="panel-pagehead"><div class="panel-pagehead__crumbs"><%- breadcrumbs %></div></nav>
            <% } %>
            <%- body %>
        </div>
    </div>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<%- include('partials/confirm_modal') %>
<script>
document.addEventListener("DOMContentLoaded", function() {
    var menuToggle = document.getElementById("menuToggleBtn");
    var sidebar = document.querySelector(".sidebar");
    var overlay = document.getElementById("sidebarOverlay");

    if (menuToggle && sidebar && overlay) {
        menuToggle.addEventListener("click", function() {
            sidebar.classList.toggle("open");
            overlay.classList.toggle("active");
        });
        overlay.addEventListener("click", function() {
            sidebar.classList.remove("open");
            overlay.classList.remove("active");
        });
    }
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    var alerts = document.querySelectorAll(".panel-alert");
    alerts.forEach(function(alertEl) {
        var wrapper = document.querySelector(".content-wrapper");
        if (wrapper) {
            var headerBar = alertEl.nextElementSibling;
            while (headerBar && headerBar.classList.contains("panel-alert")) {
                headerBar = headerBar.nextElementSibling;
            }
            if (headerBar && headerBar.tagName === 'DIV') {
                headerBar.parentNode.insertBefore(alertEl, headerBar.nextSibling);
            }
        }
    });

    // Fade out non-critical panel-alerts after 5 seconds
    setTimeout(() => {
        alerts.forEach(function(alertEl) {
            if (alertEl.textContent.indexOf('заблокирован') === -1) {
                alertEl.style.transition = 'opacity 0.5s ease-out, height 0.5s ease-out, margin 0.5s ease-out, padding 0.5s ease-out';
                alertEl.style.opacity = '0';
                setTimeout(() => {
                    alertEl.style.height = '0';
                    alertEl.style.margin = '0';
                    alertEl.style.padding = '0';
                    alertEl.style.overflow = 'hidden';
                    setTimeout(() => alertEl.remove(), 500);
                }, 500);
            }
        });
    }, 5000);
});
</script>
<% if (typeof isModernTheme !== 'undefined' && isModernTheme) { %>
<script>window.ETOYATV_THEME = 'modern';</script>
<script src="<%= CDN_BASE_URL %>/js/scheme.js?v=<%= ASSET_VERSION %>"></script>
<% } %>
</body>
</html>
