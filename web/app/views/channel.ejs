                              <input type="text" name="chat_embedcode" id="chat_embedcode" onfocus="$(this).select();" value="" class="input-text"
                                style="width: 310px; background: #333; color: #fff; border: 1px solid #555; padding: 4px; text-align: left;">
                            </div>
