                            </div>

                            <!-- Chat Section -->
                            <div class="embed-section-title" style="font-weight: bold; margin-top: 20px; margin-bottom: 10px; font-size: 13px;">Встраивание чата:</div>
                            <div class="channel_embed" style="padding-top: 0;">
