            <!-- CHANNEL EMBED>> -->
            <div class="blocks">
              <div class="blackbox" style="  width: auto;">
                <div class="blackbox_tl"></div>
                <div class="blackbox_tc"></div>
                <div class="blackbox_tr"></div>
                <div class="blackbox_cw">
                  <div class="blackbox_c" style="">
                    <div class="blackbox_ci">
                      <div class="block-head-bg"></div>
                      <div class="block-head">
                        <div class="block-head-right">
                          <div class="block-title">Экспорт</div>
                        </div>
                      </div>
                      <div class="block-content">
                        <div class="channel_description">
                          <form class="embed_settings" onsubmit="return false;" style="padding-bottom: 0;">
                            <!-- Player Section -->
                            <div class="embed-section-title" style="font-weight: bold; margin-bottom: 10px; font-size: 13px;">Встраивание плеера:</div>
