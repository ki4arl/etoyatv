                                Вы не <a href="/login" target="_blank"
                                  style="color: #F2FFF9; margin-left: 4px; text-decoration: underline;">авторизованы</a>
                              </div>
                          </div>

                          <!-- Chat Overlay Menu (Hidden by default) -->
                          <div id="chat-menu"
                            style="display: none; position: absolute; bottom: 45px; right: 10px; background: #222; border: 1px solid #444; padding: 5px; z-index: 20; font-size: 11px; font-family: Verdana, sans-serif;">
                            <% if ((typeof isModerator !=='undefined' && isModerator) || (typeof user !=='undefined' &&
                              user && user.role==='admin' )) { %>
                              <div class="menu-item" id="btn-clear-chat"
                                style="padding: 5px 10px; color: #fff; cursor: pointer;">Очистить чат</div>
                              <div class="menu-item" id="btn-ban-guests"
                                style="padding: 5px 10px; color: #fff; cursor: pointer;">
                                <%= channel.guests_allowed ? 'Запретить гостей' : 'Разрешить гостей' %>
                              </div>
                              <% if (!channel.chat_disabled) { %>
                              <div class="menu-item" id="btn-toggle-chat"
                                style="padding: 5px 10px; color: #3b9cd9; cursor: pointer;">
                                <%= channel.chat_enabled ? 'Выключить чат' : 'Включить чат' %>
                              </div>
                              <% } %>
                              <% } else if (typeof user==='undefined' || !user) { %>
                                <div class="menu-item" id="btn-change-guest-nick"
                                  style="padding: 5px 10px; color: #fff; cursor: pointer;">Сменить ник</div>
                                <% } %>
                            <% if (chatMenuModern) { %>
                            <div class="chat-scale-menu" id="chat-scale-menu">
                              <span class="chat-scale-menu__label">Размер чата</span>
                              <div class="chat-scale-tumbler" id="chat-scale-tumbler" data-value="md" role="radiogroup" aria-label="Размер чата">
                                <span class="chat-scale-tumbler__thumb" aria-hidden="true"></span>
                                <button type="button" class="chat-scale-tumbler__btn" data-scale="sm" role="radio" aria-checked="false" title="Мелкий" aria-label="Мелкий"><span class="chat-scale-tumbler__glyph" aria-hidden="true"></span></button>
                                <button type="button" class="chat-scale-tumbler__btn is-active" data-scale="md" role="radio" aria-checked="true" title="Средний" aria-label="Средний"><span class="chat-scale-tumbler__glyph" aria-hidden="true"></span></button>
                                <button type="button" class="chat-scale-tumbler__btn" data-scale="lg" role="radio" aria-checked="false" title="Крупный" aria-label="Крупный"><span class="chat-scale-tumbler__glyph" aria-hidden="true"></span></button>
                              </div>
                            </div>
                            <% } %>
                          </div>

                        </div>
                      </div>


                      <script src="/socket.io/socket.io.js"></script>
                      <%
                        let currentUserStr = 'null';
                        let userToken = '';
                        if (typeof user !== 'undefined' && user) {
                          let finalRole = user.role;
                          if (user.role !== 'admin' && typeof channelRole !== 'undefined' && channelRole !== 'guest') {
                            finalRole = channelRole;
                          }
                          if (user.mask_mode === 'user_mask' || user.mask_mode === 'invisible') {
                            finalRole = 'registered';
                          }
                          if (user.id === channel.user_id) {
                            finalRole = 'owner';
                          }
                          const publicUser = {
                            id: user.id,
                            username: user.username,
                            role: finalRole,
                            chat_color: user.chat_color
                          };
                          currentUserStr = JSON.stringify(publicUser).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
                          userToken = encryptUser(Object.assign({}, publicUser, { mask_mode: user.mask_mode }));
                        }
                      %>
                       <script>
                         window.CHANNEL_ID = <%= channel.id %>;
                         window.CHANNEL_SHORTNAME = '<%= channel.shortname %>';
                         window.HIDE_LIVE_BADGE = <%= channel.hide_live_badge ? 'true' : 'false' %>;
                         window.CURRENT_USER = <%- currentUserStr %>;
                         window.CURRENT_USER_TOKEN = <%- userToken ? `'${userToken}'` : 'null' %>;
                         window.CHANNEL_OWNER_ID = <%= channel.user_id %>;
                         window.CHAT_ENABLED = <%= channel.chat_enabled ? 'true' : 'false' %>;
                         window.IS_MODERATOR = <%= typeof isModerator !== 'undefined' && isModerator ? 'true' : 'false' %>;
                         window.USER_TIMEZONE = '<%= typeof userTimezone !== 'undefined' ? userTimezone : 'Europe/Moscow' %>';
                         window.PINNED_MESSAGES = <%- JSON.stringify(channel.pinnedMessages || { common: null, 1: null, 2: null, 3: null }).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>;
                       </script>
                       <script src="<%= CDN_BASE_URL %>/js/modern-motion.js?v=<%= ASSET_VERSION %>"></script>
                       <script src="<%= CDN_BASE_URL %>/js/player.js?v=<%= ASSET_VERSION %>-q7"></script>
                      <script>
                      (function() {
                        function initEmojiPicker() {
                          const chatEmojiBtn = document.getElementById('chat-emoji-btn');
                          const chatEmojiPanel = document.getElementById('chat-emoji-panel');
                          const emojiGrid = document.getElementById('emoji-grid');
                          const chatInput = document.getElementById('chat-input');

                          if (!chatEmojiBtn || !chatEmojiPanel || !emojiGrid) return;

                          const emojiCategories = {
                            smileys: [
                              '😄', '😂', '😊', '🤣', '😍', '😉', '😏', '😒', '😭', '😱', '😡', '🤯', '😴', '🤓', '😎',
                              '🤔', '🙄', '😋', '😜', '😇', '🥺', '💩', '🤡', '👽', '👾', '👻', '💀', '🎃', '😺'
                            ],
                            gestures: [
                              '👍', '👎', '👏', '🙌', '🙏', '🤝', '✌️', '👌', '✊', '🖐', '🧠', '💬', '👀', '✍️',
                              '💪', '🤘', '👋', '💅', '👄', '👅', '👂', '👃', '👤', '👥', '🫂', '❤️', '💔', '💖'
                            ],
                            animals: [
                              '🐱', '🐶', '🐻', '🦊', '🦁', '🐯', '🐨', '🐼', '🐮', '🐷', '🐸', '🐵', '🐔', '🐧',
                              '🐦', '🦆', '🦅', '🦉', '🦄', '🐝', '🐛', '🦋', '🐞', '🕷', '🐙', '🐠', '🐬', '🐳'
                            ],
                            food: [
                              '🍏', '🍉', '🍓', '🍕', '🍔', '🍟', '🌭', '🍿', '🍦', '🍰', '🍩', '🍪', '🍺', '🍷', '☕️',
                              '🍎', '🍇', '🍒', '🥑', '🌮', '🍜', '🍣', '🍫', '🍬', '🥤', '🍼', '🧉', '🍾'
                            ],
                            symbols: [
                              '🔥', '❤️', '💥', '🎉', '🌟', '✨', '💯', '💡', '📌', '🚀', '🚗', '🎮', '🛡️', '⚠️',
                              '☀️', '🌙', '⭐', '🌈', '⚡', '❄️', '💤', '🎵', '🔔', '📢', '🎁', '🎈', '⚙️', '💎'
                            ]
                          };

                          const loadTabEmojis = (tabName) => {
                            const list = emojiCategories[tabName] || [];
                            emojiGrid.innerHTML = '';
                            list.forEach(emoji => {
                              const btn = document.createElement('button');
                              btn.type = 'button';
                              btn.className = 'emoji-item';
                              btn.textContent = emoji;
                              btn.addEventListener('click', (e) => {
                                e.stopPropagation();
                                if (chatInput && !chatInput.disabled) {
                                  const startPos = chatInput.selectionStart;
                                  const endPos = chatInput.selectionEnd;
                                  const text = chatInput.value;
                                  chatInput.value = text.substring(0, startPos) + emoji + text.substring(endPos);
                                  chatInput.focus();
                                  const newCursorPos = startPos + emoji.length;
                                  chatInput.setSelectionRange(newCursorPos, newCursorPos);
                                }
                              });
                              emojiGrid.appendChild(btn);
                            });
                          };

                          const newBtn = chatEmojiBtn.cloneNode(true);
                          chatEmojiBtn.parentNode.replaceChild(newBtn, chatEmojiBtn);

                          newBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            const mm = window.ModernMotion;
                            const isHidden = chatEmojiPanel.style.display === 'none' || chatEmojiPanel.style.display === '';
                            if (isHidden) {
                              const activeTab = chatEmojiPanel.querySelector('.emoji-tab.active');
                              const defaultTab = activeTab ? activeTab.getAttribute('data-tab') : 'smileys';
                              loadTabEmojis(defaultTab);

                              const colorPalette = document.getElementById('chat-color-palette');
                              if (colorPalette) mm ? mm.hideInstant(colorPalette) : (colorPalette.style.display = 'none');
                              const chatMenu = document.getElementById('chat-menu');
                              if (chatMenu) mm ? mm.hideInstant(chatMenu) : (chatMenu.style.display = 'none');

                              chatEmojiPanel.dataset.modernDisplay = 'flex';
                              if (mm) mm.show(chatEmojiPanel, { display: 'flex' });
                              else chatEmojiPanel.style.display = 'flex';
                            } else if (mm) {
                              mm.hide(chatEmojiPanel);
                            } else {
                              chatEmojiPanel.style.display = 'none';
                            }
                          });

                          chatEmojiPanel.querySelectorAll('.emoji-tab').forEach(tabBtn => {
                            tabBtn.addEventListener('click', (e) => {
                              e.stopPropagation();
                              chatEmojiPanel.querySelectorAll('.emoji-tab').forEach(b => b.classList.remove('active'));
                              tabBtn.classList.add('active');
                              const tabName = tabBtn.getAttribute('data-tab');
                              loadTabEmojis(tabName);
                            });
                          });

                          document.addEventListener('click', (e) => {
                            const mm = window.ModernMotion;
                            if (chatEmojiPanel.style.display === 'flex' && !chatEmojiPanel.contains(e.target) && e.target !== newBtn) {
                              if (mm) mm.hide(chatEmojiPanel);
                              else chatEmojiPanel.style.display = 'none';
                            }
                          });
                        }

                        if (document.readyState === 'loading') {
                          document.addEventListener('DOMContentLoaded', initEmojiPicker);
                        } else {
                          initEmojiPicker();
                        }
                      })();
                      </script>
                    </div>
                    <div class="clear_both"></div>
                  </div>
                  <div class="clear_both"></div>
                </div>
                <div class="clear_both"></div>
              </div>
            </div>
            <div class="blackbox_bl"></div>
            <div class="blackbox_bc"></div>
            <div class="blackbox_br"></div>
          </div>

        </div>
        <!-- LEFT COLUMN>> -->
        <div class="left_blocks">
          <a name="records"></a>
          <!-- RECORDS LIST>> -->
          <div class="block_item">
            <div class="blackbox" style="  width: auto;">
              <div class="blackbox_tl"></div>
              <div class="blackbox_tc"></div>
              <div class="blackbox_tr"></div>
              <div class="blackbox_cw">
                <div class="blackbox_c" style="">
                  <div class="blackbox_ci">
                    <div class="block-head-bg"></div>
                    <div class="block-head">
                      <div class="block-head-right">
                        <div class="block-title">Записи телеканала <%- `(<a href="/channel,records?shortname=${channel.shortname}" title="Все записи телеканала" class="darkblue">${totalRecords}</a>)` %></div>
                        <div class="block-buttons">
                          <a href="/channel,records?shortname=<%= channel.shortname %>" title="Все записи телеканала"
                            class="block-buttons-bg-last"><span class="block-head-icon-archive"></span></a>
                        </div>
                      </div>
