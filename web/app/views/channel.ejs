                                <input type="checkbox" class="input-checkbox" id="player_variant_new" name="player_variant_new" value="1" checked="checked">
                                <label for="player_variant_new" class="checked" style="color: #c0c0b2;">Новый дизайн плеера (variant=new)</label>
                              </div>
                              <div style="font-size: 11px; color: #8c989e; margin-top: 6px; line-height: 1.4;">
                                Без галочки — заводской iframe для старых встраиваний. С галочкой — современный плеер.
                              </div>
                            </div>
                            <% } %>
                            
                            <div class="clear_both"></div>
                            
                            <div class="channel_embed" style="padding-top: 10px;">
                              <div class="label" style="color: #c0c0b2;">HTML-код плеера:</div>
                              <input type="text" name="embedcode" id="embedcode" onfocus="$(this).select();" value="" class="input-text"
