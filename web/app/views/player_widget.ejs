<%
  const isPlayerModern = !!(typeof playerModern !== 'undefined' && playerModern);
%>
<!DOCTYPE html>
<html lang="ru"<% if (isPlayerModern) { %> class="theme_modern" data-scheme="dark"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Плеер <%= channel.name %> | ЭтоЯTV</title>
  <% if (isPlayerModern) { %>
  <link href="<%= CDN_BASE_URL %>/css/theme_tokens.css?v=<%= ASSET_VERSION %>-lt2" rel="stylesheet" type="text/css">
  <link href="<%= CDN_BASE_URL %>/css/player_modern.css?v=<%= ASSET_VERSION %>-p24" rel="stylesheet" type="text/css">
  <% } else { %>
  <link href="<%= CDN_BASE_URL %>/css/css_0.css?v=<%= ASSET_VERSION %>" rel="stylesheet" type="text/css">
  <link href="<%= CDN_BASE_URL %>/css/css_1.css?v=<%= ASSET_VERSION %>" rel="stylesheet" type="text/css">
  <% } %>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
      font-family: <% if (isPlayerModern) { %>var(--font), Tahoma, sans-serif<% } else { %>Tahoma, sans-serif<% } %>;
      text-align: left !important;
      min-width: 0 !important;
    }
    /* Виджет без чата: не даём site-правилу calc(100% - 380px) сузить кадр. */
    #container_swf,
    .theme_modern #container_swf {
      position: relative !important;
      width: 100% !important;
      height: 100% !important;
      min-width: 0 !important;
      margin: 0 !important;
      aspect-ratio: auto !important;
      border-right: none !important;
      border-radius: 0 !important;
      overflow: hidden !important;
      background: #000 !important;
      box-sizing: border-box;
    }
    .theme_modern #etoyatv-video {
      position: absolute;
      inset: 0;
      width: 100% !important;
      height: 100% !important;
    }
  </style>
  <style>
    #etoyatv-offline-overlay {
      z-index: 15 !important;
      <% if (channel.player_bg_url) { %>
        background-image: url('<%= CDN_BASE_URL %><%= channel.player_bg_url %>') !important;
        background-size: <%= channel.player_bg_fit === 'contain' ? 'contain' : (channel.player_bg_fit === 'stretch' ? '100% 100%' : 'cover') %> !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
        background-color: <%= channel.player_bg_color || 'transparent' %> !important;
      <% } else { %>
        background-image: none !important;
        background-color: #000 !important;
      <% } %>
    }
    <% if (channel.player_menu_color) { %>
      #container_swf .player-menu-bg:not(.pl-bar--bottom),
      #container_swf .player-actions button,
      #container_swf .player-actions a,
      #container_swf .pl-bar--bottom .pl-btn,
      #container_swf .volume-slider-wrapper {
        background: <%= channel.player_menu_color %> !important;
      }
    <% } %>
    <% if (channel.player_link_color) { %>
      #container_swf .player-ui a,
      #container_swf .player-ui button,
      #container_swf .player-ui span,
      #container_swf #viewers-count-player {
        color: <%= channel.player_link_color %> !important;
      }
    <% } %>
  </style>
</head>
<body<% if (isPlayerModern) { %> class="theme_modern"<% } %>>

<div id="container_swf" style="position: relative; background: #000;">
  <video id="etoyatv-video" width="100%" height="100%"
    style="width: 100%; height: 100%; background: #000; object-fit: contain; cursor: pointer;"
    playsinline webkit-playsinline disableRemotePlayback></video>

  <canvas id="etoyatv-transition-canvas"
    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 0.5s ease-out; object-fit: contain;"></canvas>

  <canvas id="etoyatv-overlays-canvas" width="1280" height="720"
    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; object-fit: contain; display: none;"></canvas>

  <% if (isPlayerModern) { %>
  <%- include('partials/player_spinner') %>
  <% } else { %>
  <div id="etoyatv-spinner"
    style="display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5; pointer-events: none;">
    <svg width="24" height="24" viewBox="0 0 24 24"
      style="animation: etoyatv-spin 1s steps(8, end) infinite;">
      <circle cx="12" cy="2" r="2.5" fill="rgba(255,255,255,1)" />
      <circle cx="19.07" cy="4.93" r="2" fill="rgba(255,255,255,0.8)" />
      <circle cx="22" cy="12" r="1.5" fill="rgba(255,255,255,0.6)" />
      <circle cx="19.07" cy="19.07" r="1.5" fill="rgba(255,255,255,0.4)" />
      <circle cx="12" cy="22" r="1.5" fill="rgba(255,255,255,0.2)" />
      <circle cx="4.93" cy="19.07" r="1.5" fill="rgba(255,255,255,0.1)" />
      <circle cx="2" cy="12" r="1.5" fill="rgba(255,255,255,0.1)" />
      <circle cx="4.93" cy="4.93" r="1.5" fill="rgba(255,255,255,0.1)" />
    </svg>
  </div>
  <style>
    @keyframes etoyatv-spin {
      to { transform: rotate(360deg); }
    }
  </style>
  <% } %>

  <div id="etoyatv-pip-overlay"
    style="display: none; position: absolute; inset: 0; z-index: 6; background: #181818; color: #fff; flex-direction: column; align-items: center; justify-content: center; gap: 14px; font-family: Tahoma, sans-serif; text-align: center; padding: 16px; box-sizing: border-box;">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2"/>
      <path d="M8 21h8"/>
      <path d="M12 17v4"/>
      <rect x="11" y="8" width="8" height="6" rx="1" fill="#555" stroke="#888"/>
    </svg>
    <div style="font-size: 15px; font-weight: bold; color: #fff;">Видео вынесено в отдельное окно</div>
    <button type="button" id="btn-pip-return"
      style="margin-top: 4px; padding: 8px 16px; border: none; border-radius: 3px; background: #00a0e3; color: #fff; font-size: 12px; font-weight: bold; cursor: pointer; font-family: Tahoma, sans-serif;">
      Вернуть сюда
    </button>
  </div>

  <div id="etoyatv-offline-overlay"
    style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; color: #fff; align-items: center; justify-content: center; font-size: 18px; font-weight: bold; font-family: Tahoma, sans-serif; z-index: 15;">
    <% if (!channel.player_bg_url) { %>
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2" fill="white" />
          <line x1="15" y1="9" x2="9" y2="15" stroke="black" stroke-width="2.5" stroke-linecap="round" />
          <line x1="9" y1="9" x2="15" y2="15" stroke="black" stroke-width="2.5" stroke-linecap="round" />
        </svg>
        <span style="font-size: 16px; font-weight: bold; color: #fff; font-family: Tahoma, sans-serif;">Нет трансляции</span>
      </div>
    <% } %>
  </div>

  <div id="etoyatv-nosignal-overlay"
    style="display: none; flex-direction: column; gap: 15px; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); color: #fff; align-items: center; justify-content: center; font-size: 18px; font-weight: bold; font-family: Tahoma, sans-serif; z-index: 2.5;">
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M14 7H3C1.9 7 1 7.9 1 9v6c0 1.1.9 2 2 2h8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M17 8.5L22 5v14l-5-3.5v-7z" fill="white" />
        <path d="M15 13l5 5M20 13l-5 5" stroke="white" stroke-width="2.5" stroke-linecap="round" />
      </svg>
      <span style="font-size: 16px; font-weight: bold; color: #fff; font-family: Tahoma, sans-serif;">Нет сигнала</span>
    </div>
  </div>

  <div id="etoyatv-signal-banner" class="etoyatv-signal-banner" style="display: none;" role="status" aria-live="polite">
    <span class="etoyatv-signal-banner__dot" aria-hidden="true"></span>
    <span class="etoyatv-signal-banner__text">В данный момент у канала проблемы с сигналом — нестабильное соединение. Трансляция продолжится, когда связь восстановится.</span>
  </div>

  <% if (channel.is_18_plus) { %>
    <% if (isPlayerModern) { %>
      <%- include('partials/player_18plus_modern', { overlayVideoId: 'etoyatv-video', overlayAutoShow: true }) %>
    <% } else { %>
    <div id="etoyatv-18plus-overlay"
      style="display: none; flex-direction: column; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; color: #fff; align-items: center; justify-content: center; font-family: Tahoma, sans-serif; z-index: 20;">
      <div style="font-size: 24px; font-weight: bold; margin-bottom: 15px;">Внимание! Контент 18+</div>
      <div style="font-size: 16px; margin-bottom: 25px;">Подтвердите, что вам уже исполнилось 18 лет.</div>
      <button onclick="confirm18Plus()"
        style="padding: 10px 20px; background: #3b9cd9; color: #fff; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;">Мне есть 18 лет</button>
    </div>
    <script>
      function confirm18Plus() {
        localStorage.setItem('etoyatv_global_18plus', 'true');
        document.getElementById('etoyatv-18plus-overlay').style.display = 'none';
        const video = document.getElementById('etoyatv-video');
        if (video) video.play().catch(e => console.error('Play error after 18+ confirmation:', e));
      }
      if (localStorage.getItem('etoyatv_global_18plus') !== 'true') {
        document.getElementById('etoyatv-18plus-overlay').style.display = 'flex';
      }
      document.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('etoyatv_global_18plus') !== 'true') {
          const video = document.getElementById('etoyatv-video');
          if (video) video.pause();
        }
      });
    </script>
    <% } %>
  <% } %>

  <% if (isPlayerModern) { %>
  <%- include('partials/player_overlays_modern', { channel: channel, showPopout: true, showCast: true, showReport: true }) %>
  <% } else { %>
  <div id="player_live_idle" style="position: absolute; top: 10px; left: 10px; z-index: 10; transition: opacity 0.3s; pointer-events: none; opacity: 0;">
    <div class="live_label" id="player_live_label"
      style="display: none; width: 32px; height: 17px; background: url(<%= CDN_BASE_URL %>/images/css_img_2_sprite1.png) no-repeat -124px -254px;">
    </div>
  </div>

  <div class="player-ui"
    style="position: absolute; top: 10px; left: 10px; display: flex; align-items: flex-start; gap: 5px; z-index: 10; transition: opacity 0.3s;">
    <a href="/<%= channel.shortname %>" target="_blank" style="display: block;">
      <img src="<%= CDN_BASE_URL %><%= channel.logo_url || '/images/default_channel_logo_50.png'  %>" alt="Logo"
        style="width: 50px; height: 50px; background: <%= channel.player_bg_color || '#000000' %>; border: 1px solid #444; box-sizing: border-box; object-fit: <%= channel.logo_fit === 'contain' ? 'contain' : 'cover' %>; <%= channel.is_18_plus ? 'filter: blur(4px);' : '' %>">
    </a>
    <div style="display: flex; flex-direction: row; align-items: center; gap: 5px;">
      <a href="/<%= channel.shortname %>" target="_blank"
        style="background: rgba(0,0,0,0.6); color: #00A3E0; font-size: 11px; font-family: Tahoma, sans-serif; padding: 3px 6px; display: inline-flex; align-items: center; text-decoration: none; white-space: nowrap;">
        <%= channel.name %>
        <% if (channel.is_verified) { %>
          <span class="verified_icon <%= channel.is_premium ? 'blue' : '' %>" title="<%= channel.is_premium ? 'Премиум канал' : 'Подтвержденный канал' %>" style="margin-left: 5px; display: inline-block;"></span>
        <% } %>
      </a>
    </div>
  </div>

  <div class="player-actions player-ui"
    style="position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; gap: 5px; z-index: 10; transition: opacity 0.3s;">
    <button onclick="copyShareLink('<%= channel.shortname %>')" title="Поделиться"
      style="width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; font-size: 16px; display: flex; justify-content: center; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button>
    <button onclick="window.open('/<%= channel.shortname %>', '_blank')" title="Пожаловаться"
      style="width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; font-size: 16px; display: flex; justify-content: center; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></button>
    <a href="/channel,records?shortname=<%= channel.shortname %>" target="_blank" title="Записи"
      style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; text-decoration: none; font-size: 16px;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><rect x="2" y="2" width="20" height="14" rx="2.18" ry="2.18"></rect><line x1="12" y1="20" x2="12" y2="22"></line><line x1="8" y1="22" x2="16" y2="22"></line><line x1="12" y1="16" x2="12" y2="20"></line></svg></a>
    <button id="btn-popout" type="button" title="Мини-плеер"
      style="width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; display: flex; justify-content: center; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><rect x="12" y="10" width="8" height="5" rx="1" fill="currentColor" stroke="none"/></svg></button>
    <button id="btn-cast" type="button" title="Chromecast"
      style="width: 32px; height: 32px; background: rgba(0,0,0,0.7); border: none; color: #fff; cursor: pointer; border-radius: 3px; display: none; justify-content: center; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M1 18v3h3c0-1.66-1.34-3-3-3zm0-4v2c2.76 0 5 2.24 5 5h2c0-3.87-3.13-7-7-7zm0-4v2c4.97 0 9 4.03 9 9h2c0-6.08-4.93-11-11zM21 3H3c-1.1 0-2 .9-2 2v3h2V5h18v14h-7v2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2z"/></svg></button>
  </div>

  <div class="player-ui player-menu-bg"
    style="position: absolute; bottom: 10px; left: 10px; background: rgba(0,0,0,0.7); padding: 5px 12px; border-radius: 3px; z-index: 10; display: flex; align-items: center; justify-content: center; transition: opacity 0.3s; gap: 10px;">
    <button id="btn-play-pause" title="Play/Pause"
      style="background: transparent; border: none; color: #fff; font-size: 18px; cursor: pointer; outline: none; display: inline-flex; align-items: center; justify-content: center; padding: 0;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg></button>
  </div>

  <div class="player-ui player-menu-bg"
    style="position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.7); padding: 5px 10px; border-radius: 3px; z-index: 10; display: flex; align-items: center; gap: 4px; transition: opacity 0.3s;">
    <div id="stream-selector-container" style="display: none; align-items: center; gap: 4px; margin: 0; padding: 0;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; color: #fff; margin: 0;" title="Камера"><path d="M23 7l-7 5 7 5V7z"></path><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
      <div id="stream-buttons" style="display: flex; gap: 4px; margin: 0; padding: 0;"></div>
    </div>

    <div
      style="position: relative; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0;"
      class="volume-container"
      onmouseenter="this.querySelector('.volume-slider-wrapper').style.display='block'"
      onmouseleave="this.querySelector('.volume-slider-wrapper').style.display='none'">
      <button id="btn-volume"
        style="background: transparent; border: none; color: #fff; cursor: pointer; outline: none; padding: 0 2px; margin: 0; position: relative; z-index: 5; display: flex; align-items: center; justify-content: center;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
      </button>
      <div class="volume-slider-wrapper"
        style="position: absolute; bottom: 25px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); border-radius: 3px; display: none; height: 90px; width: 30px; padding: 0; z-index: 4;">
        <div
          style="position: absolute; bottom: -25px; left: 0; width: 100%; height: 25px; background: transparent;">
        </div>
        <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="1"
          style="position: absolute; top: 50%; left: 50%; width: 70px; height: 4px; cursor: pointer; transform: translate(-50%, -50%) rotate(-90deg); margin: 0; padding: 0;">
      </div>
    </div>
    <div style="display: flex; align-items: center; color: #fff; font-size: 11px; margin: 0; padding: 0 2px;">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="vertical-align: middle; margin-right: 3px; color: #fff;"><g transform="translate(16, 0) scale(-1, 1)"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/></g></svg>
      <span id="viewers-count-player" style="margin: 0;">1</span>
    </div>
    <button id="btn-fullscreen"
      style="background: transparent; border: none; color: #fff; cursor: pointer; outline: none; display: flex; align-items: center; justify-content: center; padding: 0 2px; margin: 0;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
    </button>
    <a href="/" target="_blank"
      style="font-weight: bold; color: #fff; font-size: 12px; text-decoration: none; margin: 0; padding: 0 2px;">ЭтоЯTV</a>
  </div>
  <% } %>
</div>

<div style="display: none;">
  <div id="chat_text_field"></div>
  <input type="text" id="chat-input">
  <button id="btn-chat-menu"></button>
  <div id="chat-menu"></div>
  <div id="chat-users-list"></div>
  <span id="chat-viewers-count"></span>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17"></script>

<%
  let currentUserStr = 'null';
  let userToken = '';
  if (typeof user !== 'undefined' && user) {
    let finalRole = user.role;
    if (user.role !== 'admin' && typeof channelRole !== 'undefined' && channelRole !== 'guest') {
      finalRole = channelRole;
    }
    if (user.mask_mode === 'user_mask' || user.mask_mode === 'invisible') {
      finalRole = 'registered';
    }
    if (user.id === channel.user_id) {
      finalRole = 'owner';
    }
    const publicUser = {
      id: user.id,
      username: user.username,
      role: finalRole,
      chat_color: user.chat_color
    };
    currentUserStr = JSON.stringify(publicUser).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
    userToken = encryptUser(Object.assign({}, publicUser, { mask_mode: user.mask_mode }));
  }
%>
<script>
  window.CHANNEL_ID = <%= channel.id %>;
  window.CHANNEL_SHORTNAME = '<%= channel.shortname %>';
  window.HIDE_LIVE_BADGE = <%= channel.hide_live_badge ? 'true' : 'false' %>;
  window.CURRENT_USER = <%- currentUserStr %>;
  window.CURRENT_USER_TOKEN = <%- userToken ? `'${userToken}'` : 'null' %>;
  window.CHANNEL_OWNER_ID = <%= channel.user_id %>;
  window.CHAT_ENABLED = <%= channel.chat_enabled ? 'true' : 'false' %>;
  window.IS_MODERATOR = <%= typeof isModerator !== 'undefined' && isModerator ? 'true' : 'false' %>;
  window.USER_TIMEZONE = '<%= typeof userTimezone !== 'undefined' ? userTimezone : 'Europe/Moscow' %>';
  window.PLAYER_COLOR = '<%= channel.player_color || "#00a0e3" %>';
  window.openReportModal = function () {
    window.open('/<%= channel.shortname %>', '_blank');
  };
</script>
<script src="<%= CDN_BASE_URL %>/js/player.js?v=<%= ASSET_VERSION %>-q3"></script>

</body>
</html>
