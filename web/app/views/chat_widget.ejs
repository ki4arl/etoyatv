      <span style="cursor: pointer; font-size: 18px; line-height: 1; color: #aaa;" onclick="window.closeClearChatModal()">&times;</span>
    </div>
    <div style="padding: 15px;">
      <p style="margin: 0 0 15px; font-size: 13px; color: #ccc;">Вы уверены, что хотите очистить чат?</p>
      <div style="text-align: right;">
        <button onclick="window.closeClearChatModal()" style="padding: 6px 15px; border: 1px solid #555; background: transparent; color: #fff; cursor: pointer; border-radius: 4px; margin-right: 5px; font-size: 12px; transition: background 0.2s;">Отмена</button>
        <button onclick="window.submitClearChat()" style="padding: 6px 15px; border: none; background: #cc3333; color: #fff; cursor: pointer; border-radius: 4px; font-weight: bold; font-size: 12px; transition: background 0.2s;">Очистить</button>
