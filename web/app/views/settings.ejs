<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
  // Cropper logic
  const avatarInput = document.getElementById('avatarInput');
  const cropperModal = document.getElementById('cropperModal');
  const cropperImage = document.getElementById('cropperImage');
  const btnCancelCrop = document.getElementById('btnCancelCrop');
  const btnApplyCrop = document.getElementById('btnApplyCrop');
  const avatarPreviewImg = document.getElementById('avatarPreviewImg');
  let cropper;

  avatarInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file) return;
    
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp', 'image/apng'];
    const allowedExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.apng'];
    const extension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();

    if (!allowedTypes.includes(file.type) && !allowedExtensions.includes(extension)) {
      alert("Неподдерживаемый формат файла. Разрешена загрузка только изображений (jpeg, jpg, png, gif, webp, apng).");
      this.value = '';
      return;
    }

    if (file.size > 4 * 1024 * 1024) {
      alert("Размер файла превышает 4 МБ.");
      this.value = '';
      return;
    }

    const reader = new FileReader();
    reader.onload = function(event) {
      const arr = new Uint8Array(event.target.result);
      let hasAcn = false;
      for (let i = 0; i < arr.length - 4; i++) {
        if (arr[i] === 0x61 && arr[i+1] === 0x63 && arr[i+2] === 0x54 && arr[i+3] === 0x4C) { // "acTL"
          hasAcn = true;
          break;
        }
      }

      const isGif = file.type === 'image/gif' || extension === '.gif';
      const isApng = file.type === 'image/apng' || extension === '.apng' || hasAcn;

      if (isGif || isApng) {
        // Bypass cropper, show preview directly
        const dataReader = new FileReader();
        dataReader.onload = function(e) {
          const preview = document.getElementById('avatarPreviewImg');
          if (preview) preview.src = e.target.result;
        };
        dataReader.readAsDataURL(file);
      } else {
        // Open cropper modal
        const dataReader = new FileReader();
        dataReader.onload = function(e) {
          cropperImage.src = e.target.result;
          cropperModal.style.display = 'flex';
          
          if (cropper) cropper.destroy();
          cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1
          });
        };
        dataReader.readAsDataURL(file);
      }
    };
    reader.readAsArrayBuffer(file);
  });

  btnCancelCrop.addEventListener('click', function() {
    cropperModal.style.display = 'none';
    if (cropper) cropper.destroy();
    avatarInput.value = '';
  });

  btnApplyCrop.addEventListener('click', function() {
    if (!cropper) return;
    
    const canvas = cropper.getCroppedCanvas({
      width: 100,
      height: 100,
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high'
    });
    
    canvas.toBlob(function(blob) {
      const file = new File([blob], "avatar.jpg", { type: "image/jpeg" });
      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(file);
      avatarInput.files = dataTransfer.files;
      
      avatarPreviewImg.src = canvas.toDataURL("image/jpeg");
      
      cropperModal.style.display = 'none';
      cropper.destroy();
    }, "image/jpeg", 0.9);
  });

  // Tabs logic — hash для шаринга/редиректов, без scrollIntoView и без location.hash
  const tabs = document.querySelectorAll('#settingsTabs li');
  const blocks = document.querySelectorAll('.settings-block');
  const settingsContent = document.querySelector('.settings-content');

  function setSettingsTabHash(tabId) {
    const next = '#' + tabId;
    if (window.location.hash === next) return;
    if (typeof history.replaceState === 'function') {
      history.replaceState(null, '', next);
    }
  }

  function showSettingsTab(tabId) {
    const target = document.getElementById(tabId);
    if (!target) return false;
    tabs.forEach(function(t) {
      t.classList.toggle('active', t.getAttribute('data-tab') === tabId);
    });
    if (document.body.classList.contains('theme_modern') && window.ModernMotion) {
      window.ModernMotion.switchTab(blocks, target);
    } else {
      blocks.forEach(function(b) {
        b.classList.toggle('active', b.id === tabId);
      });
    }
    return true;
  }

  let activeTabId = window.__settingsTabHash || (window.location.hash ? window.location.hash.substring(1) : 'tab-profile');
  if (!document.getElementById(activeTabId)) activeTabId = 'tab-profile';
  showSettingsTab(activeTabId);
  setSettingsTabHash(activeTabId);
  requestAnimationFrame(function() {
    if (settingsContent) settingsContent.classList.add('is-ready');
  });

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      const tabId = tab.getAttribute('data-tab');
      if (!tabId || tab.classList.contains('active')) return;
      if (!showSettingsTab(tabId)) return;
      setSettingsTabHash(tabId);
    });
  });

  // Profile export / transfer job UI — two independent panels
  (function() {
    const panels = {
      personal: document.getElementById('exportPanel-personal'),
      transfer: document.getElementById('exportPanel-transfer')
    };
    const ticketUrls = { personal: null, transfer: null };
    const pollTimers = { personal: null, transfer: null };

    // The i18n middleware skips <script>, so these strings come from the server dictionary
    const I18N = <%- JSON.stringify({
      queued: t('В очереди…'),
      processing: t('Готовим записи (MP4)…'),
      zipping: t('Упаковываем архив…'),
      ready: t('Архив готов'),
      failed: t('Не удалось собрать архив'),
      starting: t('Запускаем…'),
      willReplace: t('Предыдущий архив этого типа будет удалён. Ожидайте…'),
      record: t('Запись {cur} из {total}'),
      estSize: t('Ориентировочный размер:'),
      eta: t('Примерное ожидание:'),
      size: t('Размер:'),
      available: t('Файл доступен'),
      availableUntil: t('Файл доступен до'),
      twoDays: t('2 суток'),
      canClose: t('Можно закрыть вкладку и вернуться сюда позже.'),
      oneTimeLink: t('Ссылка одноразовая, ~1 минута. Повторная сборка этого типа удалит текущий файл.'),
      hintTransfer: t('Архив для переноса — загрузите на другом инстансе через «Загрузить архив переноса».'),
      hintPersonal: t('Личный бэкап — папка «Мои записи». На другой инстанс не подходит.'),
      skipped: t('Пропущено записей:'),
      error: t('Ошибка'),
      failedShort: t('не удалось'),
      networkError: t('Ошибка сети'),
      tryAgain: t('Попробуйте ещё раз'),
      oneMoment: t('Секунду…'),
      unavailable: t('Архив недоступен. Соберите заново.'),
      noLink: t('Не удалось получить ссылку. Обновите страницу.')
    }) %>;

    function csrfHeaders() {
      const h = { 'Content-Type': 'application/json' };
      if (window.csrfToken) h['X-CSRF-Token'] = window.csrfToken;
      return h;
    }

    function els(type) {
      const panel = panels[type];
      if (!panel) return null;
      return {
        panel: panel,
        title: panel.querySelector('.export-job-title'),
        bar: panel.querySelector('.export-job-bar'),
        meta: panel.querySelector('.export-job-meta'),
        actions: panel.querySelector('.export-job-actions'),
        downloadBtn: panel.querySelector('.export-job-download'),
        skippedEl: panel.querySelector('.export-job-skipped')
      };
    }

    function renderJob(job) {
      if (!job || !job.type) return;
      const ui = els(job.type);
      if (!ui) return;
      ui.panel.style.display = 'block';
      const pct = job.progress_total > 0
        ? Math.min(100, Math.round(100 * job.progress_current / job.progress_total))
        : (job.status === 'ready' ? 100 : (job.status === 'zipping' ? 95 : 5));
      ui.bar.style.width = pct + '%';

      const sizeLabel = job.actual_label || job.estimated_label || '—';
      const typeBit = job.type_label ? ('<span style="color:#777">' + job.type_label + '</span><br>') : '';

      if (job.status === 'queued') {
        ui.title.textContent = I18N.queued;
        ui.meta.innerHTML = typeBit + I18N.estSize + ' <strong style="color:#ccc">' + sizeLabel + '</strong><br>' + I18N.eta + ' ' + (job.eta_label || '—');
        ui.actions.style.display = 'none';
        ticketUrls[job.type] = null;
      } else if (job.status === 'processing') {
        ui.title.textContent = I18N.processing;
        ui.meta.innerHTML = typeBit + I18N.record.replace('{cur}', job.progress_current).replace('{total}', job.progress_total) +
          '<br>' + I18N.estSize + ' <strong style="color:#ccc">' + sizeLabel + '</strong>' +
          '<br>' + I18N.eta + ' ' + (job.eta_label || '—') +
          '<br><span style="color:#777">' + I18N.canClose + '</span>';
        ui.actions.style.display = 'none';
        ticketUrls[job.type] = null;
      } else if (job.status === 'zipping') {
        ui.title.textContent = I18N.zipping;
        ui.meta.innerHTML = typeBit + I18N.estSize + ' <strong style="color:#ccc">' + sizeLabel + '</strong>';
        ui.actions.style.display = 'none';
        ticketUrls[job.type] = null;
      } else if (job.status === 'ready') {
        ui.title.textContent = I18N.ready;
        const until = job.expires_label
          ? (job.expires_label + (job.remaining_label ? ', ' + job.remaining_label : ''))
          : (job.remaining_label || I18N.twoDays);
        const availLabel = job.expires_label ? I18N.availableUntil : I18N.available;
        const purposeHint = job.type === 'transfer'
          ? '<br><span style="color:#6fdeee">' + I18N.hintTransfer + '</span>'
          : '<br><span style="color:#aaa">' + I18N.hintPersonal + '</span>';
        ui.meta.innerHTML = typeBit + I18N.size + ' <strong style="color:#ccc">' + (job.actual_label || sizeLabel) + '</strong>' +
          '<br>' + availLabel + ' <strong style="color:#ccc">' + until + '</strong>' +
          '<br><span style="color:#777">' + I18N.oneTimeLink + '</span>' +
          purposeHint;
        ui.actions.style.display = 'block';
        ticketUrls[job.type] = job.ticket_url || null;
        if (ui.downloadBtn) ui.downloadBtn.disabled = !ticketUrls[job.type];
      } else if (job.status === 'failed') {
        ui.title.textContent = I18N.failed;
        ui.meta.innerHTML = '<span style="color:#ff6666">' + (job.error_text || I18N.error) + '</span>';
        ui.actions.style.display = 'none';
        ticketUrls[job.type] = null;
      } else if (job.status === 'expired') {
        ui.panel.style.display = 'none';
        ticketUrls[job.type] = null;
        return;
      }

      if (job.skipped && job.skipped.length) {
        ui.skippedEl.style.display = 'block';
        ui.skippedEl.textContent = I18N.skipped + ' ' + job.skipped.length +
          ' (' + job.skipped.slice(0, 5).map(function(s) { return '#' + s.record_id; }).join(', ') +
          (job.skipped.length > 5 ? '…' : '') + ')';
      } else {
        ui.skippedEl.style.display = 'none';
      }
    }

    function stopPoll(type) {
      if (pollTimers[type]) { clearInterval(pollTimers[type]); pollTimers[type] = null; }
    }

    function startPoll(type, jobId) {
      stopPoll(type);
      pollTimers[type] = setInterval(function() {
        fetch('/api/account/export/' + jobId, { credentials: 'same-origin' })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.ok || !data.job) return;
            renderJob(data.job);
            if (data.job.status === 'ready' || data.job.status === 'failed' || data.job.status === 'expired') {
              stopPoll(type);
              // refresh both panels so the other type stays visible
              restoreLatest();
            }
          })
          .catch(function() {});
      }, 2000);
    }

    function restoreLatest() {
      fetch('/api/account/export/latest', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) return;
          ['personal', 'transfer'].forEach(function(type) {
            const job = data[type];
            if (!job) {
              if (panels[type]) panels[type].style.display = 'none';
              ticketUrls[type] = null;
              stopPoll(type);
              return;
            }
            renderJob(job);
            if (job.status === 'queued' || job.status === 'processing' || job.status === 'zipping') {
              startPoll(type, job.id);
            } else {
              stopPoll(type);
            }
          });
        })
        .catch(function() {});
    }

    function startExport(type) {
      const ui = els(type);
      if (!ui) return;
      ui.panel.style.display = 'block';
      ui.title.textContent = I18N.starting;
      ui.bar.style.width = '2%';
      ui.meta.textContent = I18N.willReplace;
      ui.actions.style.display = 'none';
      ticketUrls[type] = null;
      fetch('/api/account/export', {
        method: 'POST',
        credentials: 'same-origin',
        headers: csrfHeaders(),
        body: JSON.stringify({ type: type })
      })
        .then(function(r) { return r.json().then(function(data) { return { status: r.status, data: data }; }); })
        .then(function(res) {
          const data = res.data;
          if (!data.ok || !data.job) {
            ui.title.textContent = I18N.error;
            ui.meta.innerHTML = '<span style="color:#ff6666">' + ((data && (data.message || data.error)) || I18N.failedShort) + '</span>';
            return;
          }
          renderJob(data.job);
          if (data.job.status !== 'ready' && data.job.status !== 'failed') {
            startPoll(type, data.job.id);
          }
          // keep the other panel
          restoreLatest();
        })
        .catch(function() {
          ui.title.textContent = I18N.networkError;
          ui.meta.innerHTML = '<span style="color:#ff6666">' + I18N.tryAgain + '</span>';
        });
    }

    Object.keys(panels).forEach(function(type) {
      const ui = els(type);
      if (!ui || !ui.downloadBtn) return;
      ui.downloadBtn.addEventListener('click', function() {
        if (!ticketUrls[type] || ui.downloadBtn.disabled) return;
        ui.downloadBtn.disabled = true;
        const prev = ui.downloadBtn.textContent;
        ui.downloadBtn.textContent = I18N.oneMoment;
        fetch(ticketUrls[type], {
          method: 'POST',
          credentials: 'same-origin',
          headers: csrfHeaders()
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            ui.downloadBtn.textContent = prev;
            ui.downloadBtn.disabled = !ticketUrls[type];
            if (!data.ok || !data.download_url) {
              alert((data && data.error === 'unavailable')
                ? I18N.unavailable
                : I18N.noLink);
              return;
            }
            window.location.href = data.download_url;
          })
          .catch(function() {
            ui.downloadBtn.textContent = prev;
            ui.downloadBtn.disabled = !ticketUrls[type];
            alert(I18N.networkError);
          });
      });
    });

    const btnP = document.getElementById('btnExportPersonal');
    const btnT = document.getElementById('btnExportTransfer');
    if (btnP) btnP.addEventListener('click', function() { startExport('personal'); });
    if (btnT) btnT.addEventListener('click', function() { startExport('transfer'); });

    restoreLatest();
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        if (tab.getAttribute('data-tab') === 'tab-export') restoreLatest();
      });
    });
  })();

  const langSelect = document.getElementById('langSelect');
  if (langSelect) {
    langSelect.addEventListener('change', function() {
      const lang = this.value;
      fetch('/api/set-lang', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang })
      }).then(res => {
        if (res.ok) {
          window.location.reload();
        }
      });
    });
  }

  document.querySelectorAll('.theme-option input[name="theme"]').forEach(function(input) {
    input.addEventListener('change', function() {
      if (!this.checked) return;
      const theme = this.value;
      document.querySelectorAll('.theme-option').forEach(function(opt) {
        opt.classList.toggle('is-active', opt.getAttribute('data-theme') === theme);
      });
      fetch('/api/set-theme', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ theme })
      }).then(res => {
        if (res.ok) {
          window.location.reload();
        }
      });
    });
  });
</script>

<%- include('partials/footer') %>
