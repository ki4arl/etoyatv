              <div style="height:10px;background:#111;border-radius:5px;overflow:hidden;margin-bottom:10px;">
                <div class="export-job-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#0072ff,#6fdeee);transition:width .3s;"></div>
              </div>
              <div class="export-job-meta" style="color:#999;font-size:12px;line-height:1.6;"></div>
              <div class="export-job-actions" style="margin-top:14px;display:none;">
                <button type="button" class="btn-save export-job-download" style="background:#39b54a;border-color:#2e963b;margin:0;padding:8px 22px;">Скачать архив переноса</button>
