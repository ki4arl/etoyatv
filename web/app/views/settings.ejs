        <!-- ТАБ: БЕЗОПАСНОСТЬ -->
        <div id="tab-security" class="settings-block">
          <% if (typeof error2FA !== 'undefined' && error2FA) { %><div style="color:#ff6666;margin-bottom:10px;text-align:center;"><%= error2FA %></div><% } %>
          <% if (typeof errorSession !== 'undefined' && errorSession) { %><div style="color:#ff6666;margin-bottom:10px;text-align:center;"><%= errorSession %></div><% } %>
          <% if (typeof successSession !== 'undefined' && successSession) { %><div style="color:#39b54a;margin-bottom:10px;text-align:center;"><%= successSession %></div><% } %>
          
          <div class="info-box">
            <h3>Двухфакторная аутентификация (2FA)</h3>
            <p>Дополнительный уровень безопасности для вашего аккаунта. При входе потребуется вводить временный код из приложения (например, Google Authenticator).</p>
            
            <% if (profileUser.is_totp_enabled) { %>
              <div style="margin-top: 15px; color: #39b54a; font-weight: bold;">
                Статус: Включено
