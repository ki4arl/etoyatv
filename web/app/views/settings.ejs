          <div id="exportPanels" style="display:flex;flex-direction:column;gap:12px;">
            <div id="exportPanel-personal" class="export-job-panel" data-type="personal" style="display:none;background:#232323;border:1px solid #444;padding:18px;border-radius:4px;">
              <div class="export-job-title" style="color:#ccc;font-size:14px;margin-bottom:10px;">Личный архив…</div>
              <div style="height:10px;background:#111;border-radius:5px;overflow:hidden;margin-bottom:10px;">
                <div class="export-job-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#666,#bbb);transition:width .3s;"></div>
              </div>
              <div class="export-job-meta" style="color:#999;font-size:12px;line-height:1.6;"></div>
              <div class="export-job-actions" style="margin-top:14px;display:none;">
                <button type="button" class="btn-save export-job-download" style="background:#39b54a;border-color:#2e963b;margin:0;padding:8px 22px;">Скачать личный архив</button>
              </div>
