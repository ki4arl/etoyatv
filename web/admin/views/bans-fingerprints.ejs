<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Блокировки по отпечатку | Панель управления</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>
  <div class="layout-container">
    <%- include('partials/sidebar', { currentPath: '/bans/fingerprints' }) %>
    <main class="main-content">
      <style>
        .table-container {
          background: rgba(255, 255, 255, 0.03);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 12px;
          overflow: hidden;
          margin-top: 20px;
        }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.05); word-break: break-word; }
        th { font-weight: 600; color: #9ca3af; background: rgba(0,0,0,0.2); }
        .btn-action { padding: 8px 15px; cursor: pointer; }
        .mono { font-family: ui-monospace, monospace; font-size: 12px; }
      </style>
      <div class="content-header" style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
        <h1>Блокировки по отпечатку</h1>
        <div>
          <% if (showLifted) { %>
            <a href="/bans/fingerprints" style="color: #6fdeee;">Только активные</a>
          <% } else { %>
            <a href="/bans/fingerprints?show=all" style="color: #6fdeee;">Показать снятые</a>
          <% } %>
        </div>
      </div>
      <% if (typeof success_msg !== 'undefined' && success_msg) { %>
        <div style="color: #39b54a; margin-top: 10px;"><%= success_msg %></div>
      <% } %>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Отпечаток</th>
              <th>Тип</th>
              <th>IP / связка</th>
              <th>Кем выдан</th>
              <th>Причина</th>
              <th>Дата</th>
              <th>Статус</th>
              <th>Действие</th>
            </tr>
          </thead>
          <tbody>
            <% bans.forEach(b => { %>
              <tr>
                <td class="mono" title="<%= b.fp_hash %>"><%= b.fp_hash.slice(0, 16) %>…</td>
                <td>
                  <% if (b.ban_type === 'full') { %>
                    <span style="color: #ff4d4d; font-weight: bold;">Полный бан</span>
                  <% } else { %>
                    <span style="color: #e6a23c; font-weight: bold;">Аккаунт (зритель)</span>
                  <% } %>
                </td>
                <td>
                  <%= b.source_ip || '—' %><br>
                  <% if (b.linked_ip) { %><span style="color:#888;font-size:12px;">IP-бан: <%= b.linked_ip %></span><% } %>
                </td>
                <td><%= b.banned_by_username || 'Система' %></td>
                <td><%= b.reason || 'Не указана' %></td>
                <td><%= formatDate(b.created_at, userTimezone, 'DD.MM.YYYY HH:mm:ss') %></td>
                <td>
                  <% if (b.lifted_at) { %>
                    <span style="color:#888;">Снят <%= formatDate(b.lifted_at, userTimezone, 'DD.MM.YYYY HH:mm') %></span>
                  <% } else { %>
                    <span style="color:#ff4d4d;font-weight:bold;">Активен</span>
                  <% } %>
                </td>
                <td>
                  <% if (!b.lifted_at) { %>
                    <form action="/bans/fingerprints/<%= b.fp_hash %>/lift" method="POST" style="display:inline;">
                      <button type="submit" class="btn-action btn-danger" onclick="event.preventDefault(); const form=this.closest('form'); yatvConfirm('Снять блокировку по отпечатку?', () => form.submit());">Снять</button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }); %>
            <% if (bans.length === 0) { %>
              <tr><td colspan="8" style="text-align:center;padding:30px;color:#888;">Активных блокировок по отпечатку нет</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="pagination-section" style="margin-top: 20px;">
        <form action="/bans/fingerprints" method="GET" class="limit-selector">
          <% if (showLifted) { %><input type="hidden" name="show" value="all"><% } %>
          <label>На страницу: </label>
          <select name="limit" class="custom-select" onchange="this.form.submit()">
            <option value="10" <%= limit === 10 ? 'selected' : '' %>>10</option>
            <option value="25" <%= limit === 25 ? 'selected' : '' %>>25</option>
            <option value="50" <%= limit === 50 ? 'selected' : '' %>>50</option>
          </select>
        </form>
        <div class="pagination" style="margin-top:10px;">
          <% if (page > 1) { %>
            <a href="/bans/fingerprints?page=<%= page - 1 %>&limit=<%= limit %><%= showLifted ? '&show=all' : '' %>" class="page-link">Предыдущая</a>
          <% } %>
          <span style="margin:0 10px;">стр. <%= page %> / <%= totalPages || 1 %></span>
          <% if (page < totalPages) { %>
            <a href="/bans/fingerprints?page=<%= page + 1 %>&limit=<%= limit %><%= showLifted ? '&show=all' : '' %>" class="page-link">Следующая</a>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
