<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="icon" href="/images/admin_favicon.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

  <%- include('partials/header') %>

  <div class="layout-container">
    <%- include('partials/sidebar') %>

    <!-- Main Content -->
    <main class="main-content">
      
      <div class="users-header-stats">
        <p>Всего: <strong><%= totalCount %></strong> каналов</p>
      </div>

      <div class="users-list">
        <% const isModOnly = user && !user.is_superadmin && user.staff_role === 'moderator'; %>
        <% channels.forEach(c => { %>
          <div class="user-list-card <%= c.status === 'deleted' ? 'deleted' : '' %> <%= c.status === 'banned' ? 'banned' : '' %>" style="width: 100%; gap: 20px;">
            <div class="u-card-avatar" style="width: 80px; height: 80px; border-radius: 4px; background-image: url('<%= c.logo_url && c.logo_url.startsWith('/') ? CDN_BASE_URL + c.logo_url : CDN_BASE_URL + '/images/logo_cort.png' %>'); flex-shrink: 0;"></div>
            
            <div class="u-card-info" style="flex-grow: 1; min-width: 0;">
              <div class="u-card-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                <strong><a href="<%= APP_URL %>/<%= c.shortname %>" target="_blank" style="color: #3b9cd9; text-decoration: none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'"><%= c.name %></a></strong> <span class="u-card-id">(id: <%= c.id %>)</span>
              </div>
              <div class="u-card-email" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                Владелец канала: <a href="<%= APP_URL %>/account,userinfo/?username=<%= c.owner_username %>" target="_blank" style="color: #3b9cd9; text-decoration: none;"><%= c.owner_username %></a>
              </div>
              <div class="u-card-status">
                Статус канала: 
                <% if (c.status === 'deleted') { %>
                  <span class="status-deleted">Удаленный</span>
                <% } else if (c.status === 'banned') { %>
                  <span class="status-banned">Заблокированный</span>
                <% } else { %>
                  <span class="status-active">Активный</span>
                <% } %>
                <% const _geoList = parseGeoCountries(c.geo_block_countries); %>
                <% if (_geoList.length) { %>
                  <span style="background:#ff9800; color:#000; padding:2px 6px; border-radius:3px; font-size:11px; font-weight:bold; margin-left:6px;">Гео: <%= formatGeoCountries(c.geo_block_countries) %></span>
                <% } %>
              </div>
              <div class="u-card-status" style="margin-top: 5px;">
                Тип канала: <strong><%= c.is_personal ? 'Личный' : 'Кооперативный' %></strong>
              </div>
              <% if (c.is_premium) { %>
                <div class="u-card-status" style="margin-top: 5px;">
                  Привилегия: 
                  <% if (c.owner_boosty_email) { %>
                    <span style="background: #39b54a; color: #fff; padding: 2px 6px; border-radius: 3px; font-size: 11px; font-weight: bold; display: inline-block;">Boosty Premium <%= c.premium_until ? 'до ' + formatDate(c.premium_until) : '' %></span>
                  <% } else { %>
                    <span style="background: #0072ff; color: #fff; padding: 2px 6px; border-radius: 3px; font-size: 11px; font-weight: bold; display: inline-block;">Premium <%= c.premium_until ? 'до ' + formatDate(c.premium_until) : 'бессрочно' %></span>
                  <% } %>
                </div>
              <% } else if (c.is_verified) { %>
                <div class="u-card-status" style="margin-top: 5px;">
                  Привилегия: <span style="background: #f1c40f; color: #000; padding: 2px 6px; border-radius: 3px; font-size: 11px; font-weight: bold; display: inline-block;">Верифицированный</span>
                </div>
              <% } %>
            </div>
            
            <div class="u-card-actions" style="margin-left: auto; align-items: flex-end; flex-shrink: 0;">
              <a href="/channels/<%= c.id %>/edit" class="btn-action" style="text-decoration:none; display:inline-block; text-align:center; white-space: nowrap; width: 170px;"><%= isModOnly ? 'Просмотр инфо' : 'Редактировать' %></a>
              
              <% if (c.status === 'banned') { %>
                <form action="/channels/<%= c.id %>/toggle_status?redirect=<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>" method="POST" style="display: contents;">
                  <input type="hidden" name="action_type" value="unban">
                  <button type="submit" class="btn-action" style="white-space: nowrap; width: 170px;">Разбанить</button>
                </form>
              <% } else { %>
                <button type="button" class="btn-action" onclick="openBanModal(<%= c.id %>)" style="white-space: nowrap; width: 170px;">Заблокировать</button>
              <% } %>
              <% if (_geoList && _geoList.length) { %>
                <form action="/channels/<%= c.id %>/geo_block?redirect=<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>" method="POST" style="display: contents;">
                  <input type="hidden" name="action" value="clear">
                  <button type="submit" class="btn-action" style="white-space: nowrap; width: 170px; background:#ff9800; color:#000; border:none;">Снять гео-блок</button>
                </form>
              <% } %>

              <% if (!isModOnly) { %>
              <form action="/channels/<%= c.id %>/delete?redirect=<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>" method="POST" style="display: contents;">
                <input type="hidden" name="action" value="<%= (c.status === 'deleted' || c.deleted_at !== null) ? 'restore' : 'delete' %>">
                <button type="submit" class="btn-action <%= (c.status === 'deleted' || c.deleted_at !== null) ? 'btn-restore' : 'btn-danger' %>" onclick="event.preventDefault(); const form = this.closest('form'); yatvConfirm('Вы уверены?', () => { form.submit(); });" style="white-space: nowrap; width: 170px;">
                  <%= (c.status === 'deleted' || c.deleted_at !== null) ? 'Восстановить' : 'Удалить полностью' %>
                </button>
              </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Pagination & Limits -->
      <div class="pagination-section">
        <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>" method="GET" class="limit-selector">
          <input type="hidden" name="q" value="<%= q %>">
          <label>На страницу: </label>
          <select name="limit" class="custom-select" onchange="this.form.submit()">
            <option value="10" <%= limit === 10 ? 'selected' : '' %>>10</option>
            <option value="25" <%= limit === 25 ? 'selected' : '' %>>25</option>
            <option value="50" <%= limit === 50 ? 'selected' : '' %>>50</option>
            <option value="100" <%= limit === 100 ? 'selected' : '' %>>100</option>
          </select>
        </form>

        <div class="pagination">
          <% if (page > 1) { %>
            <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>?page=<%= page - 1 %>&limit=<%= limit %>&q=<%= q %>" class="page-link">Предыдущая</a>
          <% } %>
          
          <span class="page-current">Страница <%= page %> из <%= totalPages %></span>
          
          <% if (page < totalPages) { %>
            <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>?page=<%= page + 1 %>&limit=<%= limit %>&q=<%= q %>" class="page-link">Следующая</a>
          <% } %>
        </div>
      </div>

    </main>

  </div>

  <div id="banModal" class="modal-overlay">
    <div class="modal-content" style="max-width:520px;">
      <h3 style="margin-top:0; margin-bottom: 20px;">Блокировка канала</h3>
      <form id="banForm" action="" method="POST" onsubmit="return validateListBanForm(this);">
        <input type="hidden" name="action_type" value="ban">
        
        <div id="listBanReasonBlock" style="margin-bottom: 15px;">
          <label style="display:block; margin-bottom:5px; font-weight:bold;">Причина блокировки:</label>
          <textarea name="ban_reason" id="listBanReasonInput" class="form-control" rows="3" style="width:100%; max-width:100%; resize:none;" placeholder="Опишите причину блокировки. Владелец не увидит причину, она для внутреннего пользования."></textarea>
        </div>
        
        <div style="margin-bottom: 15px;">
          <label style="display:block; margin-bottom:5px; font-weight:bold;">Тип блокировки:</label>
          <div style="display:flex; flex-direction:column; gap: 10px;">
            <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
              <input type="radio" name="ban_type" value="permanent" checked onchange="onListBanTypeChange()"> Навсегда (полный бан)
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
              <input type="radio" name="ban_type" value="temporary" onchange="onListBanTypeChange()"> До времени
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
              <input type="radio" name="ban_type" value="geo" onchange="onListBanTypeChange()"> Гео-блокировка
            </label>
          </div>
        </div>
        
        <div id="banDateInputContainer" style="margin-bottom: 20px; display: none;">
          <label style="display:block; margin-bottom:5px; font-weight:bold;">Снять блокировку:</label>
          <input type="datetime-local" name="banned_until" id="banDateInput" class="form-control" style="width: 100%;">
        </div>

        <div id="listBanGeoCountries" style="margin-bottom: 20px; display: none;">
          <%- include('partials/geo-block-fields', {
            pickerId: 'listGeoPicker',
            hint: 'Канал не получит статус «забанен». В статусе будет пометка гео-блока; можно снять по стране.'
          }) %>
        </div>
        
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button type="button" class="btn-black-border" onclick="closeBanModal()">Отмена</button>
          <button type="submit" class="btn-black-border" style="background:#ff4d4d; color:white; border-color:#ff4d4d;">Заблокировать</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/geoCountryPicker.js"></script>
  <script>
    window.GEO_COUNTRY_OPTIONS = <%- JSON.stringify(GEO_COUNTRY_OPTIONS || []) %>;
    let listGeoPickerApi = null;
    function ensureListGeoPicker() {
      if (listGeoPickerApi) return listGeoPickerApi;
      listGeoPickerApi = GeoCountryPicker.mount(document.getElementById('listGeoPicker'), {
        name: 'geo_countries',
        countries: window.GEO_COUNTRY_OPTIONS || [],
        selected: []
      });
      return listGeoPickerApi;
    }
    function onListBanTypeChange() {
      const type = (document.querySelector('#banForm input[name="ban_type"]:checked') || {}).value || 'permanent';
      const dateBox = document.getElementById('banDateInputContainer');
      const geoBox = document.getElementById('listBanGeoCountries');
      const reasonBox = document.getElementById('listBanReasonBlock');
      const reasonInput = document.getElementById('listBanReasonInput');
      const dateInput = document.getElementById('banDateInput');
      if (type === 'temporary') {
        dateBox.style.display = 'block'; geoBox.style.display = 'none'; reasonBox.style.display = 'block';
        if (dateInput) dateInput.setAttribute('required', 'required');
        if (reasonInput) reasonInput.setAttribute('required', 'required');
      } else if (type === 'geo') {
        dateBox.style.display = 'none'; geoBox.style.display = 'block'; reasonBox.style.display = 'none';
        if (dateInput) dateInput.removeAttribute('required');
        if (reasonInput) { reasonInput.removeAttribute('required'); }
        ensureListGeoPicker();
      } else {
        dateBox.style.display = 'none'; geoBox.style.display = 'none'; reasonBox.style.display = 'block';
        if (dateInput) dateInput.removeAttribute('required');
        if (reasonInput) reasonInput.setAttribute('required', 'required');
      }
    }
    function validateListBanForm(form) {
      const type = (form.querySelector('input[name="ban_type"]:checked') || {}).value;
      if (type === 'geo') {
        ensureListGeoPicker();
        if (!form.querySelectorAll('input[name="geo_countries"]').length) {
          alert('Выберите хотя бы одну страну');
          return false;
        }
        const geoReason = form.querySelector('.geo-block-reason-input');
        if (!geoReason || !String(geoReason.value || '').trim()) {
          alert('Укажите причину гео-блокировки');
          return false;
        }
      }
      return true;
    }
    function openBanModal(channelId) {
      document.getElementById('banForm').action = '/channels/' + channelId + '/toggle_status?redirect=<%= typeof baseUrl !== 'undefined' ? baseUrl : '/channels' %>';
      document.getElementById('banModal').classList.add('active');
      onListBanTypeChange();
    }
    function closeBanModal() {
      document.getElementById('banModal').classList.remove('active');
    }
  </script>
</body>
</html>
