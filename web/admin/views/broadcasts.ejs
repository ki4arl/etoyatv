<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="icon" href="/images/admin_favicon.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .form-container {
      background: rgba(255, 255, 255, 0.03);
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 30px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .form-group {
      display: flex !important;
      flex-direction: column;
      align-items: stretch !important;
      margin-bottom: 20px;
      gap: 8px;
    }
    .form-group label.form-label {
      display: block;
      width: 100% !important;
      margin-bottom: 0;
      font-weight: 600;
      color: #9ca3af;
      font-size: 14px;
    }
    .form-control {
      width: 100%;
      min-height: 120px;
      padding: 12px 15px;
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      color: white;
      font-family: inherit;
      font-size: 14px;
      resize: none;
      box-sizing: border-box;
    }
    .form-control:focus {
      outline: none;
      border-color: #00c6ff;
    }
    .btn-submit {
      background: linear-gradient(135deg, #00c6ff, #0072ff);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      font-size: 14px;
      transition: opacity 0.2s;
    }
    .btn-submit:hover {
      opacity: 0.9;
    }
    .btn-submit:disabled {
      background: #4b5563;
      color: #9ca3af;
      cursor: not-allowed;
      opacity: 0.7;
    }
    .table-container {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      overflow: hidden;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    th {
      font-weight: 600;
      color: #9ca3af;
      background: rgba(0,0,0,0.2);
    }
    tr:last-child td {
      border-bottom: none;
    }
    .status-badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 600;
      display: inline-block;
    }
    .status-pending { background: rgba(253, 224, 71, 0.2); color: #fde047; }
    .status-processing { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
    .status-completed { background: rgba(74, 222, 128, 0.2); color: #4ade80; }
    .status-failed { background: rgba(248, 113, 113, 0.2); color: #f87171; }
    
    .char-counter {
      text-align: right;
      font-size: 12px;
      color: #9ca3af;
      margin-top: 5px;
    }
    
    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .checkbox-group label {
      cursor: pointer;
      color: #9ca3af;
      font-size: 14px;
      font-weight: 500;
      width: auto !important;
      margin: 0 !important;
      white-space: normal;
    }
  </style>
</head>
<body>

  <%- include('partials/header') %>

  <div class="layout-container">
    <%- include('partials/sidebar', { currentPath: '/broadcasts' }) %>

    <!-- Main Content -->
    <main class="main-content">
      <div class="page-header">
        <h2 class="page-title">Системные рассылки</h2>
      </div>

      <!-- Broadcast Creation Form -->
      <div class="form-container">
        <form action="/broadcasts/send" method="POST" id="broadcastForm">
          <input type="hidden" name="broadcast_token" value="<%= broadcastToken %>">
          
          <div class="form-group">
            <label class="form-label" for="message_text">Текст системного уведомления</label>
            <textarea 
              name="message_text" 
              id="message_text" 
              class="form-control" 
              placeholder="Введите текст сообщения, которое получат абсолютно все зарегистрированные пользователи сайта от имени аккаунта Уведомления ЭтоЯTV..." 
              required 
              maxlength="400"
              oninput="updateCharCount()"></textarea>
            <div class="char-counter" id="charCounter">Использовано: 0 / 400 символов</div>
          </div>

          <div class="checkbox-group">
            <input type="checkbox" name="send_email" id="send_email" value="1" style="width: 18px; height: 18px; cursor: pointer; flex-shrink: 0; margin: 0;">
            <label for="send_email">Дублировать уведомление на электронную почту пользователей (только для тех, кто не отписался)</label>
          </div>

          <button type="submit" class="btn-submit" id="submitBtn">Запустить рассылку</button>
        </form>
      </div>

      <!-- History Table -->
      <div class="page-header" style="margin-top: 40px;">
        <h3 class="page-title" style="font-size: 18px;">История рассылок</h3>
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th style="width: 60px;">ID</th>
              <th>Администратор</th>
              <th>Сообщение</th>
              <th style="width: 140px;">Статус</th>
              <th style="width: 120px;">Прогресс</th>
              <th style="width: 160px;">Запущена</th>
              <th style="width: 160px;">Завершена</th>
            </tr>
          </thead>
          <tbody>
            <% if (broadcasts.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; color: #9ca3af; padding: 20px;">
                  История рассылок пуста.
                </td>
              </tr>
            <% } else { %>
              <% broadcasts.forEach(b => { %>
                <tr>
                  <td><%= b.id %></td>
                  <td><strong><%= b.admin_name || 'Неизвестный' %></strong></td>
                  <td style="word-break: break-word; font-size: 13px;"><%= b.message_text %></td>
                  <td>
                    <% if (b.status === 'pending') { %>
                      <span class="status-badge status-pending">В очереди</span>
                    <% } else if (b.status === 'processing') { %>
                      <span class="status-badge status-processing">Отправка</span>
                    <% } else if (b.status === 'completed') { %>
                      <span class="status-badge status-completed">Завершено</span>
                    <% } else { %>
                      <span class="status-badge status-failed">Ошибка</span>
                    <% } %>
                  </td>
                  <td>
                    <strong><%= b.sent_count %></strong> / <%= b.total_users %>
                  </td>
                  <td style="font-size: 12px; color: #9ca3af;"><%= formatDateMsk(b.created_at) %></td>
                  <td style="font-size: 12px; color: #9ca3af;">
                    <%= b.completed_at ? formatDateMsk(b.completed_at) : '—' %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination & Limits -->
      <div class="pagination-section" style="margin-top: 20px;">
        <form action="/broadcasts" method="GET" class="limit-selector">
          <label>На страницу: </label>
          <select name="limit" class="custom-select" onchange="this.form.submit()">
            <option value="10" <%= limit === 10 ? 'selected' : '' %>>10</option>
            <option value="25" <%= limit === 25 ? 'selected' : '' %>>25</option>
            <option value="50" <%= limit === 50 ? 'selected' : '' %>>50</option>
            <option value="100" <%= limit === 100 ? 'selected' : '' %>>100</option>
          </select>
        </form>

        <div class="pagination">
          <% if (page > 1) { %>
            <a href="/broadcasts?page=<%= page - 1 %>&limit=<%= limit %>" class="page-link">Предыдущая</a>
          <% } %>
          
          <span class="page-current">Страница <%= page %> из <%= totalPages %></span>
          
          <% if (page < totalPages) { %>
            <a href="/broadcasts?page=<%= page + 1 %>&limit=<%= limit %>" class="page-link">Следующая</a>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateCharCount() {
      const textarea = document.getElementById('message_text');
      const counter = document.getElementById('charCounter');
      counter.innerText = 'Использовано: ' + textarea.value.length + ' / 400 символов';
    }

    const form = document.getElementById('broadcastForm');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', function(e) {
      // Prevent double submissions
      submitBtn.disabled = true;
      submitBtn.innerText = 'Запуск...';
    });
  </script>
</body>
</html>
